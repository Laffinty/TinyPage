// [探针上游] 用 WLWL 自己起一个明文 HTTP 上游（不依赖 Python）
// 用途：给 tls_middleware.wll 提供转发目标
// 用 TCP_SERVE：accept + 读请求都在原生帧内，handler 只返回 DICT
IMPORT("wlwl:std.net", ["TCP_LISTEN", "TCP_SERVE", "TCP_LOCAL_ADDR"]);
IMPORT("wlwl:std.str", ["CAT"]);
IMPORT("wlwl:std.encode", ["BYTE_LEN"]);

LET(l, TCP_LISTEN("127.0.0.1", 18080));
PRINT("upstream listening on ", AT_K(TCP_LOCAL_ADDR(l), "port", 0));

LET(n, TCP_SERVE(l, 60000, NULL, FUN((req),
    (LET(path, AT_K(req, "path", "/"));
     ["status": 200,
      "headers": ["content-type": "text/plain; charset=utf-8"],
      "body": CAT("upstream hit: ", path)]))));
PRINT("upstream served ", n)
