// tp/bin/serve_admin.wll —— admin 后台入口（卡 S4-3）
//
// ⚠ 本文件由 tp/test/gen_serve_admin.py 生成 —— 请勿手改。
//
// 传输在此，**HTTP 语义全在** tp/lib/http_util.wll（MATCH_ROUTE / PARSE_FORM /
// BUILD_RESPONSE 都是纯函数）；会话与 CSRF 走 tp/lib/security.wll，
// 写操作用 tp/lib/admin_actions.wll。
//
// ⚠⚠ **仅绑 127.0.0.1**（业主裁决，卡 S4-3 反向守卫）：地址是**字面量**，
//   `TP_ADMIN_HOST` 一旦设成别的值 ⇒ 启动即 PANIC（不提供「改绑」开关）。
//
// 配置（环境变量；`wlwl run` 不透传脚本参数 —— 坑 49）：
//   TP_ADMIN_PORT / ADMIN_PORT    监听端口（缺省 8081 == config.py:35-37）
//   TP_ADMIN_USER / ADMIN_USER    登录用户名（缺省 admin == config.py:25）
//   TP_ADMIN_PASS / ADMIN_PASS    登录口令（空 ⇒ 登录 503 == actions.py:394-400）
//   TP_ROOT                       站点根（缺省 pages == config.py:48）
//   BIND_DOMAIN                   非空 ⇒ cookie 加 Secure（security.py:130-132）
//
// 本机跑法：
//   $env:TP_ADMIN_PORT="18081"; $env:TP_ADMIN_PASS="0123456789abcdef"
//   & D:\wlwl_v0.12.1\wlwl.exe run tp\bin\serve_admin.wll
//   curl -s -o NUL -w "%{http_code}" http://127.0.0.1:18081/login
//
// ⚠ 已知缺口（不粉饰）：新建文章日期不预填（WLWL 无本地时区格式化）；
//   /translate 只到文本层。
//
// 注入资产（app.py:142-152）：/admin.css、/admin.js、/htmx.min.js 等 9 个顶层
//   文件**免会话**直接从 TP_ROOT 根读 —— 登录页自己要能拿到自己的 CSS。

IMPORT("wlwl:std.net", ["TCP_LISTEN", "TCP_SERVE", "TCP_CLOSE_LISTENER",
    "TCP_LOCAL_ADDR"]);
IMPORT("wlwl:std.signal", ["ON_SIGNAL", "STOP"]);
IMPORT("wlwl:std.env", ["ENV_GET"]);
IMPORT("wlwl:std.text", ["TO_INT", "TO_LOWER"]);
IMPORT("wlwl:std.fs", ["PATH_JOIN", "PATH_CANONICAL", "LIST_DIR", "PATH_BASE",
    "PATH_EXT", "READ_FILE", "FILE_META", "EXISTS"]);
IMPORT("wlwl:std.str", ["CAT", "INDEX_OF"]);
IMPORT("wlwl:std.regex", ["RE", "RE_TEST"]);
IMPORT("wlwl:std.encode", ["TIMING_SAFE_EQ", "URL_DECODE"]);
IMPORT("./../lib/http_util.wll", ["MATCH_ROUTE", "PARSE_FORM", "FORM_FIELD",
    "HEADER_VALUE", "COOKIE_VALUE", "BUILD_RESPONSE", "TEXT_ERROR_RESPONSE",
    "JSON_ERROR_RESPONSE", "JSON_RESPONSE", "HTML_RESPONSE", "REDIRECT",
    "RATE_LIMIT_RESPONSE", "JSON_ESCAPE"]);
IMPORT("./../lib/static_serve.wll", ["HANDLE"]);
IMPORT("./../lib/security.wll", ["NEW_CSRF_TOKEN", "VALIDATE_CSRF_TOKEN",
    "SESSION_FROM_COOKIE", "SESSION_VALIDATE", "SESSION_CREATE",
    "SESSION_DESTROY", "SESSION_COOKIE_HEADER", "SESSION_CLEAR_COOKIE_HEADER",
    "RATE_LIMIT"]);
IMPORT("./../lib/admin_actions.wll", ["CREATE_ARTICLE", "SAVE_ARTICLE",
    "DELETE_ARTICLE", "CREATE_PAGE", "SAVE_PAGE", "DELETE_PAGE", "SET_THEME",
    "PREVIEW", "REGEN", "UPLOAD_IMAGE"]);
// 视图层 / 模板 / 主题 / 元数据 / 排序 —— 全部复用已交付模块，不重写
IMPORT("./../lib/admin_views.wll", ["DASHBOARD_VIEW", "ARTICLE_FORM_VIEW",
    "PAGE_FORM_VIEW", "PAGES_DASHBOARD_VIEW", "THEME_SELECTOR_VIEW",
    "LOGIN_VIEW", "NAV_HTML"]);
IMPORT("./../lib/admin_ai.wll", ["AI_ASSIST_JSON", "TRANSLATE_JSON"]);
IMPORT("./../lib/template.wll", ["SAFE_SUBSTITUTE"]);
IMPORT("./../lib/esc.wll", ["ESCAPE_HTML"]);
IMPORT("./../lib/frontmatter.wll", ["PARSE_META"]);
IMPORT("./../lib/article_store.wll", ["VALIDATE_FILENAME", "SOURCE_PATH",
    "DECODE_CONTENT"]);
IMPORT("./../lib/sort_util.wll", ["SORT_BY_DATE", "SORT_BY_TITLE_OR_FILE"]);
IMPORT("./../lib/theme.wll", ["LIST_THEMES"]);

// ── 配置（环境变量；缺省值对齐 tinypage/config.py）──────────────────
LET(SAD_LOOPBACK, "127.0.0.1");
LET(host_env, ENV_GET("TP_ADMIN_HOST", SAD_LOOPBACK));
IF(!=(host_env, SAD_LOOPBACK), (
     PRINT_ERR("serve_admin: TP_ADMIN_HOST must be 127.0.0.1 (loopback only): ",
               host_env);
     PANIC("admin must bind loopback")
), NULL);

LET(port_s, ENV_GET("TP_ADMIN_PORT", ENV_GET("ADMIN_PORT", "8081")));
LET(port_t, TO_INT(port_s));
LET(SAD_PORT, IF(IS_ERR(port_t), -1, port_t));
IF(<(SAD_PORT, 1), (
     PRINT_ERR("serve_admin: TP_ADMIN_PORT is not a valid port: ", port_s);
     PANIC("bad TP_ADMIN_PORT")
), NULL);

LET(SAD_USER, ENV_GET("TP_ADMIN_USER", ENV_GET("ADMIN_USER", "admin")));
LET(SAD_PASS, ENV_GET("TP_ADMIN_PASS", ENV_GET("ADMIN_PASS", "")));
LET(SAD_BIND_DOMAIN, ENV_GET("BIND_DOMAIN", ""));
// cookie 的 Secure 属性：非空 bind_domain ⇒ 视为 HTTPS 部署（security.py:130）
LET(SAD_SECURE, !=(SAD_BIND_DOMAIN, ""));

LET(SAD_ROOT, PATH_CANONICAL(ENV_GET("TP_ROOT", "pages")));
LET(SAD_ARTICLE_DIR, PATH_JOIN(SAD_ROOT, "article"));
LET(SAD_STANDALONE_DIR, PATH_JOIN(SAD_ROOT, "standalone"));
LET(SAD_STATIC_DIR, PATH_JOIN(SAD_ROOT, "static"));
// 会话/限流按客户端 IP 计；admin **只**绑回环 ⇒ 客户端恒为回环地址
// （Python 的 get_real_ip 在 trusted_proxies 为空时也返回 REMOTE_ADDR）
LET(SAD_CLIENT_IP, SAD_LOOPBACK);

// 页面标题（app.py:288-298）
LET(SAD_TITLES, INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "dashboard", "仪表盘"), "pages_dashboard", "独立页面"), "new_article", "新建文章"), "edit_article", "编辑文章"), "new_page", "新建页面"), "edit_page", "编辑页面"), "theme", "主题管理"));

// 主题目录 / 当前主题（views.py:244 用字面量 Path("themes")；config.py:42）
LET(SAD_THEMES_DIR, ENV_GET("TP_THEMES_DIR", "themes"));
LET(SAD_THEME_NAME, ENV_GET("TP_THEME", "default"));

// AI 配置（config.py:63-68；只认布尔 TRUE，见 admin_ai 的 IS_ENABLED 口径）
LET(SAD_AI_FLAG, TO_LOWER(ENV_GET("TP_AI_ENABLED", "")));
LET(SAD_AI_ENABLED, ||(==(SAD_AI_FLAG, "1"), ==(SAD_AI_FLAG, "true")));
LET(SAD_CFG, INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "page_size", 10), "max_file_size", 10485760), "max_title_length", 200), "max_content_length", 50000), "ai_enabled", SAD_AI_ENABLED), "ai_api_key", ENV_GET("TP_AI_API_KEY", "")), "ai_model", ENV_GET("TP_AI_MODEL", "gpt-3.5-turbo")), "ai_provider", ENV_GET("TP_AI_PROVIDER", "openai")), "ai_endpoint", ENV_GET("TP_AI_ENDPOINT", "")));

// 侧边导航项（responses.py:69-75）；NAV_HTML 读 [href, label, icon_name]
LET(SAD_NAV_ITEMS, [["/", "仪表盘", "dashboard"], ["/new", "新建文章", "article"], ["/new-page", "新建页面", "page"], ["/pages", "管理页面", "pages"], ["/theme", "主题", "theme"]]);
// app.py:192-212：这几条路由的 render_admin_page(htmx=True)
LET(SAD_HTMX_ROUTES, ["pages_dashboard", "new_article", "edit_article", "new_page", "edit_page"]);
LET(SAD_HTMX_SCRIPT, "<script src=\"/htmx.min.js\"></script>");

// ── base.html 外壳（responses.py:58 render_admin_page）─────────────
// ⚠ 模板正文逐字搬在生成器里，生成期与磁盘比对；`$` 在 WLWL 字面量里是插值
//   ⇒ 全部发射成 `\$`（wl() 负责，反斜杠先、美元符后）。
LET(SAD_T_BASE, "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>\$title - TinyPage Admin</title>\n<link rel=\"stylesheet\" href=\"/admin.css\">\n\$htmx_script\n<script>\n(function(){\n  var m = localStorage.getItem('theme');\n  if (m === 'light' || (!m && window.matchMedia('(prefers-color-scheme: light)').matches)) {\n    document.documentElement.classList.add('light');\n  }\n})();\n</script>\n</head>\n<body>\n<button class=\"mobile-menu-toggle\" aria-label=\"打开菜单\" onclick=\"document.body.classList.toggle('menu-open')\">☰</button>\n<div class=\"admin-layout\">\n  <aside class=\"admin-sidebar\">\n    <div class=\"brand\">\n      <span class=\"brand-logo\">TinyPage</span>\n      <span class=\"brand-tag\">Admin</span>\n    </div>\n    <nav>\n      \$nav_html\n    </nav>\n    <div class=\"sidebar-footer\">\n      <button class=\"theme-toggle\" aria-label=\"切换主题\" onclick=\"toggleTheme()\">🌓</button>\n      <form method=\"post\" action=\"/logout\" class=\"logout-form\">\n        <input type=\"hidden\" name=\"csrf_token\" value=\"\$csrf_token\">\n        <button type=\"submit\" class=\"logout-btn\">退出登录</button>\n      </form>\n    </div>\n  </aside>\n  <main class=\"admin-main\">\n    \$body\n  </main>\n</div>\n<div id=\"toast-container\"></div>\n<script src=\"/admin.js\"></script>\n</body>\n</html>\n");

// // 侧边导航
     LET(SAD_NAV, FUN((cur), (
               // templates.py:35 build_nav_html（复用视图层的 NAV_HTML）;
               NAV_HTML(INDEX_SET(INDEX_SET(DICT(), "nav_items", SAD_NAV_ITEMS), "current_path", cur))
     )));

// // 整页外壳（base.html + SAFE_SUBSTITUTE，缺键原样保留）
     LET(SAD_SHELL, FUN((title, body, csrf, path, htmx), (
               // responses.py:79-87 的六键：title 先 escape_html；body/nav_html 是**片段**;
               LET MUT(m, DICT());
               SET(m, INDEX_SET(m, "title", ESCAPE_HTML(title)));
               SET(m, INDEX_SET(m, "body", body));
               SET(m, INDEX_SET(m, "csrf_token", csrf));
               SET(m, INDEX_SET(m, "current_path", path));
               SET(m, INDEX_SET(m, "nav_html", SAD_NAV(path)));
               SET(m, INDEX_SET(m, "htmx_script", htmx));
               SAFE_SUBSTITUTE(SAD_T_BASE, m)
     )));

// ── 数据（读目录；口径 == content.py:153 list_articles / :674 list_standalones）
// ⚠ 入口不做 Python 的「懒迁移写盘」：GET 一律只读。
     LET(SAD_AS_STR, FUN((v, d), (
               IF(==(TYPE(v), "STRING"), v, d)
     )));

     LET(SAD_READ_OR, FUN((p, fb), (
               // ⚠ `LET(r, READ_FILE(p))` 绑定**不算消费** ERR（坑 25）;
               IF(IS_ERR(READ_FILE(p)), fb, READ_FILE(p))
     )));

     LET(SAD_FILE_SIZE, FUN((p), (
               // 取不到给 -1（Python 侧 entry.stat() 抛错时整篇跳过；这里放过大小门）;
               IF(IS_ERR(FILE_META(p)), -1, AT_K(FILE_META(p), "size", 0))
     )));

     LET(SAD_TAG_LIST, FUN((tags), (
               // == ArticleMeta.tag_list：split(",") → strip → 丢空;
               LET MUT(out, []);
               IF(!=(tags, ""), (
                    FOR(t0, SPLIT(tags, ","), (
                         LET(t, TRIM(t0));
                         IF(==(t, ""), (
                              NULL
                         ), (
                              SET(out, PUSH(out, t))
                         ))
                    ))
               ), (
                    NULL
               ));
               out
     )));

     LET(SAD_ART_REC, FUN((meta, name), (
               // meta 是 PARSE_META 的 DICT；补 ArticleMeta 的派生字段;
               LET MUT(r, meta);
               LET(status, TO_LOWER(SAD_AS_STR(AT_K(r, "status", "published"), "published")));
               SET(r, INDEX_SET(r, "file", name));
               SET(r, INDEX_SET(r, "tag_list", SAD_TAG_LIST(SAD_AS_STR(AT_K(r, "tags", ""), ""))));
               SET(r, INDEX_SET(r, "is_draft", ==(status, "draft")));
               // models.py:50 is_published == status.lower() != "draft";
               SET(r, INDEX_SET(r, "is_published", !=(status, "draft")));
               r
     )));

     LET(SAD_LIST_ARTICLES, FUN((dir, max_size), (
               // content.py:171-196：.html + validate_filename + 大小 + 日期可解析；收草稿;
               LET MUT(out, []);
               IF(!IS_ERR(LIST_DIR(dir)), (
                    FOR(e, LIST_DIR(dir), (
                         LET(name, PATH_BASE(e));
                         IF(!=(PATH_EXT(name), "html"), (
                              NULL
                         ), (
                              IF(!VALIDATE_FILENAME(name), (
                                   NULL
                              ), (
                                   IF(>(SAD_FILE_SIZE(e), max_size), (
                                        NULL
                                   ), (
                                        LET(meta, PARSE_META(SAD_READ_OR(e, "")));
                                        SET(out, PUSH(out, SAD_ART_REC(meta, name)))
                                   ))
                              ))
                         ))
                    ))
               ), (
                    NULL
               ));
               // == arts.sort(key=date_obj, reverse=True)（sort_util 稳定降序）;
               SORT_BY_DATE(out)
     )));

// 独立页文件名白名单 == content.py:662 SAFE_PAGE_FILENAME
// ⚠ CJK 用**字面** `一-龥`（坑 20：`\u4e00` 在 WLWL 正则里不生效）
LET(SAD_PAGE_NAME_RE, RE("^[a-zA-Z0-9一-龥_-]+[.]html\$"));
     LET(SAD_LIST_PAGES, FUN((dir, max_size), (
               LET MUT(out, []);
               IF(!IS_ERR(LIST_DIR(dir)), (
                    FOR(e, LIST_DIR(dir), (
                         LET(name, PATH_BASE(e));
                         IF(!RE_TEST(SAD_PAGE_NAME_RE, name), (
                              NULL
                         ), (
                              IF(>(SAD_FILE_SIZE(e), max_size), (
                                   NULL
                              ), (
                                   LET MUT(r, SAD_ART_REC(PARSE_META(SAD_READ_OR(e, "")), name));
                                   // slug = 去掉 ".html" 的干名（Python: entry.stem）;
                                   SET(r, INDEX_SET(r, "slug", SUB(name, 0, -(LEN(name), 5))));
                                   SET(out, PUSH(out, r))
                              ))
                         ))
                    ))
               ), (
                    NULL
               ));
               // == pages.sort(key=lambda x: x.title or x.file);
               SORT_BY_TITLE_OR_FILE(out)
     )));

     LET(SAD_FIND, FUN((arr, key, val), (
               // 线性找第一条 arr[i][key] == val（Python 的 next((a for a in ...), None)）;
               LET MUT(out, NULL);
               LET(n, LEN(arr));
               LET MUT(i, 0);
               WHILE(&&(<(i, n), ==(TYPE(out), "NULL")), (
                    LET(it, AT(arr, i, DICT()));
                    IF(==(SAD_AS_STR(AT_K(it, key, ""), ""), val), (
                         SET(out, it)
                    ), (
                         NULL
                    ));
                    SET(i, +(i, 1))
               ));
               out
     )));

     LET(SAD_RAW, FUN((dir, fname), (
               // content.py:493 get_raw_content 的**只读**部分：兄弟 .md → HTML 内嵌正文 → summary;
               LET MUT(out, "");
               IF(==(fname, ""), (
                    NULL
               ), (
                    LET(p, PATH_JOIN(dir, fname));
                    LET(md, SOURCE_PATH(p));
                    IF(EXISTS(md), (
                         SET(out, SAD_READ_OR(md, ""))
                    ), (
                         LET(html, SAD_READ_OR(p, ""));
                         LET(d, DECODE_CONTENT(html));
                         IF(==(TYPE(d), "STRING"), (
                              SET(out, d)
                         ), (
                              LET(meta, PARSE_META(html));
                              SET(out, SAD_AS_STR(AT_K(meta, "summary", ""), ""))
                         ))
                    ))
               ));
               out
     )));

     LET(SAD_PATH_OF, FUN((req), (
               // PATH_INFO（去掉查询串）：nav 高亮与 MATCH_ROUTE 都不看 query;
               LET(p, SAD_AS_STR(AT_K(req, "path", ""), ""));
               LET(i, INDEX_OF(p, "?"));
               IF(<(i, 0), p, SUB(p, 0, i))
     )));

     LET(SAD_QUERY, FUN((req, key), (
               // QUERY_STRING 里 key 的第一个值（Python：parse_qs(...).get(k, [""])[0]）;
               LET(p, SAD_AS_STR(AT_K(req, "path", ""), ""));
               LET(qi, INDEX_OF(p, "?"));
               LET MUT(out, "");
               LET MUT(found, FALSE);
               IF(>=(qi, 0), (
                    FOR(part, SPLIT(SUB(p, +(qi, 1)), "&"), (
                         LET(eq, INDEX_OF(part, "="));
                         IF(||(found, <(eq, 0)), (
                              NULL
                         ), (
                              IF(==(SUB(part, 0, eq), key), (
                                   LET(rawv, SUB(part, +(eq, 1)));
                                   // 非法 percent 转义 ⇒ 原样（fail open：只影响查询参数取值）;
                                   SET(out, IF(IS_ERR(URL_DECODE(rawv)), rawv, URL_DECODE(rawv)));
                                   SET(found, TRUE)
                              ), (
                                   NULL
                              ))
                         ))
                    ))
               ), (
                    NULL
               ));
               out
     )));


// ── 请求工具 ─────────────────────────────────────────────────────
LET(SAD_HDRS, FUN((req), (
     AT_K(req, "headers", DICT())
)));

LET(SAD_HEADER, FUN((req, name), (
     HEADER_VALUE(INDEX_SET(INDEX_SET(DICT(), "headers", SAD_HDRS(req)), "name", name))
)));

LET(SAD_FIELDS, FUN((req), (
     // app.py:317-329：只解析 x-www-form-urlencoded；>10MB ⇒ 空表单
     PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", AT_K(req, "body", "")), "content_type", SAD_HEADER(req, "content-type")))
)));

LET(SAD_EXISTING_CSRF, FUN((cookie), (
     // app.py:303-312：cookie 里已有的 csrf_token 能复用就复用，否则新生成。
     // ⚠ Python 用的是 `is_valid_csrf_format`（格式+签名+1h）；security.wll 没导出它，
     //   这里用 VALIDATE_CSRF_TOKEN + **自造的同值 cookie** 等价替代：
     //   双提交必然一致，剩下的正是「格式/签名/时限」三道 ⇒ 与 is_valid_csrf_format 同义。
     LET(t, COOKIE_VALUE(INDEX_SET(INDEX_SET(DICT(), "cookie", cookie), "prefix", "csrf_token=")));
     IF(==(t, ""), (NEW_CSRF_TOKEN(DICT())), (
          IF(VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(DICT(), "token", t), "cookie", CAT("csrf_token=", t))),
             (t), (NEW_CSRF_TOKEN(DICT())))
     ))
)));

LET(SAD_CSRF_OK, FUN((fields, cookie, req), (
     // app.py:247-251：token 取自表单第一个值；Origin/Referer 白名单在 security.wll 里
     VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "token", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "csrf_token"))), "cookie", cookie), "origin", SAD_HEADER(req, "origin")), "referer", SAD_HEADER(req, "referer")), "admin_port", SAD_PORT), "bind_domain", SAD_BIND_DOMAIN))
)));

// ── 动作结果（admin_actions 的 {ok, ...}）→ 响应 ────────────────────
LET(SAD_ERR_STATUS, FUN((res), (
     // ⚠ admin_actions 只回 {ok, error}，**丢了 HTTP 状态**；Python 的两处特例是
     //   409 "Page already exists"（actions.py:130）与其余 400 ⇒ 按消息映射回来。
     IF(==(AT_K(res, "error", ""), "Page already exists"), (409), (400))
)));

LET(SAD_ERR_TEXT, FUN((res), (
     TEXT_ERROR_RESPONSE(SAD_ERR_STATUS(res), AT_K(res, "error", "Server error"))
)));

LET(SAD_REDIRECT_RESULT, FUN((res, location), (
     IF(!AT_K(res, "ok", FALSE), (SAD_ERR_TEXT(res)), (
          REDIRECT(INDEX_SET(DICT(), "location", location))
     ))
)));

LET(SAD_DELETE_RESULT, FUN((res, htmx, location), (
     // actions.py:107-112 / 190-192：htmx 回 200 + **只有** 5 个安全头（无 body）
     IF(!AT_K(res, "ok", FALSE), (SAD_ERR_TEXT(res)), (
          IF(htmx, (
               BUILD_RESPONSE(INDEX_SET(INDEX_SET(DICT(), "status", 200), "body", ""))
          ), (
               REDIRECT(INDEX_SET(DICT(), "location", location))
          ))
     ))
)));

LET(SAD_PREVIEW_RESULT, FUN((res), (
     // actions.py:289-294：Content-Type text/html + 5 个安全头（**不发** CSP）
     IF(!AT_K(res, "ok", FALSE), (SAD_ERR_TEXT(res)), (
          BUILD_RESPONSE(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "status", 200), "headers", INDEX_SET(DICT(), "Content-Type", "text/html; charset=utf-8")), "body", AT_K(res, "html", "")))
     ))
)));

LET(SAD_REGEN_RESULT, FUN((res, htmx), (
     // actions.py:268-283：htmx ⇒ 200 + 一段 HTML；否则 302 /
     IF(!AT_K(res, "ok", FALSE), (SAD_ERR_TEXT(res)), (
          IF(htmx, (
               BUILD_RESPONSE(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "status", 200), "headers", INDEX_SET(DICT(), "Content-Type", "text/html; charset=utf-8")), "body", "<span style=\"color:var(--a-primary);font-size:0.9rem;\">✓ 已重新生成</span>"))
          ), (
               REDIRECT(INDEX_SET(DICT(), "location", "/"))
          ))
     ))
)));

LET(SAD_UPLOAD_RESULT, FUN((res), (
     // actions.py:261-265：成功 {"success": true, "url": ...}；失败 JSON 400
     IF(!AT_K(res, "ok", FALSE), (
          JSON_ERROR_RESPONSE(400, AT_K(res, "error", "Server error"))
     ), (
          LET(url_json, CAT("{\"success\": true, \"url\": \"", JSON_ESCAPE(AT_K(res, "url", "")), "\"}"));
          JSON_RESPONSE(INDEX_SET(DICT(), "body", url_json))
     ))
)));

// ── 动作分发（路由名 → admin_actions）────────────────────────────────
// ⚠ 路由名逐字取自 app.py:98-115（`_POST_HANDLERS` / `_POST_HANDLERS_NO_BODY`）
LET(SAD_ACTION, FUN((route, fields, req), (
     LET(htmx, ==(SAD_HEADER(req, "hx-request"), "true"));
     LET(art, SAD_ARTICLE_DIR);
     LET(sad, SAD_STANDALONE_DIR);
     IF(==(route, "create_article"), (RETURN(SAD_REDIRECT_RESULT(CREATE_ARTICLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "article_dir", art), "title", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "title"))), "date", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "date"))), "content", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "content"))), "tags", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "tags"))), "category", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "category"))), "status", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "status")))), "/"))), NULL);
     IF(==(route, "save_article"), (RETURN(SAD_REDIRECT_RESULT(SAVE_ARTICLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "article_dir", art), "file", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "file"))), "title", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "title"))), "date", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "date"))), "content", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "content"))), "tags", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "tags"))), "category", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "category"))), "status", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "status")))), "/"))), NULL);
     IF(==(route, "delete_article"), (RETURN(SAD_DELETE_RESULT(DELETE_ARTICLE(INDEX_SET(INDEX_SET(DICT(), "article_dir", art), "file", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "file")))), htmx, "/"))), NULL);
     IF(==(route, "create_page"), (RETURN(SAD_REDIRECT_RESULT(CREATE_PAGE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "standalone_dir", sad), "title", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "title"))), "slug", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "slug"))), "content", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "content")))), "/pages"))), NULL);
     IF(==(route, "save_page"), (RETURN(SAD_REDIRECT_RESULT(SAVE_PAGE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "standalone_dir", sad), "file", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "file"))), "title", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "title"))), "slug", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "slug"))), "content", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "content")))), "/pages"))), NULL);
     IF(==(route, "delete_page"), (RETURN(SAD_DELETE_RESULT(DELETE_PAGE(INDEX_SET(INDEX_SET(DICT(), "standalone_dir", sad), "file", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "file")))), htmx, "/pages"))), NULL);
     IF(==(route, "set_theme"), (RETURN(SAD_REDIRECT_RESULT(SET_THEME(INDEX_SET(DICT(), "theme", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "theme")))), "/theme"))), NULL);
     // ⚠ 路由名是 `live_preview`（app.py:81），不是动作名 PREVIEW
     IF(==(route, "live_preview"), (RETURN(SAD_PREVIEW_RESULT(PREVIEW(INDEX_SET(DICT(), "content", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "content"))))))), NULL);
     IF(==(route, "regenerate"), (RETURN(SAD_REGEN_RESULT(REGEN(DICT()), htmx))), NULL);
     IF(==(route, "upload_image"), (RETURN(SAD_UPLOAD_RESULT(UPLOAD_IMAGE(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "filename", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "filename"))), "data", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "data"))), "static_dir", SAD_STATIC_DIR))))), NULL);
     // /ai-assist（actions.py:296-329）：**永远** 200 + application/json
     //   action / text / lang 三个表单字段 == actions.py:299-314 的取法
     IF(==(route, "ai_assist"), (RETURN(JSON_RESPONSE(INDEX_SET(INDEX_SET(DICT(), "status", 200), "body", AI_ASSIST_JSON(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "action", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "action"))), "text", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "text"))), "target", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "lang"))), "cfg", SAD_CFG)))))), NULL);
     // /translate（content.py:757-842 的**文本层**）：收 text + lang，不出文件
     IF(==(route, "translate_article"), (RETURN(JSON_RESPONSE(INDEX_SET(INDEX_SET(DICT(), "status", 200), "body", TRANSLATE_JSON(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "text", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "text"))), "target", FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "lang"))), "cfg", SAD_CFG)))))), NULL);
     TEXT_ERROR_RESPONSE(500, CAT("action not implemented: ", route))
)));

// ── 各 kind 的响应 ───────────────────────────────────────────────
LET(SAD_LOGIN_GET, FUN((req, cookie), (
     // app.py:226-237：login.html 是**整页**（不走 base.html）；头序照旧：
     //   Content-Type → CSRF cookie → CSP → 5 个安全头
     LET(csrf, SAD_EXISTING_CSRF(cookie));
     LET(body, LOGIN_VIEW(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "csrf_token", csrf), "error", SAD_QUERY(req, "error")), "locked", SAD_QUERY(req, "locked"))));
     HTML_RESPONSE(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "body", body), "csrf_token", csrf), "security_last", TRUE))
)));

// // GET 正文（视图层输出；外壳由 SAD_VIEW 套）
     LET(SAD_VIEW_BODY, FUN((route, req, csrf), (
               // app.py:194-214 的 GET 分派：每条路由取自己的数据，交给视图层渲染**正文**;
               // ⚠ 视图层已处理「取不到就显示未找到」⇒ 这里不做额外兜底;
               LET(mfs, AT_K(SAD_CFG, "max_file_size", 10485760));
               IF(==(route, "dashboard"), (
                    RETURN(DASHBOARD_VIEW(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "csrf_token", csrf), "articles", SAD_LIST_ARTICLES(SAD_ARTICLE_DIR, mfs)), "standalones", SAD_LIST_PAGES(SAD_STANDALONE_DIR, mfs)), "page", SAD_QUERY(req, "page")), "cfg", SAD_CFG)))
               ), (
                    NULL
               ));
               IF(==(route, "pages_dashboard"), (
                    RETURN(PAGES_DASHBOARD_VIEW(INDEX_SET(INDEX_SET(DICT(), "csrf_token", csrf), "pages", SAD_LIST_PAGES(SAD_STANDALONE_DIR, mfs))))
               ), (
                    NULL
               ));
               IF(==(route, "new_article"), (
                    // views.py:132 的分类 datalist 要**全部**文章（含草稿）;
                    // ⚠ Python 的 date 缺省是 datetime.now()；WLWL 无本地时区格式化 ⇒ 空串;
                    RETURN(ARTICLE_FORM_VIEW(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "csrf_token", csrf), "is_edit", FALSE), "now", ""), "articles", SAD_LIST_ARTICLES(SAD_ARTICLE_DIR, mfs)), "content", ""), "cfg", SAD_CFG)))
               ), (
                    NULL
               ));
               IF(==(route, "edit_article"), (
                    // views.py:94-117：按 ?file= 定位；拿不到 ⇒ 视图回 "Article not found";
                    LET(fname, SAD_QUERY(req, "file"));
                    LET(arts, SAD_LIST_ARTICLES(SAD_ARTICLE_DIR, mfs));
                    RETURN(ARTICLE_FORM_VIEW(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "csrf_token", csrf), "is_edit", TRUE), "now", ""), "articles", arts), "article", SAD_FIND(arts, "file", fname)), "content", SAD_RAW(SAD_ARTICLE_DIR, fname)), "cfg", SAD_CFG)))
               ), (
                    NULL
               ));
               IF(==(route, "new_page"), (
                    RETURN(PAGE_FORM_VIEW(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "csrf_token", csrf), "is_edit", FALSE), "content", ""), "cfg", SAD_CFG)))
               ), (
                    NULL
               ));
               IF(==(route, "edit_page"), (
                    LET(fname, SAD_QUERY(req, "file"));
                    LET(pgs, SAD_LIST_PAGES(SAD_STANDALONE_DIR, mfs));
                    RETURN(PAGE_FORM_VIEW(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "csrf_token", csrf), "is_edit", TRUE), "page", SAD_FIND(pgs, "file", fname)), "content", SAD_RAW(SAD_STANDALONE_DIR, fname)), "cfg", SAD_CFG)))
               ), (
                    NULL
               ));
               IF(==(route, "theme"), (
                    RETURN(THEME_SELECTOR_VIEW(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "csrf_token", csrf), "themes", LIST_THEMES(SAD_THEMES_DIR)), "current_theme", SAD_THEME_NAME)))
               ), (
                    NULL
               ));
               ""
     )));

LET(SAD_VIEW, FUN((route, req, cookie), (
     // app.py:185-224：render_admin_page（也发 CSRF cookie）
     LET(csrf, SAD_EXISTING_CSRF(cookie));
     LET(body, SAD_VIEW_BODY(route, req, csrf));
     LET(shell, SAD_SHELL(AT_K(SAD_TITLES, route, "管理后台"), body, csrf,
          SAD_PATH_OF(req),
          IF(CONTAINS(SAD_HTMX_ROUTES, route), SAD_HTMX_SCRIPT, "")));
     HTML_RESPONSE(INDEX_SET(INDEX_SET(DICT(), "body", shell), "csrf_token", csrf))
)));

LET(SAD_LOGOUT, FUN((cookie), (
     // actions.py:426-437：销毁会话 + 清 cookie + 302 /login
     LET(tok, SESSION_FROM_COOKIE(INDEX_SET(DICT(), "cookie", cookie)));
     SESSION_DESTROY(INDEX_SET(DICT(), "token", tok));
     REDIRECT(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "location", "/login"), "set_cookie", SESSION_CLEAR_COOKIE_HEADER(INDEX_SET(DICT(), "secure", SAD_SECURE))), "security_last", TRUE))
)));

LET(SAD_LOGIN_POST, FUN((req, cookie), (
     // actions.py:382-423 的顺序：CSRF → 口令未配置(503) → 锁定(302) → 凭据(302) → 302 /
     LET(fields, SAD_FIELDS(req));
     IF(!SAD_CSRF_OK(fields, cookie, req), (
          RETURN(REDIRECT(INDEX_SET(DICT(), "location", "/login?error=1")))
     ), NULL);
     IF(==(SAD_PASS, ""), (
          RETURN(TEXT_ERROR_RESPONSE(503, "Admin password is not configured. Set ADMIN_PASS and restart."))
     ), NULL);
     LET(lock, RATE_LIMIT(INDEX_SET(INDEX_SET(DICT(), "client_ip", SAD_CLIENT_IP), "event", "auth_check")));
     IF(AT_K(lock, "locked", FALSE), (
          RETURN(REDIRECT(INDEX_SET(DICT(), "location", "/login?locked=1")))
     ), NULL);
     LET(user, FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "username")));
     LET(pass, FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", fields), "key", "password")));
     IF(!&&(TIMING_SAFE_EQ(user, SAD_USER), TIMING_SAFE_EQ(pass, SAD_PASS)), (
          // 记一次认证失败（security.wll 的锁定计数；5 次 ⇒ 302 /login?locked=1）
          RATE_LIMIT(INDEX_SET(INDEX_SET(DICT(), "client_ip", SAD_CLIENT_IP), "event", "auth_failure"));
          RETURN(REDIRECT(INDEX_SET(DICT(), "location", "/login?error=1")))
     ), NULL);
     LET(tok, SESSION_CREATE(INDEX_SET(DICT(), "client_ip", SAD_CLIENT_IP)));
     // actions.py:419-423：Location "/" → session cookie → 5 个安全头
     REDIRECT(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "location", "/"), "set_cookie", SESSION_COOKIE_HEADER(INDEX_SET(INDEX_SET(DICT(), "token", tok), "secure", SAD_SECURE))), "security_last", TRUE))
)));

LET(SAD_POST, FUN((m, req, cookie), (
     // app.py:241-271：404 已在上面判掉；这里 CSRF → 动作
     LET(fields, SAD_FIELDS(req));
     IF(!SAD_CSRF_OK(fields, cookie, req), (
          // app.py:253-257：豁免路径的失败是 JSON，其余是 text/plain
          RETURN(IF(AT_K(m, "csrf_exempt", FALSE), (
               JSON_ERROR_RESPONSE(403, "CSRF validation failed")
          ), (
               TEXT_ERROR_RESPONSE(403, "CSRF validation failed")
          )))
     ), NULL);
     SAD_ACTION(AT_K(m, "route", ""), fields, req)
)));

LET(SAD_DISPATCH, FUN((m, req, cookie), (
     LET(kind, AT_K(m, "kind", ""));
     IF(==(kind, "login"), (RETURN(SAD_LOGIN_GET(req, cookie))), NULL);
     IF(==(kind, "login_post"), (RETURN(SAD_LOGIN_POST(req, cookie))), NULL);
     IF(==(kind, "logout_post"), (RETURN(SAD_LOGOUT(cookie))), NULL);
     IF(==(kind, "get"), (RETURN(SAD_VIEW(AT_K(m, "route", ""), req, cookie))), NULL);
     SAD_POST(m, req, cookie)
)));

// ── 注入资产白名单（== static_inject/ 当前内容，9 个）──────────────────
LET(SAD_INJECTED, ["/admin.css", "/admin.js", "/highlight-theme.css", "/HIGHLIGHT.md", "/highlight.min.js", "/htmx.min.js", "/manifest.json", "/search.js", "/sw.js"]);

LET(SAD_ROUTE, FUN((req), (
     // app.py:142-152：注入资产在**会话判定之前** —— 登录页自己要能拿到
     // 自己的 CSS/JS，否则整页无样式（2026-11-03 实测缺陷）。
     LET(p0, SAD_PATH_OF(req));
     IF(CONTAINS(SAD_INJECTED, p0), (
          // 读文件 / MIME / 缓存 / 安全门全走公开站那套 `HANDLE`；
          // ⚠ 与 app.py 的唯一差异：原版不判 method（POST 也发文件），
          //   `HANDLE` 只放 GET/HEAD、其余 405 —— 静态资源本就只读，
          //   与公开站口径一致，登记在此不粉饰。
          RETURN(HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", SAD_ROOT), "method", AT_K(req, "method", "GET")), "path", p0)))
     ), NULL);
     // app.py:154-181 的顺序：路由判定 → 会话（未登录 302）→ 404 / 405 → 分发
     LET(m, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", AT_K(req, "method", "GET")), "path", AT_K(req, "path", "/"))));
     LET(cookie, SAD_HEADER(req, "cookie"));
     LET(sess_tok, SESSION_FROM_COOKIE(INDEX_SET(DICT(), "cookie", cookie)));
     LET(sess_ok, IF(==(sess_tok, ""), (FALSE), (
          SESSION_VALIDATE(INDEX_SET(INDEX_SET(DICT(), "token", sess_tok), "client_ip", SAD_CLIENT_IP))
     )));
     IF(&&(AT_K(m, "requires_session", TRUE), !sess_ok), (
          REDIRECT(INDEX_SET(DICT(), "location", "/login"))
     ), (
          IF(==(AT_K(m, "status", 200), 404), (
               TEXT_ERROR_RESPONSE(404, "Not Found")
          ), (
               IF(==(AT_K(m, "status", 200), 405), (
                    TEXT_ERROR_RESPONSE(405, "Method not allowed")
               ), (
                    SAD_DISPATCH(m, req, cookie)
               ))
          ))
     ))
)));

LET(SAD_HANDLE_REQUEST, FUN((req), (
     // app.py:132-140：限流先判（60 次 / 60 秒，按 IP）
     LET(rl, RATE_LIMIT(INDEX_SET(DICT(), "client_ip", SAD_CLIENT_IP)));
     IF(!AT_K(rl, "allowed", TRUE), (
          RATE_LIMIT_RESPONSE(INDEX_SET(DICT(), "retry_after", AT_K(rl, "retry_after", 1)))
     ), (
          SAD_ROUTE(req)
     ))
)));

// ── 优雅停机 + 主循环（照 tp/bin/serve_public.wll 的骨架）──────────────
LET MUT(running, TRUE);
LET MUT(served, 0);
ON_SIGNAL("SIGINT", FUN(() , (SET(running, FALSE); STOP())));
ON_SIGNAL("SIGTERM", FUN(() , (SET(running, FALSE); STOP())));

// ⚠ read_timeout_ms 给 5000：缺省 0 = 无截止时间，一个慢客户端就能把循环卡住
LET(serve_opts, INDEX_SET(DICT(), "read_timeout_ms", 5000));
LET(l, TCP_LISTEN(SAD_LOOPBACK, SAD_PORT));
IF(IS_ERR(l), (
     PRINT_ERR("serve_admin: TCP_LISTEN failed: ", ERR_PAYLOAD(l));
     PANIC("listen failed")
), (
     PRINT("serve_admin: listening on ", SAD_LOOPBACK, ":",
           AT_K(TCP_LOCAL_ADDR(l), "port", 0), " root=", SAD_ROOT);
     WHILE(running, (
          LET(cnt, TCP_SERVE(l, 1000, serve_opts, SAD_HANDLE_REQUEST));
          IF(IS_ERR(cnt), (
               PRINT_ERR("serve_admin: TCP_SERVE failed: ", ERR_PAYLOAD(cnt));
               SET(running, FALSE)
          ), (
               SET(served, +(served, IF(IS_ERR(cnt), 0, cnt)))
          ))
     ))
));

TCP_CLOSE_LISTENER(l);
PRINT("serve_admin: served=", served, " — bye");