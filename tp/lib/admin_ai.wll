// tp/lib/admin_ai.wll —— 管理后台 AI 端点适配层（卡 S5-3）
//
// ⚠ 本文件由 tp/test/gen_admin_ai.py 生成 —— 请勿手改。
//
// 权威实现：
//   admin/actions.py:296-329  ai_assist()：判空 → 分派 → {"result"|"error"}
//   content.py:757-842        translate_article()：lang_map(:794-795) → translate_text(:805)
//
// 导出 → 权威源码行号
//   AI_ASSIST          admin/actions.py:302-304（判空）+ :307-321（分派表）+ :322-329（出参）
//   TRANSLATE_ENDPOINT content.py:794-805（lang_map + translate_text）
//                       + actions.py:311-315（/ai-assist 的 translate 分支，同一张 lang_map）
//   AI_ASSIST_JSON     admin/actions.py:325-329（200 + application/json）
//   TRANSLATE_JSON     同上
//
// 五个能力全部复用 tp/lib/ai.wll（卡 S5-2）：本模块只做「cfg 摊平 + 分派 + 出参口径」。
//
// 三条必须照抄的语义
//   ① 未启用/未配 key ⇒ {"error": "AI 未启用或未配置 API Key"}（actions.py:304 原文）
//   ② 后端错误也必须是 JSON（actions.py:322-329：错误也是 200 + JSON）
//   ③ 未知 action ⇒ {"error": "未知操作: <action>"}（actions.py:320-321），不落默认分支
//
// ⚠ 顺序：先判 AI 是否可用（:302-304），**再**分派（:307-321）
//   ⇒ 「未配置 + 未知 action」报**未配置**，不是「未知操作」
//
// ⚠ 目标语言是**码**：只有 "ja" ⇒ Japanese，其余 ⇒ English（lang_map.get 的字面行为）
//   把语言*名*当码传（如 "Japanese"）按源码口径会落到 English —— 别在接线层改这个
//
// ⚠ 顶层绑定跨模块共享（tp/README 坑 52）⇒ 私有名一律 AIA_ 前缀；
//   下面 4 个导出名是本卡的公共面，别处不得再用作顶层绑定。

IMPORT("wlwl:std.str", ["CAT"]);
// 五个能力 + JSON_ENVELOPE（出参口径）全部来自卡 S5-2，不重写
IMPORT("./ai.wll", ["IS_ENABLED", "COMPLETE", "POLISH", "TRANSLATE", "SUMMARIZE",
        "SUGGEST_TAGS", "JSON_ENVELOPE"]);

// ── 常量 ────────────────────────────────────────────────────────
// actions.py:304 的原文（逐字）。⚠ 只在这里出现一次：改文案就改这一处。
LET(AIA_MSG_UNCONFIGURED, "AI 未启用或未配置 API Key");
// actions.py:321 的前缀（f"未知操作: {action}"）
LET(AIA_MSG_UNKNOWN, "未知操作: ");

// // 取 STRING 选项
     LET(AIA_STR, FUN((opts, key, d), (
               // 取一个「必须是 STRING」的选项（NULL / 其它类型 ⇒ 缺省）;
               LET(v, AT_K(opts, key, d));
               IF(==(TYPE(v), "STRING"), v, d)
     )));

// // 取配置字典
     LET(AIA_CFG, FUN((opts), (
               // opts.cfg 是**配置字典**（ai_enabled / ai_api_key / ai_model / ai_provider / ai_endpoint）;
               // ⚠ 不是 DICT ⇒ 当空配置（AT_K 对 NULL 基值是 E0030，坑 35）;
               LET(c, AT_K(opts, "cfg", NULL));
               IF(==(TYPE(c), "DICT"), c, DICT())
     )));

// // 目标语言码
     LET(AIA_TARGET, FUN((opts), (
               // 目标语言**码**：actions.py:312 先取 lang（缺省 "English" ⇒ 映射后仍是 English）；;
               //   本模块的 opts 用 `target`，并接受 `lang` 同义键;
               LET(t, AIA_STR(opts, "target", ""));
               IF(!=(t, ""), t, AIA_STR(opts, "lang", "en"))
     )));

// // 语言码 → 语言名（硬编码 en/ja）
     LET(AIA_LANG_NAME, FUN((code), (
               // actions.py:313-314 / content.py:794-795 的 lang_map：;
               //   {"en": "English", "ja": "Japanese"}，`get(code, "English")`;
               // ⇒ **只有** "ja" 是 Japanese；未知码、语言名（"Japanese"）都落 English;
               IF(==(code, "ja"), "Japanese", "English")
     )));

// // 摊平 cfg 成 ai.wll 的调用选项
     LET(AIA_CALL_OPTS, FUN((opts), (
               // 把 cfg 摊平成 ai.wll 认识的调用选项：cfg 打底 → 盖 text / target_lang → 透传 exchange;
               // ⚠ ai.wll 读 `ai_enabled` / `ai_api_key` / `ai_model` / ...，正是配置名 ⇒ 直接沿用;
               LET(base, INDEX_SET(INDEX_SET(AIA_CFG(opts), "text", AIA_STR(opts, "text", "")), "target_lang", AIA_LANG_NAME(AIA_TARGET(opts))));
               LET(ex, AT_K(opts, "exchange", NULL));
               IF(==(TYPE(ex), "FUNCTION"), INDEX_SET(base, "exchange", ex), base)
     )));

// // 动作层失败结果
     LET(AIA_FAIL, FUN((message), (
               // 动作层失败形状：JSON_ENVELOPE 读 ok / error（与 admin_actions 的 {ok, error} 同构）;
               INDEX_SET(INDEX_SET(DICT(), "ok", FALSE), "error", message)
     )));

// // action 分派（未知 ⇒ 错误）
     LET(AIA_DISPATCH, FUN((action, o), (
               // admin/actions.py:307-321 的分派表（顺序照抄）：complete / polish / translate /;
               //   suggest_tags / summarize，最后 else 是「未知操作」（:320-321）;
               // ⚠ 未知 action **不得**落到某个能力：最后一个分支只造错误;
               IF(==(action, "complete"), COMPLETE(o), IF(==(action, "polish"), POLISH(o), IF(==(action, "translate"), TRANSLATE(o), IF(==(action, "suggest_tags"), SUGGEST_TAGS(o), IF(==(action, "summarize"), SUMMARIZE(o), AIA_FAIL(CAT(AIA_MSG_UNKNOWN, action)))))))
     )));

// // /ai-assist 的动作层（分派 + 出参）
     LET(AI_ASSIST, FUN((opts), (
               // 对齐 admin/actions.py:296-329：;
               //   ① 先判 AI 是否可用（:302-304）—— **早于**分派 ⇒ 未配置时连未知 action 也报未配置;
               //   ② 再按 action 分派（:307-321），未知 action ⇒ 错误（:320-321）;
               //   ③ 结果交给 JSON_ENVELOPE（:325-329）出 {"result":…} / {"error":…};
               LET(o, AIA_CALL_OPTS(opts));
               IF(!IS_ENABLED(AIA_CFG(opts)), AIA_FAIL(AIA_MSG_UNCONFIGURED), AIA_DISPATCH(AIA_STR(opts, "action", ""), o))
     )));

// // /translate 的 AI 一跳
     LET(TRANSLATE_ENDPOINT, FUN((opts), (
               // /translate 的**文本层**：content.py:794-805 的 lang_map + translate_text。;
               // ⚠ 不在本模块：定位文章 / summarize(200) / 落盘（content.py:776-840）;
               //   ⇒ 收的是正文文本；文章层调用方自己接（本层不碰文件系统）。;
               // 未配置的文案按卡面第 ① 条统一（Python 的 /translate 另有文案，见夹具 meta.divergences）;
               IF(!IS_ENABLED(AIA_CFG(opts)), AIA_FAIL(AIA_MSG_UNCONFIGURED), TRANSLATE(AIA_CALL_OPTS(opts)))
     )));

// // /ai-assist 的响应体（JSON 文本）
     LET(AI_ASSIST_JSON, FUN((opts), (
               // 直接给出响应体：等于 JSON_ENVELOPE(AI_ASSIST(opts))（不自己拼 JSON）;
               JSON_ENVELOPE(AI_ASSIST(opts))
     )));

// // /translate 的响应体（JSON 文本）
     LET(TRANSLATE_JSON, FUN((opts), (
               // 直接给出响应体：等于 JSON_ENVELOPE(TRANSLATE_ENDPOINT(opts));
               JSON_ENVELOPE(TRANSLATE_ENDPOINT(opts))
     )));

EXPORT(["AI_ASSIST", "TRANSLATE_ENDPOINT", "AI_ASSIST_JSON", "TRANSLATE_JSON"]);