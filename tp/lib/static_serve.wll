// tp/lib/static_serve.wll —— 静态文件服务内核（卡 S3-1）
//
// ⚠ 本文件由 tp/test/gen_static_serve.py 生成 —— 请勿手改。
//
// 本模块是**纯函数**：不碰 socket、不 import `tls`、不写文件。
// 传输在入口里（tp/bin/serve_public.wll 明文 / tp/bin/serve_tls.wll TLS），
// 二者只做「收字节 → HANDLE → 发字节」⇒ HTTP 语义可以脱网测。
//
// 权威落点：
//   SECURITY_HEADERS() == nginx.conf:9-13 == tinypage/security.py:331
//   MIME_TYPE(opts)     == tinypage/frontend.py:74 的 guess_type 回落
//   长缓存扩展名        == nginx.conf:43
//   隐藏 / 敏感文件     == nginx.conf:50-57
//   目录回落 index.html == nginx.conf:4-6,18-20
//   短缓存值            == tinypage/frontend.py:78
//
// ⚠ 三处刻意的取舍（理由见生成器 docstring，夹具 meta 里也登记了）：
//   ① 长缓存只发**一个** Cache-Control（nginx 会发两个、Python 只发一个）
//   ② 非长缓存资源发 max-age=300, must-revalidate（frontend.py:78 的有据值）
//   ③ 字体四个扩展名的 MIME 取 nginx/IANA 值（本机 Python 实测给 None）

IMPORT("wlwl:std.fs", ["PATH_JOIN", "PATH_EXT", "PATH_CANONICAL", "PATH_CONTAINS",
    "FILE_META", "READ_FILE"]);
IMPORT("wlwl:std.str", ["INDEX_OF", "CONTAINS_SUB"]);
IMPORT("wlwl:std.text", ["TO_LOWER", "TO_UPPER"]);
IMPORT("wlwl:std.encode", ["BYTE_LEN", "URL_DECODE"]);
IMPORT("wlwl:std.regex", ["RE", "RE_FIND_ALL"]);

// 含字面 ".." 的输入 ⇒ 404（D3 / 卡 S3-1 反向守卫）
// ⚠ 正则里字面点必须写字符类 `[.]`（tp/README 坑 26）；判「含子串」用 RE_FIND_ALL
//   计数（坑 36：RE_TEST 是整串锚定）。
LET(DOTDOT_RE, RE("[.][.]"));

// 路径含 "/." ⇒ 404（nginx.conf:50-53 的 `location ~ /\.`）
LET(HIDDEN_RE, RE("/[.]"));

// MIME 表（键 = PATH_EXT 的小写输出，**不含前导点**）
// ⚠ 一行很长是**故意的**：paren_check / check_semis 只按 `(` 计数，多行数组/多行链会被它们当成「多条顶层语句」误报。
//   要看清楚请读本生成器里的 MIME 表（每行一对，已排序）。
LET(MIME_TABLE, INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "avif", "image/avif"), "css", "text/css"), "gif", "image/gif"), "htm", "text/html"), "html", "text/html"), "ico", "image/x-icon"), "jpeg", "image/jpeg"), "jpg", "image/jpeg"), "js", "application/javascript"), "json", "application/json"), "map", "text/plain"), "md", "text/markdown"), "otf", "font/otf"), "pdf", "application/pdf"), "png", "image/png"), "svg", "image/svg+xml"), "ttf", "font/ttf"), "txt", "text/plain"), "wasm", "application/wasm"), "webmanifest", "application/manifest+json"), "webp", "image/webp"), "woff", "font/woff"), "woff2", "font/woff2"), "xhtml", "application/xhtml+xml"), "xml", "text/xml"));

// 长缓存扩展名（nginx.conf:43；同样不带前导点）
LET(LONG_CACHE_EXTS, ["js", "css", "png", "jpg", "jpeg", "gif", "ico", "svg", "woff", "woff2"]);

// // 是否含字面 ".."
     LET(HAS_DOTDOT, FUN((p), (
               // p 里是否含字面 "..";
               >(LEN(RE_FIND_ALL(DOTDOT_RE, p)), 0)
     )));

// // 是否含 "/."
     LET(HAS_HIDDEN_SEG, FUN((p), (
               // p 里是否含 "/."（隐藏文件 / 隐藏目录）;
               >(LEN(RE_FIND_ALL(HIDDEN_RE, p)), 0)
     )));

// // 敏感文件子串判定（入参须已小写）
     LET(IS_SENSITIVE, FUN((lowered), (
               // 敏感文件：**子串**匹配，且大小写不敏感（nginx 用 `~*`）;
               // ⚠ 传进来的必须是 TO_LOWER 之后的值。;
               ||(CONTAINS_SUB(lowered, "admin_password.txt"), ||(CONTAINS_SUB(lowered, ".env"), CONTAINS_SUB(lowered, ".git")))
     )));

// // GET/HEAD 判定
     LET(IS_READ_METHOD, FUN((m), (
               // 只认 GET / HEAD；其余一律 405（卡 S3-1）;
               ||(==(m, "GET"), ==(m, "HEAD"))
     )));

// // 去掉查询串
     LET(STRIP_QUERY, FUN((p), (
               // 去掉 "?" 之后的部分（入口也会先切一遍，这里是兜底）;
               LET(i, INDEX_OF(p, "?"));
               IF(<(i, 0), p, SUB(p, 0, i))
     )));

// // 去掉开头一个 "/"
     LET(STRIP_LEADING_SLASH, FUN((p), (
               // Python: if path_str.startswith("/"): path_str = path_str[1:];
               IF(==(SUB(p, 0, 1), "/"), SUB(p, 1), p)
     )));

// // percent-decode，失败返回 NULL
     LET(DECODE_PATH, FUN((p), (
               // percent-decode（对齐 nginx「先解码再匹配 location」的口径）。;
               // ⚠ ERR 必须**就地**消费（tp/README 坑 25）⇒ 调用直接写在 IS_ERR 里；;
               //   else 分支再调一次是**纯函数**、代价 O(n)，换来「值 + 失败」两个出口。;
               IF(IS_ERR(URL_DECODE(p)), (
                    NULL
               ), (
                    URL_DECODE(p)
               ))
     )));

// // Cache-Control 取值
     LET(CACHE_CONTROL, FUN((file), (
               // 长缓存命中 ⇒ nginx.conf:43 的语义（值取卡 S3-1 的验收串）;
               // 未命中 ⇒ frontend.py:78 的显式值（见生成器取舍 ②）;
               IF(CONTAINS(LONG_CACHE_EXTS, TO_LOWER(PATH_EXT(file))), (
                    "public, max-age=31536000, immutable"
               ), (
                    "max-age=300, must-revalidate"
               ))
     )));

// // 5 个安全头（顺序 = nginx.conf:9-13）
     LET(SECURITY_HEADERS, FUN((), (
               // 5 个安全头，**键序 = nginx.conf:9-13 = security.py:331 的列表序**。;
               // ⚠ Permissions-Policy 的取值是 8 项（accelerometer … usb），逐字对齐源码（卡 S3-1 写「9 项」是数错，见夹具 meta.findings）。;
               INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "X-Content-Type-Options", "nosniff"), "X-Frame-Options", "DENY"), "Referrer-Policy", "no-referrer"), "Cross-Origin-Opener-Policy", "same-origin"), "Permissions-Policy", "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()")
     )));

// // MIME 类型（对齐 frontend.py:74）
     LET(MIME_TYPE, FUN((opts), (
               // opts 键：path（文件路径或 URL 路径）;
               // 对齐 frontend.py:74：`mimetypes.guess_type(...) or "text/html"`;
               // ⚠ PATH_EXT 不含前导点、且**保留原大小写**（实测 `f.WOFF2` ⇒ "WOFF2"）;
               //   ⇒ 查表前必须 TO_LOWER。;
               LET(p, AT_K(opts, "path", ""));
               AT_K(MIME_TABLE, TO_LOWER(PATH_EXT(p)), "text/html")
     )));

// // Content-Type 头值（text/* 补 charset）
     LET(CONTENT_TYPE_VALUE, FUN((file), (
               // 对齐 frontend.py:76：text/* 补 "; charset=utf-8"，其余原样;
               LET(ct, MIME_TYPE(INDEX_SET(DICT(), "path", file)));
               IF(==(SUB(ct, 0, 5), "text/"), +(ct, "; charset=utf-8"), ct)
     )));

// // 响应字典
     LET(RESPONSE, FUN((status, headers, body), (
               // handler 契约形：{status, headers, body};
               INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "status", status), "headers", headers), "body", body)
     )));

// // 追加 5 个安全头（保持顺序）
     LET(WITH_SECURITY, FUN((h), (
               // 把 5 个安全头按序**追加**到 h 后面（h 先放业务头 ⇒ 业务头在前）。;
               // ⚠ DICT 的键序 = 插入序（实测 KEYS 按插入序返回）⇒ 插入序即线上顺序。;
               LET(sh, SECURITY_HEADERS());
               LET MUT(out, h);
               FOR(k, KEYS(sh), (
                    SET(out, INDEX_SET(out, k, AT_K(sh, k, "")))
               ));
               out
     )));

// // 错误响应（404 / 405 / 500）
     LET(ERROR_RESPONSE, FUN((status, message), (
               // 错误响应：先 Content-Type / Content-Length，再 5 个安全头。;
               // ⚠ 不发 Cache-Control（frontend.py:88 的 `_error` 也不发）。;
               // ⚠ 不发 CSP（security.py:342 是 admin 专用）。;
               LET(h, INDEX_SET(INDEX_SET(DICT(), "Content-Type", "text/plain"), "Content-Length", STR(BYTE_LEN(message))));
               RESPONSE(status, WITH_SECURITY(h), message)
     )));

// // 200 响应（HEAD 清空 body 但保留 Content-Length）
     LET(OK_RESPONSE, FUN((file, method, body), (
               // 200 响应。头序：Content-Type / Content-Length / Cache-Control / 5 个安全头。;
               // ⚠ HEAD 时 body 清空，但 **Content-Length 仍是真实长度** ——;
               //   那正是 HEAD 的语义（「与 GET 相同的头，只是没有体」）。;
               LET MUT(h, INDEX_SET(DICT(), "Content-Type", CONTENT_TYPE_VALUE(file)));
               SET(h, INDEX_SET(h, "Content-Length", STR(BYTE_LEN(body))));
               SET(h, INDEX_SET(h, "Cache-Control", CACHE_CONTROL(file)));
               RESPONSE(200, WITH_SECURITY(h), IF(==(method, "HEAD"), "", body))
     )));

// // 读文件并构造 200
     LET(SERVE_FILE_AT, FUN((method, file), (
               // 到这一步 file 已是「非目录」候选；不存在 / 仍是目录 ⇒ 404（不得 500）。;
               // ⚠ FILE_META 对「不存在」不返 ERR（exists=FALSE）⇒ 可以安全绑定。;
               LET(meta, FILE_META(file));
               IF(||(!AT_K(meta, "exists", FALSE), AT_K(meta, "is_dir", FALSE)), (
                    ERROR_RESPONSE(404, "Not found")
               ), (
                    IF(IS_ERR(READ_FILE(file)), (
                         ERROR_RESPONSE(500, "Server error")
                    ), (
                         OK_RESPONSE(file, method, READ_FILE(file))
                    ))
               ))
     )));

// // 目录回落 index.html
     LET(SERVE_TARGET, FUN((method, target), (
               // 目录 ⇒ 回落该目录的 index.html（nginx.conf:18-20 的 try_files $uri $uri/）。;
               // ⚠ `/list`（无尾斜杠）也走这条 ⇒ 与 nginx 的意图一致（nginx 会先 301 到;
               //   /list/，这里直接给 index.html；不引入重定向头，登记在夹具 meta 里）。;
               LET(meta, FILE_META(target));
               IF(!AT_K(meta, "exists", FALSE), (
                    ERROR_RESPONSE(404, "Not found")
               ), (
                    IF(AT_K(meta, "is_dir", FALSE), (
                         SERVE_FILE_AT(method, PATH_JOIN(target, "index.html"))
                    ), (
                         SERVE_FILE_AT(method, target)
                    ))
               ))
     )));

// // 解析到磁盘路径并服务
     LET(SERVE_DECODED, FUN((root, method, p), (
               // p 已 percent-decode、且已过「隐藏 / 敏感 / ..」三道门。;
               LET(base, PATH_CANONICAL(root));
               LET(target, PATH_CANONICAL(PATH_JOIN(base, STRIP_LEADING_SLASH(p))));
               // 包含性判定：PATH_CONTAINS 是**逐段**判定（挡得住 pages-evil 这类同前缀兄弟）。;
               // ⚠ target == base 是合法的（请求 "/"）⇒ 单独放行。;
               IF(&&(!=(target, base), !PATH_CONTAINS(base, target)), (
                    ERROR_RESPONSE(404, "Not found")
               ), (
                    SERVE_TARGET(method, target)
               ))
     )));

// // 解码 + 安全门 + 服务
     LET(HANDLE_URL, FUN((root, method, raw), (
               // ① 解码（失败 ⇒ 404，fail closed）→ ② 三道门 → ③ 服务。;
               LET(d, DECODE_PATH(STRIP_QUERY(raw)));
               IF(==(TYPE(d), "NULL"), (
                    ERROR_RESPONSE(404, "Not found")
               ), (
                    IF(||(HAS_DOTDOT(d), ||(HAS_HIDDEN_SEG(d), IS_SENSITIVE(TO_LOWER(d)))), (
                         ERROR_RESPONSE(404, "Not found")
                    ), (
                         SERVE_DECODED(root, method, d)
                    ))
               ))
     )));

// // 一次静态请求的完整响应（纯函数）
     LET(HANDLE, FUN((opts), (
               // opts 键：root（产物根目录）/ method（GET|HEAD）/ path / query;
               //   · path 可带查询串（入口可能没切干净）⇒ STRIP_QUERY 兜底;
               //   · query **不参与**解析（对齐 WSGI 的 PATH_INFO / QUERY_STRING 分离）;
               // 返回 {"status": INTEGER, "headers": DICT, "body": STRING};
               LET(root, AT_K(opts, "root", ""));
               LET(method, TO_UPPER(AT_K(opts, "method", "GET")));
               LET(raw, AT_K(opts, "path", "/"));
               IF(IS_READ_METHOD(method), (
                    HANDLE_URL(root, method, raw)
               ), (
                    ERROR_RESPONSE(405, "Method not allowed")
               ))
     )));

EXPORT(["HANDLE", "MIME_TYPE", "SECURITY_HEADERS"]);