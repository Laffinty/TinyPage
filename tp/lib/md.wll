// tp/lib/md.wll —— Markdown 块级解析器
//
// ⚠ 本文件由 tp/test/gen_md.py 生成 —— 请勿手改。
//   改实现请改生成器。理由：WLWL 的括号诊断只说「expected ')' got X」，
//   不告诉你缺了几层；生成器保证括号必然平衡。
//
// 对齐目标：mistune 3.x create_markdown(escape=True) 的输出。
// 逐字节对照基准：tp/test/fixtures/mistune_baseline.json
//   （由 tp/test/gen_mistune_baseline.py 用真正的 mistune 3.2.1 生成）
//
// 支持：标题 #~######、段落、围栏代码块、无序/有序列表、引用块、分隔线。
// 不支持（本版）：表格、嵌套列表、图片、引用式链接、setext 标题、缩进代码块。
//
// ⚠ 三条实测得来的 WLWL 陷阱（本模块已按它们写）：
//   ① `WHILE` 的值是 NULL ⇒ 循环后的表达式必须写在 WHILE **外面**。
//   ② 没有中缀算术：`a + b` 是硬 E0011，必须写 `+(a, b)`。
//   ③ 顶层语句必须以 `;` 结尾。
//
// 导出：
//   RENDER_MD(text) -> STRING   渲染块级 Markdown

IMPORT("wlwl:std.str", ["SPLIT_LINES", "INDEX_OF", "CAT"]);
IMPORT("wlwl:std.sanitize", ["HTML_ESCAPE"]);
IMPORT("wlwl:std.regex", ["RE", "RE_TEST", "RE_FIND_ALL"]);
IMPORT("./md_inline.wll", ["INLINE"]);

// // s 是否以 prefix 开头
     LET(starts_with, FUN((s, prefix), (
               LET MUT(n, LEN(prefix));
               IF(<(LEN(s), n), FALSE, ==(SUB(s, 0, n), prefix))
     )));

// // ATX 标题的层级（0 = 不是标题）
     LET(heading_level, FUN((line), (
               // 返回 0 表示不是标题；否则返回层级 1~6;
               // ATX（CommonMark 口径）：行首连续 # 1~6 个，其后必须是空白或行尾;
               // 循环在第一个非 # 处停下 ⇒ i 即前导 # 的个数;
               LET MUT(n, 0);
               LET MUT(i, 0);
               WHILE(<(i, LEN(line)), (
                    IF(==(SUB(line, i, 1), "#"), (SET(n, +(n, 1)); SET(i, +(i, 1))), (SET(i, LEN(line))))
               ));
               // 终止符：行尾，或空白（# 后必须跟空白才是标题，防 "#tag" 误判）;
               LET(c, IF(<(i, LEN(line)), SUB(line, i, 1), ""));
               IF(&&(>(n, 0), <=(n, 6)), IF(||(==(i, LEN(line)), ||(==(c, " "), ==(c, "\t"))), n, 0), 0)
     )));

// // 去掉标题的 # 与紧随的空白
     LET(heading_text, FUN((line), (
               // 去掉标题的 # 与紧随的空白;
               // ⚠ 用 run 停循环，不得 SET(i, LEN(line)) —— i 之后还要当文本起点;
               LET MUT(i, 0);
               LET MUT(run, TRUE);
               WHILE(&&(run, <(i, LEN(line))), (
                    IF(==(SUB(line, i, 1), "#"), (SET(i, +(i, 1))), (SET(run, FALSE)))
               ));
               LET MUT(rest, SUB(line, i, -(LEN(line), i)));
               TRIM(rest)
     )));

// // 是否是围栏代码块的起止行
     LET(is_fence, FUN((line), (
               starts_with(line, "```")
     )));

// // 围栏后的语言标记
     LET(fence_lang, FUN((line), (
               LET MUT(rest, SUB(line, 3, -(LEN(line), 3)));
               TRIM(rest)
     )));

// // 是否是分隔线（--- / *** / ___）
     LET(is_hr, FUN((line), (
               LET(t, TRIM(line));
               LET(a, starts_with(t, "---"));
               LET(b, starts_with(t, "***"));
               LET(c, starts_with(t, "___"));
               ||(||(a, b), c)
     )));

// // 是否是空行
     LET(is_blank, FUN((line), (
               ==(TRIM(line), "")
     )));

// // 去掉引用块的 "> " 前缀
     LET(quote_text, FUN((line), (
               LET MUT(rest, SUB(line, 1, -(LEN(line), 1)));
               TRIM(rest)
     )));

// // 单个字符是否是 ASCII 数字
     LET(is_digit, FUN((c), (
               &&(>=(c, "0"), <=(c, "9"))
     )));

// // 无序列表标记的长度
     LET(ul_marker_len, FUN((t), (
               // 无序列表标记的长度（- / * / +），不是列表项时返回 0;
               // CommonMark：标记后必须跟空白（防 "**bold**" 的 * 误判为列表项）;
               LET MUT(n, 0);
               IF(&&(>(LEN(t), 1), ||(==(SUB(t, 0, 1), "-"), ||(==(SUB(t, 0, 1), "*"), ==(SUB(t, 0, 1), "+")))), (IF(||(==(SUB(t, 1, 1), " "), ==(SUB(t, 1, 1), "\t")), (SET(n, 1); NULL), NULL); NULL), NULL);
               n
     )));

// // 有序列表标记的长度
     LET(ol_marker_len, FUN((t), (
               // 有序列表标记的长度（1. / 2) / 10.），不是有序列表项时返回 0;
               // CommonMark：数字前缀 + . 或 ) ，其后必须跟空白（防 "1.5 kg" 误判）;
               LET(dot, INDEX_OF(t, "."));
               LET(par, INDEX_OF(t, ")"));
               LET MUT(pos, IF(<(dot, 0), par, dot));
               LET MUT(k, 0);
               LET MUT(allnum, TRUE);
               LET MUT(digits, 0);
               WHILE(<(k, pos), (
                    IF(is_digit(SUB(t, k, 1)), (SET(digits, +(digits, 1))), (SET(allnum, FALSE)));
                    SET(k, +(k, 1))
               ));
               // 标记后的字符：空白 ⇒ 是列表项；行尾/其他 ⇒ 不是;
               LET(after, IF(<(+(pos, 1), LEN(t)), SUB(t, +(pos, 1), 1), ""));
               IF(&&(allnum, &&(>(digits, 0), >=(pos, 1))), IF(||(==(after, " "), ==(after, "\t")), +(pos, 1), 0), 0)
     )));

// // 列表项判定：[kind, text]，kind 为 ul / ol / 空串
     LET(list_marker, FUN((line), (
               // 返回 [kind, text]：kind 是 ul / ol / 空串（不是列表项）;
               LET(t, TRIM(line));
               LET MUT(kind, "");
               LET MUT(rest, t);
               LET MUT(m, 0);
               LET(ulm, ul_marker_len(t));
               LET(olm, ol_marker_len(t));
               IF(>(ulm, 0), (SET(m, ulm)), NULL);
               IF(&&(==(m, 0), >(olm, 0)), (SET(m, olm)), NULL);
               IF(>(m, 0), (SET(kind, "ul"); NULL), NULL);
               IF(&&(>(m, 0), ==(olm, m)), (SET(kind, "ol"); NULL), NULL);
               IF(>(m, 0), (SET(rest, TRIM(SUB(t, m, -(LEN(t), m)))); NULL), NULL);
               IF(==(rest, ""), (SET(kind, ""); NULL), NULL);
               [kind, rest]
     )));

// // 渲染块级 Markdown（对齐 mistune escape=True 的输出）
     LET(RENDER_MD, FUN((text), (
               IF(==(TYPE(text), "NULL"), (RETURN("")), NULL);
               LET(lines, SPLIT_LINES(text));
               LET MUT(n, LEN(lines));
               LET MUT(i, 0);
               LET MUT(out, "");
               LET MUT(para, "");
               LET MUT(in_code, FALSE);
               LET MUT(code_lang, "");
               LET MUT(code_buf, "");
               LET MUT(list_kind, "");
               LET MUT(list_buf, "");
               LET MUT(quote_buf, "");
               LET(flush_para, FUN((), (
                         IF(>(LEN(para), 0), (
                              SET(out, CAT(out, "<p>", INLINE(para), "</p>\n"))
                         ), NULL);
                         SET(para, "")
)));
               LET(flush_list, FUN((), (
                         IF(>(LEN(list_buf), 0), (
                              SET(out, CAT(out, "<", list_kind, ">\n", list_buf, "</", list_kind, ">\n"))
                         ), NULL);
                         SET(list_buf, "");
                         SET(list_kind, "")
)));
               LET(flush_quote, FUN((), (
                         IF(>(LEN(quote_buf), 0), (
                              SET(out, CAT(out, "<blockquote>\n<p>", INLINE(TRIM(quote_buf)), "</p>\n</blockquote>\n"))
                         ), NULL);
                         SET(quote_buf, "")
)));
               WHILE(<(i, n), (
                    LET(line, lines[i]);
                    IF(in_code, (
                         IF(is_fence(line), (
                              SET(out, CAT(out, "<pre><code", IF(==(code_lang, ""), "", CAT(" class=\"language-", code_lang, "\"")), ">", HTML_ESCAPE(code_buf), "</code></pre>\n"));
                              SET(code_buf, "");
                              SET(in_code, FALSE)
                         ), (
                              SET(code_buf, CAT(code_buf, line, "\n"))
                         ))
                    ), (
                         IF(is_fence(line), (
                              SET(in_code, TRUE);
                              SET(code_lang, fence_lang(line));
                              SET(code_buf, "")
                         ), (
                              LET(lvl, heading_level(line));
                              IF(>(lvl, 0), (
                                   SET(out, CAT(out, "<h", STR(lvl), ">", INLINE(heading_text(line)), "</h", STR(lvl), ">\n"))
                              ), (
                                   IF(is_hr(line), (
                                        SET(out, CAT(out, "<hr />\n"))
                                   ), (
                                        IF(is_blank(line), (
                                             flush_para();
                                             flush_list();
                                             flush_quote()
                                        ), (
                                             LET(lm, list_marker(line));
                                             IF(==(lm[0], ""), (
                                                  IF(starts_with(TRIM(line), ">"), (
                                                       flush_para();
                                                       flush_list();
                                                       SET(quote_buf, CAT(quote_buf, quote_text(TRIM(line)), "\n"))
                                                  ), (
                                                       flush_quote();
                                                       IF(>(LEN(para), 0), (
                                                            SET(para, CAT(para, "\n", line))
                                                       ), (
                                                            SET(para, line)
                                                       ))
                                                  ))
                                             ), (
                                                  IF(==(list_kind, lm[0]), NULL, (
                                                       flush_para();
                                                       flush_list();
                                                       SET(list_kind, lm[0])
                                                  ));
                                                  SET(list_buf, CAT(list_buf, "<li>", INLINE(lm[1]), "</li>\n"))
                                             ))
                                        ))
                                   ))
                              ))
                         ))
                    ));
                    SET(i, +(i, 1))
               ));
               flush_para();
               flush_list();
               flush_quote();
               IF(in_code, (
                    SET(out, CAT(out, "<pre><code", IF(==(code_lang, ""), "", CAT(" class=\"language-", code_lang, "\"")), ">", HTML_ESCAPE(code_buf), "</code></pre>\n"))
               ), NULL);
               out
     )));

EXPORT(["RENDER_MD"]);