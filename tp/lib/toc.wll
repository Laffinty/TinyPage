// tp/lib/toc.wll —— 文章目录（TOC）
//
// ⚠ 本文件由 tp/test/gen_toc.py 生成 —— 请勿手改。
//   改实现请改生成器（WLWL 的括号诊断不告诉你缺了几层）。
//
// 对齐目标：tinypage/parsers/toc.py 的四个函数（逐字节对照）：
//   SLUGIFY_HEADING(text)                   == slugify_heading
//   EXTRACT_HEADINGS(md_text)               == extract_headings（返回 ARRAY of DICT）
//   BUILD_TOC_HTML(headings, min, max)      == build_toc_html
//   ADD_HEADING_IDS(html_content, headings) == add_heading_ids
// 逐字节对照基准：tp/test/fixtures/toc_baseline.json
//   （由 tp/test/gen_toc_baseline.py import 真 Python 生成）
//
// ⚠ 已知差异（基准用例均避开）：
//   · wlwl 的 \s 是 ASCII-only，Python 的 \s 含 Unicode 空白（\u3000、\xa0 等）
//     ⇒ 标题行/slug 里出现 Unicode 空白时两边结果可能不同。
//   · ADD_HEADING_IDS 的 map 键（标题文本）必须非空（CONTAINS_SUB 空串 → E0030）；
//     EXTRACT_HEADINGS 产出的 text 恒非空，安全。
//
// 导出：
//   SLUGIFY_HEADING(text) -> STRING
//   EXTRACT_HEADINGS(md_text) -> ARRAY of ["level":INT, "text":STR, "id":STR]
//   BUILD_TOC_HTML(headings, min_level, max_level) -> STRING
//   ADD_HEADING_IDS(html_content, headings) -> STRING

IMPORT("wlwl:std.str", ["SPLIT_LINES", "INDEX_OF", "CONTAINS_SUB", "CAT"]);
IMPORT("wlwl:std.regex", ["RE", "RE_SEARCH", "RE_REPLACE"]);
IMPORT("./esc.wll", ["ESCAPE_HTML"]);

// // 两空格重复 n 次（TOC 缩进）
     LET(indent_sp, FUN((n), (
               // "  " * n（Python 同名语义；负数/0 ⇒ 空串）;
               LET MUT(i, 0);
               LET MUT(acc, "");
               WHILE(<(i, n), (
                    SET(acc, CAT(acc, "  "));
                    SET(i, +(i, 1))
               ));
               acc
     )));

// // 是否是 1~6 的层级数字字符
     LET(is_lvl_digit, FUN((ch), (
               // ch 为空串 ⇒ FALSE（LENGTH 守卫防 SUB 越界取空）;
               &&(>(LEN(ch), 0), &&(>=(ch, "1"), <=(ch, "6")))
     )));

// // slug：对齐 Python slugify_heading
     LET(SLUGIFY_HEADING, FUN((text), (
               // 对齐 Python slugify_heading —— 顺序必须照搬：;
               // ① 删非法字符（保留 ASCII 字母数字 / 汉字 / 空白）;
               // ② 空白序列转 "-" 且整体小写;
               // ③ 连续 "-" 压成一个;
               // ④ 去首尾 "-";
               // ⑤ 结果为空 ⇒ "heading";
               // ⚠ 字符类用字面 一-龥：wlwl 正则不认 \u4e00（实测当字面 u4e00）;
               LET(s1, RE_REPLACE(RE("[^a-zA-Z0-9一-龥\\s]"), text, ""));
               LET(s2, RE_REPLACE(RE("\\s+"), LOWER(s1), "-"));
               LET(s3, RE_REPLACE(RE("-+"), s2, "-"));
               LET(s4, RE_REPLACE(RE("^-+"), s3, ""));
               LET(s5, RE_REPLACE(RE("-+$"), s4, ""));
               IF(==(s5, ""), "heading", s5)
     )));

// // 提取全部 ATX 标题（对齐 Python extract_headings）
     LET(EXTRACT_HEADINGS, FUN((md_text), (
               // 对齐 Python extract_headings：每行先 TRIM 再匹配 ^(#{1,6})\s+(.+)$；;
               // 去重计数按 base_slug 分组（DICT），第 n 次出现的 id 为 base-n。;
               LET(lines, SPLIT_LINES(md_text));
               LET MUT(out, []);
               LET MUT(slug_counts, DICT());
               FOR(line, lines, (
                    LET(t, TRIM(line));
                    LET(m, RE_SEARCH(RE("^(#{1,6})\\s+(.+)$"), t));
                    IF(==(TYPE(m), "NULL"), NULL, (
                         LET(g, AT_K(m, "groups", []));
                         LET(txt, TRIM(g[2]));
                         LET(lvl, LEN(g[1]));
                         LET(base, SLUGIFY_HEADING(txt));
                         LET(cnt, +(AT_K(slug_counts, base, 0), 1));
                         SET(slug_counts, INDEX_SET(slug_counts, base, cnt));
                         SET(out, +(out, [["level": lvl, "text": txt, "id": IF(>(cnt, 1), CAT(base, "-", STR(cnt)), base)]]))
                    ))
               ));
               out
     )));

// // 生成目录 HTML（对齐 Python build_toc_html）
     LET(BUILD_TOC_HTML, FUN((headings, min_level, max_level), (
               // 对齐 Python build_toc_html：过滤 min~max；过滤后为空 ⇒ ""（不是空模板）；;
               // 模板首尾换行逐字节精确（以 \n 开头，</nav> 后无换行）。;
               LET MUT(items, "");
               LET MUT(hit, FALSE);
               FOR(h, headings, (
                    LET(lv, AT_K(h, "level", 0));
                    IF(&&(>=(lv, min_level), <=(lv, max_level)), (
                         SET(hit, TRUE);
                         SET(items, CAT(items, indent_sp(-(lv, min_level)), "<li><a href=\"#", AT_K(h, "id", ""), "\">", ESCAPE_HTML(AT_K(h, "text", "")), "</a></li>"))
                    ), NULL)
               ));
               IF(hit, (
                    CAT("\n<nav class=\"toc\" aria-label=\"文章目录\">\n  <details open>\n    <summary>目录</summary>\n    <ul>\n      ", items, "\n    </ul>\n  </details>\n</nav>")
               ), "")
     )));

// // 给已渲染 HTML 的标题加 id（对齐 Python add_heading_ids）
     LET(ADD_HEADING_IDS, FUN((html_content, headings), (
               // 对齐 Python add_heading_ids：map 按出现顺序（同名后者覆盖值、键位保留首次）；;
               // ⚠ wlwl 正则无反向引用（</\1> → E0030）⇒ 手工扫描：;
               //   对每个 "<h"+1..6 起手的开标签，INDEX_OF 找**同级**闭合标签；;
               //   闭合须自 end+1 起（Python 的 .+? 至少吃 1 字符）、content 可含换行；;
               //   失败则前进 1 字符重试、成功则从闭合尾继续 —— 与 Python;
               //   re.sub(r"<(h[1-6])([^>]*)>(.+?)</\1>", DOTALL) 的左最早语义逐位对齐。;
               LET MUT(map, DICT());
               FOR(h, headings, (
                    SET(map, INDEX_SET(map, AT_K(h, "text", ""), AT_K(h, "id", "")))
               ));
               LET(repl_heading, FUN((raw, tag, attrs, content), (
                         // 已有 id= 原样（含 data-id= 这种子串命中，与 Python "id=" in attrs 同口径）;
                         IF(CONTAINS_SUB(attrs, "id="), (RETURN(raw)), NULL);
                         LET MUT(found, "");
                         FOR(k, map, (
                              IF(==(found, ""), (
                                   IF(CONTAINS_SUB(content, k), (
                                        SET(found, AT_K(map, k, ""))
                                   ), NULL)
                              ), NULL)
                         ));
                         IF(==(found, ""), (
                              RETURN(raw)
                         ), NULL);
                         CAT("<", tag, " id=\"", found, "\"", attrs, ">", content, "</", tag, ">")
)));
               LET MUT(out, "");
               LET MUT(pos, 0);
               LET MUT(q, 0);
               LET MUT(run, TRUE);
               WHILE(run, (
                    LET(p, INDEX_OF(html_content, "<", q));
                    IF(<(p, 0), (
                         SET(run, FALSE)
                    ), (
                         LET(t1, SUB(html_content, p, 2));
                         LET(t2, SUB(html_content, +(p, 2), 1));
                         IF(NOT(&&(==(t1, "<h"), is_lvl_digit(t2))), (
                              SET(q, +(p, 1))
                         ), (
                              LET(e, INDEX_OF(html_content, ">", +(p, 3)));
                              IF(<(e, 0), (
                                   SET(q, +(p, 1))
                              ), (
                                   // tag = "h"+digit（Python 组 1 = h[1-6] 整体，闭合标签是 </h1>）;
                                   LET(tag, SUB(html_content, +(p, 1), 2));
                                   LET(attrs, SUB(html_content, +(p, 3), -(e, +(p, 3))));
                                   LET(end, +(e, 1));
                                   LET(close, CAT("</", tag, ">"));
                                   LET(c, INDEX_OF(html_content, close, +(end, 1)));
                                   IF(<(c, 0), (
                                        SET(q, +(p, 1))
                                   ), (
                                        SET(out, CAT(out, SUB(html_content, pos, -(p, pos))));
                                        SET(out, CAT(out, repl_heading(SUB(html_content, p, -(+(c, LEN(close)), p)), tag, attrs, SUB(html_content, end, -(c, end)))));
                                        SET(pos, +(c, LEN(close)));
                                        SET(q, pos)
                                   ))
                              ))
                         ))
                    ))
               ));
               CAT(out, SUB(html_content, pos, -(LEN(html_content), pos)))
     )));

EXPORT(["SLUGIFY_HEADING", "EXTRACT_HEADINGS", "BUILD_TOC_HTML", "ADD_HEADING_IDS"]);