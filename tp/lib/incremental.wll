// tp/lib/incremental.wll —— 增量构建（对齐 tinypage/core/incremental.py）
//
// ⚠ 本文件由 tp/test/gen_incremental.py 生成 —— 请勿手改。
//   改实现请改生成器（WLWL 的括号诊断不告诉你缺了几层）。
//
// 导出（三个）：
//   SHOULD_USE_INCREMENTAL(opts) -> BOOLEAN   opts: article_count / modified_count / threshold
//        == tinypage/core/incremental.py:131 should_use_incremental
//        article_count < threshold ⇒ FALSE；ratio = modified/article（0 篇 ⇒ 1.0）；
//        ratio **<** 0.1（严格小于）⇒ TRUE。threshold 默认 100（来自函数签名 :134）。
//        ⚠ 比值必须走浮点：WLWL 的 /(整数, 整数) 是截断除法（实测 /(1,10)=0）。
//   BUILD_CACHE_KEY(opts) -> STRING           opts: article_dir
//        == incremental.py:159 build_cache_key
//        sorted(glob("*.html")) 取 "<名>:<int(st_mtime)>"（**秒级截断**）用 | 拼接
//        ⇒ sha256 的**前 12 位**；目录不存在 ⇒ "empty"（存在但空 ⇒ sha256("")[:12]）。
//        ⚠ mtime 是**毫秒** ⇒ 必须按 1000 整除。
//   GET_UNCHANGED(opts) -> DICT              opts: article_dir / cache
//        == incremental.py:182 get_unchanged_articles（**故意修掉兜底缺陷**，见下）
//        返回 ["unchanged": [名…], "modified": [名…]]，两组按名字升序。
//
// ⚠ 故意与 Python 不同的一处：「判定目录不匹配」缺陷
//   Python 的兜底路径 get_modified_files(article_dir, article_dir)（:207）把同一目录
//   既当 source 又当 output ⇒ src.st_mtime > out.st_mtime 恒假 ⇒ modified 恒空
//   ⇒ 该重建的全被漏掉（实测：改 mtime 后 key 变了但 changed=[]；新增文件也 changed=[]）。
//   WLWL 侧改为**逐文件与 cache 里记录的秒级 mtime 比**；cache 缺失 ⇒ 全部 modified。
//   ⚠ 判据仍是 mtime，**不引入内容 hash**。
//
// 已知没做到：大小写交错的名字集合排序口径不同（Python 按 lower、DIR_ENTRIES 按码点）；
//   目录不可读时按「不存在」处理。两项都登记在夹具 limitations 里。
//
// 逐字节对照基准：tp/test/fixtures/incremental_baseline.json
//   （由 tp/test/gen_incremental_baseline.py 用真 Python 生成）

IMPORT("wlwl:std.encode", ["SHA256"]);
IMPORT("wlwl:std.fs", ["DIR_ENTRIES", "FILE_META", "PATH_EXT"]);
IMPORT("wlwl:std.str", ["CAT", "JOIN"]);

// // 内部：读 opts 的一个键
     LET(_OPT, FUN((opts, key, dflt), (
               // opts 不是 DICT ⇒ 回落 dflt（AT_K(NULL, …) 是运行时 E0030，坑 35）。;
               IF(==(TYPE(opts), "DICT"), AT_K(opts, key, dflt), dflt)
     )));

// // 内部：名字是否 *.html
     LET(_IS_HTML_NAME, FUN((name), (
               // 对齐 Python glob("*.html")：只比**后缀**，大小写敏感（实测 A.HTML 不匹配）。;
               ==(PATH_EXT(name), "html")
     )));

// // 内部：目录的真实 mtime（毫秒）
     LET(_DIR_MS, FUN((path), (
               // DIR_ENTRIES 把**目录**的 mtime 归零 ⇒ 目录项必须另取 FILE_META;
               // （Python 的 f.stat() 对目录给真实 mtime ⇒ 不补这一步 key 就对不上）。;
               // ⚠ FILE_META 可能返 ERR ⇒ 直接内联进 IS_ERR（坑 25）；ERR 时按 0 处理;
               //   （未实测的边界，见夹具 limitations.permission_denied_dir）。;
               IF(IS_ERR(FILE_META(path)), 0, AT_K(FILE_META(path), "mtime", 0))
     )));

// // 内部：一个目录项的 mtime（毫秒）
     LET(_ENTRY_MS, FUN((dir, e), (
               // 文件用 DIR_ENTRIES 的 mtime（一次 stat 的快照）；目录走 FILE_META。;
               IF(AT_K(e, "is_dir", FALSE), _DIR_MS(CAT(dir, "/", AT_K(e, "name", ""))), AT_K(e, "mtime", 0))
     )));

// // 内部：一个目录项的 mtime（秒级截断，== Python int(st_mtime)）
     LET(_ENTRY_SEC, FUN((dir, e), (
               // 毫秒 → **秒级截断**：== Python 的 int(st_mtime)（对非负毫秒即 floor）。;
               // ⚠ 这里是本模块唯一的「秒级」入口；改成毫秒会立刻被反向守卫抓住。;
               /(_ENTRY_MS(dir, e), 1000)
     )));

// // 内部：preimage 的一行 "<名>:<秒>"
     LET(_CACHE_LINE, FUN((dir, e), (
               // == Python 的 f"{f.name}:{int(f.stat().st_mtime)}";
               CAT(AT_K(e, "name", ""), ":", STR(_ENTRY_SEC(dir, e)))
     )));

// // 是否值得走增量（== Python incremental.py:131）
     LET(SHOULD_USE_INCREMENTAL, FUN((opts), (
               LET MUT(article_count, _OPT(opts, "article_count", 0));
               LET MUT(modified_count, _OPT(opts, "modified_count", 0));
               LET MUT(threshold, _OPT(opts, "threshold", 100));
               // Python 的顺序就是这三步：先篇数阈值，再比值；0 篇时比值取 1.0（不除零）。;
               IF(<(article_count, threshold), (
                    FALSE
               ), (
                    IF(<=(article_count, 0), (
                         FALSE
                    ), (
                         // 浮点除法：/(整数, 整数) 是截断除法 ⇒ 1/10 会变 0（实测）。;
                         <(/(FLOAT(modified_count), FLOAT(article_count)), 0.1)
                    ))
               ))
     )));

// // 目录状态摘要（== Python incremental.py:159）
     LET(BUILD_CACHE_KEY, FUN((opts), (
               LET MUT(dir, _OPT(opts, "article_dir", ""));
               // Python: `if not article_dir.exists(): return "empty"`（:171）。;
               LET MUT(exists, IF(IS_ERR(FILE_META(dir)), FALSE, AT_K(FILE_META(dir), "exists", FALSE)));
               IF(!(exists), (
                    "empty"
               ), (
                    // 存在但不是目录（例如传了文件）⇒ DIR_ENTRIES 返 ERR；;
                    // Python 侧 glob 对文件路径给空集 ⇒ 内容是空串 ⇒ 同一个 digest。;
                    IF(IS_ERR(DIR_ENTRIES(dir)), (
                         SUB(SHA256(""), 0, 12)
                    ), (
                         LET MUT(lines, []);
                         FOR(e, DIR_ENTRIES(dir), (
                              IF(_IS_HTML_NAME(AT_K(e, "name", "")), (
                                   SET(lines, PUSH(lines, _CACHE_LINE(dir, e)))
                              ), (
                                   NULL
                              ))
                         ));
                         // DIR_ENTRIES 已按名排序（spec std.fs）⇒ 与 Python 的 sorted() 同序;
                         // （除大小写交错，见文件头）。JOIN 的空数组 ⇒ "" ⇒ 与空目录同 digest。;
                         SUB(SHA256(JOIN(lines, "|")), 0, 12)
                    ))
               ))
     )));

// // 按 cache 分出「未变 / 已变」（== Python :182，但修掉兜底缺陷）
     LET(GET_UNCHANGED, FUN((opts), (
               LET MUT(dir, _OPT(opts, "article_dir", ""));
               LET MUT(cache, _OPT(opts, "cache", NULL));
               // 两组都按名字升序（DIR_ENTRIES 的序）—— 返回形状写死在文件头。;
               LET MUT(unchanged, []);
               LET MUT(modified, []);
               IF(IS_ERR(DIR_ENTRIES(dir)), (
                    NULL
               ), (
                    FOR(e, DIR_ENTRIES(dir), (
                         // 目录项不参与：目录不是文章（Python 侧的 articles 全是文件）。;
                         IF(AT_K(e, "is_dir", FALSE), (
                              NULL
                         ), (
                              IF(!(_IS_HTML_NAME(AT_K(e, "name", ""))), (
                                   NULL
                              ), (
                                   LET(nm, AT_K(e, "name", ""));
                                   LET(sec, _ENTRY_SEC(dir, e));
                                   // cache 不是 DICT 时不能 AT_K（坑 35）⇒ 先判类型再取值。;
                                   LET(cached, IF(==(TYPE(cache), "DICT"), AT_K(cache, nm, NULL), NULL));
                                   IF(&&(==(TYPE(cached), "INTEGER"), ==(cached, sec)), (
                                        SET(unchanged, PUSH(unchanged, nm))
                                   ), (
                                        SET(modified, PUSH(modified, nm))
                                   ))
                              ))
                         ))
                    ))
               ));
               ["unchanged": unchanged, "modified": modified]
     )));

// 导出面（三个，卡 S2-5 的契约）
EXPORT(["BUILD_CACHE_KEY", "GET_UNCHANGED", "SHOULD_USE_INCREMENTAL"]);