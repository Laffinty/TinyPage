    (ASSERT_EQ(AT_K(rl_max_ips_2, "failures", "missing"), 0));
    TRUE));
TEST("rate/max_ips/2/tracked_ips", FUN(() ,
    (ASSERT_EQ(AT_K(rl_max_ips_2, "tracked_ips", "missing"), 1));
    TRUE));

// ── 反向守卫：5 次放行后第 6 次必须被限（卡片 S4-2 点名）────────
TEST("guard/sixth_request_blocked", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_5, "allowed", "missing"), FALSE));
    TRUE));
TEST("guard/locked_after_five_failures", FUN(() ,
    (ASSERT_EQ(AT_K(rl_auth_5, "locked", "missing"), TRUE));
    (ASSERT_EQ(AT_K(rl_auth_6, "allowed", "missing"), FALSE));
    TRUE));
// 300 秒后恢复（第 8 步）
TEST("guard/unlocked_after_300s", FUN(() ,
    (ASSERT_EQ(AT_K(rl_auth_8, "locked", "missing"), FALSE));
    (ASSERT_EQ(AT_K(rl_auth_8, "allowed", "missing"), TRUE));
    TRUE));

// ── 审计：单行 JSONL，msg 逐字取自真 Python 日志 ────────────────
// csrf_fail_origin_evil —— msg 逐字取自真 Python 日志（fail_origin_evil 分支）
LET(au_0, AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "CSRF-FAIL"), "now_ms", 1700000000000), "msg", "[CSRF-FAIL] Invalid Origin: http://evil.example.com from 203.0.113.7"), "fields", INDEX_SET(DICT(), "client_ip", "203.0.113.7"))));
TEST("audit/csrf_fail_origin_evil", FUN(() ,
    (ASSERT_EQ(au_0, "{\"ts\":1700000000000,\"level\":\"WARN\",\"event\":\"CSRF-FAIL\",\"msg\":\"[CSRF-FAIL] Invalid Origin: http://evil.example.com from 203.0.113.7\",\"fields\":{\"client_ip\":\"203.0.113.7\"}}"));
    (ASSERT_EQ(LEN(SPLIT(au_0, "\n")), 1));
    TRUE));
