LET(au_2, AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "CSRF-FAIL"), "now_ms", 1700003601000), "msg", "[CSRF-FAIL] Token expired or future timestamp from 203.0.113.7"), "fields", INDEX_SET(DICT(), "client_ip", "203.0.113.7"))));
TEST("audit/csrf_fail_expired_3601", FUN(() ,
    (ASSERT_EQ(au_2, "{\"ts\":1700003601000,\"level\":\"WARN\",\"event\":\"CSRF-FAIL\",\"msg\":\"[CSRF-FAIL] Token expired or future timestamp from 203.0.113.7\",\"fields\":{\"client_ip\":\"203.0.113.7\"}}"));
    (ASSERT_EQ(LEN(SPLIT(au_2, "\n")), 1));
