    (ASSERT_EQ(csrf_25, FALSE));
    TRUE));
// fail_cookie_first_wins —— 同名 cookie 取第一个（即便是坏的）
LET(csrf_26, VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "secret", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "now_ms", 1700000000000), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "cookie", "csrf_token=bad; csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "origin", ""), "referer", ""), "admin_port", 8081), "bind_domain", "")));
TEST("csrf/fail_cookie_first_wins", FUN(() ,
    (ASSERT_EQ(csrf_26, FALSE));
    TRUE));
// fail_origin_evil —— Origin 不在白名单
LET(csrf_27, VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "secret", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "now_ms", 1700000000000), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "cookie", "csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "origin", "http://evil.example.com"), "referer", ""), "admin_port", 8081), "bind_domain", "")));
TEST("csrf/fail_origin_evil", FUN(() ,
    (ASSERT_EQ(csrf_27, FALSE));
    TRUE));
// fail_origin_wrong_port —— Origin 端口不对
LET(csrf_28, VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "secret", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "now_ms", 1700000000000), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "cookie", "csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "origin", "http://127.0.0.1:9099"), "referer", ""), "admin_port", 8081), "bind_domain", "")));
TEST("csrf/fail_origin_wrong_port", FUN(() ,
    (ASSERT_EQ(csrf_28, FALSE));
    TRUE));
// fail_origin_https_localhost —— https 不在 http 白名单里
LET(csrf_29, VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "secret", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "now_ms", 1700000000000), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "cookie", "csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "origin", "https://localhost:8081"), "referer", ""), "admin_port", 8081), "bind_domain", "")));
TEST("csrf/fail_origin_https_localhost", FUN(() ,
    (ASSERT_EQ(csrf_29, FALSE));
    TRUE));
// fail_origin_case —— startswith 区分大小写
LET(csrf_30, VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "secret", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "now_ms", 1700000000000), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "cookie", "csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "origin", "http://LOCALHOST:8081"), "referer", ""), "admin_port", 8081), "bind_domain", "")));
TEST("csrf/fail_origin_case", FUN(() ,
    (ASSERT_EQ(csrf_30, FALSE));
    TRUE));
// ok_origin_prefix_spoof —— 源码是**前缀**匹配 ⇒ 8081.evil.com 会通过（照抄，不加固）
LET(csrf_31, VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "secret", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "now_ms", 1700000000000), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "cookie", "csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "origin", "http://127.0.0.1:8081.evil.com"), "referer", ""), "admin_port", 8081), "bind_domain", "")));
TEST("csrf/ok_origin_prefix_spoof", FUN(() ,
    (ASSERT_EQ(csrf_31, TRUE));
    TRUE));
// fail_referer_evil —— Referer 不在白名单
LET(csrf_32, VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "secret", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "now_ms", 1700000000000), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "cookie", "csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "origin", ""), "referer", "http://evil.example.com/x"), "admin_port", 8081), "bind_domain", "")));
TEST("csrf/fail_referer_evil", FUN(() ,
    (ASSERT_EQ(csrf_32, FALSE));
    TRUE));
// fail_bind_domain_other —— bind_domain 之外的域名被拒
LET(csrf_33, VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "secret", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "now_ms", 1700000000000), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "cookie", "csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "origin", "https://other.example.com"), "referer", ""), "admin_port", 8081), "bind_domain", "blog.example.com")));
TEST("csrf/fail_bind_domain_other", FUN(() ,
    (ASSERT_EQ(csrf_33, FALSE));
    TRUE));

// ── 反向守卫（卡片点名的四条，单独再钉一次）──────────────────────
TEST("guard/tampered_token_must_reject", FUN(() ,
    (ASSERT_EQ(csrf_19, FALSE));
    TRUE));
TEST("guard/expired_token_must_reject", FUN(() ,
    (ASSERT_EQ(csrf_22, FALSE));
    TRUE));
TEST("guard/cookie_mismatch_must_reject", FUN(() ,
    (ASSERT_EQ(csrf_25, FALSE));
    TRUE));
TEST("guard/origin_not_whitelisted_must_reject", FUN(() ,
    (ASSERT_EQ(csrf_27, FALSE));
    TRUE));
// 照抄源码的前缀匹配：这条**故意**通过（不是漏洞修复漏项，是行为对齐）
TEST("guard/origin_prefix_spoof_matches_source", FUN(() ,
    (ASSERT_EQ(csrf_31, TRUE));
    TRUE));

// ── Cookie 头：逐字对齐（含 Secure / Max-Age 的出现与顺序）────────
LET(ck_csrf_plain, CSRF_COOKIE_HEADER(INDEX_SET(INDEX_SET(DICT(), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "secure", FALSE)));
TEST("cookie/csrf_plain", FUN(() ,
    (ASSERT_EQ(LEN(ck_csrf_plain), 2));
    (ASSERT_EQ(AT(ck_csrf_plain, 0, ""), "Set-Cookie"));
    (ASSERT_EQ(AT(ck_csrf_plain, 1, ""), "csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ==; Path=/; HttpOnly; SameSite=Strict"));
    TRUE));
LET(ck_csrf_secure, CSRF_COOKIE_HEADER(INDEX_SET(INDEX_SET(DICT(), "token", "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="), "secure", TRUE)));
TEST("cookie/csrf_secure", FUN(() ,
    (ASSERT_EQ(LEN(ck_csrf_secure), 2));
    (ASSERT_EQ(AT(ck_csrf_secure, 0, ""), "Set-Cookie"));
    (ASSERT_EQ(AT(ck_csrf_secure, 1, ""), "csrf_token=AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ==; Path=/; HttpOnly; SameSite=Strict; Secure"));
    TRUE));
LET(ck_session_plain, SESSION_COOKIE_HEADER(INDEX_SET(INDEX_SET(DICT(), "token", "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8"), "secure", FALSE)));
TEST("cookie/session_plain", FUN(() ,
    (ASSERT_EQ(LEN(ck_session_plain), 2));
    (ASSERT_EQ(AT(ck_session_plain, 0, ""), "Set-Cookie"));
    (ASSERT_EQ(AT(ck_session_plain, 1, ""), "session_id=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8; Path=/; HttpOnly; SameSite=Strict; Max-Age=86400"));
    TRUE));
LET(ck_session_secure_maxage60, SESSION_COOKIE_HEADER(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "token", "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8"), "secure", TRUE), "max_age", 60)));
TEST("cookie/session_secure_maxage60", FUN(() ,
    (ASSERT_EQ(LEN(ck_session_secure_maxage60), 2));
    (ASSERT_EQ(AT(ck_session_secure_maxage60, 0, ""), "Set-Cookie"));
    (ASSERT_EQ(AT(ck_session_secure_maxage60, 1, ""), "session_id=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8; Path=/; HttpOnly; SameSite=Strict; Max-Age=60; Secure"));
    TRUE));
LET(ck_session_clear, SESSION_CLEAR_COOKIE_HEADER(INDEX_SET(DICT(), "secure", FALSE)));
TEST("cookie/session_clear", FUN(() ,
    (ASSERT_EQ(LEN(ck_session_clear), 2));
    (ASSERT_EQ(AT(ck_session_clear, 0, ""), "Set-Cookie"));
    (ASSERT_EQ(AT(ck_session_clear, 1, ""), "session_id=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0"));
    TRUE));
LET(ck_session_clear_secure, SESSION_CLEAR_COOKIE_HEADER(INDEX_SET(DICT(), "secure", TRUE)));
TEST("cookie/session_clear_secure", FUN(() ,
    (ASSERT_EQ(LEN(ck_session_clear_secure), 2));
    (ASSERT_EQ(AT(ck_session_clear_secure, 0, ""), "Set-Cookie"));
    (ASSERT_EQ(AT(ck_session_clear_secure, 1, ""), "session_id=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0; Secure"));
    TRUE));

// ── 会话 token：32B → urlsafe base64 **去 padding**（43 字符）────────
LET(sess_tok, NEW_SESSION_TOKEN(INDEX_SET(DICT(), "random_hex", "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")));
TEST("session/token_exact", FUN(() ,
    (ASSERT_EQ(sess_tok, "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8"));
    (ASSERT_EQ(LEN(sess_tok), 43));
    (ASSERT(RE_TEST(RE("^[A-Za-z0-9_-]+$"), sess_tok)));
    TRUE));

// ── 会话常量（源码类属性：24h / 5000 / 300s）────────────────────
LET(scfg, SESSION_CONFIG(DICT()));
TEST("session/config", FUN(() ,
    (ASSERT_EQ(AT_K(scfg, "max_age", -1), 86400));
    (ASSERT_EQ(AT_K(scfg, "max_tracked", -1), 5000));
    (ASSERT_EQ(AT_K(scfg, "cleanup_interval", -1), 300));
    (ASSERT_EQ(AT_K(scfg, "max_failures", -1), 5));
    (ASSERT_EQ(AT_K(scfg, "lockout_seconds", -1), 300));
    TRUE));

// ── 会话场景：main ────────────────────────────────────────
// create 的结果是 {created, len}（随机值不比）；destroy 记录 null
SESSION_RESET(DICT());
LET(tok_main_s1, SESSION_CREATE(INDEX_SET(INDEX_SET(DICT(), "client_ip", "198.51.100.1"), "now_ms", 1700000000000)));
TEST("session/main/create/s1", FUN(() ,
    (ASSERT_EQ(LEN(tok_main_s1), 43));
    (ASSERT(RE_TEST(RE("^[A-Za-z0-9_-]+$"), tok_main_s1)));
    TRUE));
LET(sv_main_1, SESSION_VALIDATE(INDEX_SET(INDEX_SET(DICT(), "token", tok_main_s1), "now_ms", 1700000000000)));
TEST("session/main/validate/1", FUN(() ,
    (ASSERT_EQ(sv_main_1, TRUE));
    TRUE));
LET(sv_main_2, SESSION_VALIDATE(INDEX_SET(INDEX_SET(DICT(), "token", ""), "now_ms", 1700000000000)));
TEST("session/main/validate/2", FUN(() ,
    (ASSERT_EQ(sv_main_2, FALSE));
    TRUE));
LET(tok_main_s2, SESSION_CREATE(INDEX_SET(INDEX_SET(DICT(), "client_ip", "198.51.100.2"), "now_ms", 1700000001000)));
TEST("session/main/create/s2", FUN(() ,
    (ASSERT_EQ(LEN(tok_main_s2), 43));
    (ASSERT(RE_TEST(RE("^[A-Za-z0-9_-]+$"), tok_main_s2)));
    TRUE));
LET(sv_main_4, SESSION_VALIDATE(INDEX_SET(INDEX_SET(DICT(), "token", tok_main_s1), "now_ms", 1700086400000)));
TEST("session/main/validate/4", FUN(() ,
    (ASSERT_EQ(sv_main_4, TRUE));
    TRUE));
LET(sv_main_5, SESSION_VALIDATE(INDEX_SET(INDEX_SET(DICT(), "token", tok_main_s1), "now_ms", 1700086400001)));
TEST("session/main/validate/5", FUN(() ,
    (ASSERT_EQ(sv_main_5, FALSE));
    TRUE));
LET(sv_main_6, SESSION_VALIDATE(INDEX_SET(INDEX_SET(DICT(), "token", tok_main_s2), "now_ms", 1700086400001)));
TEST("session/main/validate/6", FUN(() ,
    (ASSERT_EQ(sv_main_6, TRUE));
    TRUE));
LET(sd_main_7, SESSION_DESTROY(INDEX_SET(DICT(), "token", tok_main_s2)));
TEST("session/main/destroy/7", FUN(() ,
    (ASSERT_EQ(sd_main_7, TRUE));
    TRUE));
LET(sv_main_8, SESSION_VALIDATE(INDEX_SET(INDEX_SET(DICT(), "token", tok_main_s2), "now_ms", 1700086400002)));
TEST("session/main/validate/8", FUN(() ,
    (ASSERT_EQ(sv_main_8, FALSE));
    TRUE));
LET(sd_main_9, SESSION_DESTROY(INDEX_SET(DICT(), "token", "")));
TEST("session/main/destroy/9", FUN(() ,
    (ASSERT_EQ(sd_main_9, FALSE));
    TRUE));
LET(sf_main_10, SESSION_FROM_COOKIE(INDEX_SET(DICT(), "cookie", "x=1; session_id=abc")));
TEST("session/main/from_cookie/10", FUN(() ,
    (ASSERT_EQ(sf_main_10, "abc"));
    TRUE));
LET(sf_main_11, SESSION_FROM_COOKIE(INDEX_SET(DICT(), "cookie", "x=1")));
TEST("session/main/from_cookie/11", FUN(() ,
    (ASSERT_EQ(sf_main_11, ""));
    TRUE));
LET(cnt_main, SESSION_COUNT(DICT()));
TEST("session/main/count", FUN(() ,
    (ASSERT_EQ(cnt_main, 0));
    TRUE));

