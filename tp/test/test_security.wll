TEST("audit/unknown_event_rejected", FUN(() ,
    (ASSERT_EQ(AUDIT_EVENT(INDEX_SET(DICT(), "event", "NOPE")), ""));
    TRUE));
TEST("audit/level_override", FUN(() ,
    (ASSERT_EQ(AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "CSRF-FAIL"), "level", "ERROR"), "now_ms", 1700000000000), "msg", "[CSRF-FAIL] x")), "{\"ts\":1700000000000,\"level\":\"ERROR\",\"event\":\"CSRF-FAIL\",\"msg\":\"[CSRF-FAIL] x\",\"fields\":{}}"));
    TRUE));

// ── 口令：Argon2id 官方向量 + 自定存储格式 + 错口令必拒 ───────────
// 标准库·安全册 §11.5 的官方向量（Python 独立复算一致）
LET(vec, HASH_PASSWORD(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "password", "password"), "salt_hex", "73616c7453616c7453616c74"), "len", 32)));
TEST("password/argon2_spec_vector", FUN(() ,
    (ASSERT_EQ(vec, "argon2id\$2\$19456\$1\$73616c7453616c7453616c74\$7784e9edc034c74be067bacf7f12f6cfb5babfbccd53f7654386c604d40eb808"));
    TRUE));
LET(argon, HASH_PASSWORD(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "password", "correct horse"), "salt_hex", "00112233445566778899aabbccddeeff"), "t_cost", 2), "m_cost", 19456), "p_cost", 1), "len", 32)));
TEST("password/argon2_stored", FUN(() ,
    (ASSERT_EQ(argon, "argon2id\$2\$19456\$1\$00112233445566778899aabbccddeeff\$8201b97950fdae7af6f6a0c10bfff8675338f97b871a8a7d5c9f7c187db0d1ab"));
    TRUE));
LET(av_ok, VERIFY_PASSWORD(INDEX_SET(INDEX_SET(DICT(), "password", "correct horse"), "stored", "argon2id\$2\$19456\$1\$00112233445566778899aabbccddeeff\$8201b97950fdae7af6f6a0c10bfff8675338f97b871a8a7d5c9f7c187db0d1ab")));
LET(av_bad, VERIFY_PASSWORD(INDEX_SET(INDEX_SET(DICT(), "password", "wrong horse"), "stored", "argon2id\$2\$19456\$1\$00112233445566778899aabbccddeeff\$8201b97950fdae7af6f6a0c10bfff8675338f97b871a8a7d5c9f7c187db0d1ab")));
TEST("password/argon2_verify", FUN(() ,
    (ASSERT_EQ(av_ok, TRUE));
    (ASSERT_EQ(av_bad, FALSE));
    TRUE));
// PBKDF2：OWASP 下界 600000（官方向量）
LET(pbk, HASH_PASSWORD(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "password", "password"), "salt_hex", "73616c74"), "iter", 600000), "len", 32), "algo", "pbkdf2")));
TEST("password/pbkdf2_stored", FUN(() ,
    (ASSERT_EQ(pbk, "pbkdf2-sha256\$600000\$32\$73616c74\$669cfe52482116fda1aa2cbe409b2f56c8e4563752b7a28f6eaab614ee005178"));
    TRUE));
LET(pv_ok, VERIFY_PASSWORD(INDEX_SET(INDEX_SET(DICT(), "password", "password"), "stored", "pbkdf2-sha256\$600000\$32\$73616c74\$669cfe52482116fda1aa2cbe409b2f56c8e4563752b7a28f6eaab614ee005178")));
LET(pv_bad, VERIFY_PASSWORD(INDEX_SET(INDEX_SET(DICT(), "password", "wrong password"), "stored", "pbkdf2-sha256\$600000\$32\$73616c74\$669cfe52482116fda1aa2cbe409b2f56c8e4563752b7a28f6eaab614ee005178")));
TEST("password/pbkdf2_verify", FUN(() ,
    (ASSERT_EQ(pv_ok, TRUE));
    (ASSERT_EQ(pv_bad, FALSE));
    TRUE));
TEST("password/weak_iter_rejected", FUN(() ,
    (ASSERT_EQ(HASH_PASSWORD(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "password", "x"), "salt_hex", "73616c74"), "iter", 1000), "algo", "pbkdf2")), ""));
    (ASSERT_EQ(VERIFY_PASSWORD(INDEX_SET(INDEX_SET(DICT(), "password", "x"), "stored", "pbkdf2-sha256\$1000\$32\$73616c74\$aa")), FALSE));
    TRUE));

// ── 跑测试 + 自己把关退出码 ─────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_security: ", LEN(records), " test(s) run");
LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"), " :: ", AT_K(rec, "error", ""))))));
PRINT("test_security: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_security: FAILED"); PANIC("security tests failed")), NULL);
PRINT("test_security: OK");