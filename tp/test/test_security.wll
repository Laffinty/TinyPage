LET(au_4, AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "CSRF-ERROR"), "now_ms", 1700000000000), "msg", "[CSRF-ERROR] Validation failed from 203.0.113.7: 'ascii' codec can't encode characters in position 0-39: ordinal not in range(128)"), "fields", INDEX_SET(DICT(), "client_ip", "203.0.113.7"))));
TEST("audit/csrf_fail_non_ascii", FUN(() ,
