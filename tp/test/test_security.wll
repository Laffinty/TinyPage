    (ASSERT_EQ(LEN(SPLIT(au_8, "\n")), 1));
    TRUE));
// rate_limit_extension —— D-S4-3：源码无此字面量，S4-2 新增
LET(au_9, AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "RATE-LIMIT"), "now_ms", 1700000000000), "msg", "[RATE-LIMIT] Blocked 203.0.113.7 (retry_after=56)"), "fields", INDEX_SET(INDEX_SET(DICT(), "client_ip", "203.0.113.7"), "retry_after", 56))));
TEST("audit/rate_limit_extension", FUN(() ,
    (ASSERT_EQ(au_9, "{\"ts\":1700000000000,\"level\":\"WARN\",\"event\":\"RATE-LIMIT\",\"msg\":\"[RATE-LIMIT] Blocked 203.0.113.7 (retry_after=56)\",\"fields\":{\"client_ip\":\"203.0.113.7\",\"retry_after\":56}}"));
    (ASSERT_EQ(LEN(SPLIT(au_9, "\n")), 1));
