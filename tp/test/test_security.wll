LET(au_3, AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "CSRF-FAIL"), "now_ms", 1700000000000), "msg", "[CSRF-FAIL] Invalid signature from 203.0.113.7"), "fields", INDEX_SET(DICT(), "client_ip", "203.0.113.7"))));
TEST("audit/csrf_fail_tamper_sig", FUN(() ,
