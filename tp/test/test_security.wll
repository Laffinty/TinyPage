    (ASSERT_EQ(AT_K(rl_max_ips_2, "retry_after", "missing"), 59));
    TRUE));
TEST("rate/max_ips/2/locked", FUN(() ,
    (ASSERT_EQ(AT_K(rl_max_ips_2, "locked", "missing"), FALSE));
    TRUE));
TEST("rate/max_ips/2/lockout_remaining", FUN(() ,
    (ASSERT_EQ(AT_K(rl_max_ips_2, "lockout_remaining", "missing"), 0));
    TRUE));
