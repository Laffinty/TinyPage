// xss_dangerous_protocol —— 真 Python 日志（security.py:306）
LET(au_5, AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "XSS-BLOCK"), "now_ms", 1700000000000), "msg", "[XSS-BLOCK] Dangerous protocol: javascript:alert(1)"), "fields", INDEX_SET(DICT(), "url", "javascript:alert(1)"))));
