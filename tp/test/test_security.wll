    (ASSERT_EQ(rst_1, FALSE));
    TRUE));

// ── 限流 + 登录锁定：每步 6 个字段逐值对拍 ───────────────────────

// 场景 window（9 步）
RATE_LIMIT_RESET(DICT());
LET(rl_window_0, RATE_LIMIT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "client_ip", "10.1.0.1"), "now_ms", 1700000000000), "event", "request"), "max_requests", 5), "window_seconds", 60), "max_failures", 5), "lockout_seconds", 300)));
TEST("rate/window/0/allowed", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_0, "allowed", "missing"), TRUE));
    TRUE));
TEST("rate/window/0/retry_after", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_0, "retry_after", "missing"), 61));
    TRUE));
TEST("rate/window/0/locked", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_0, "locked", "missing"), FALSE));
    TRUE));
TEST("rate/window/0/lockout_remaining", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_0, "lockout_remaining", "missing"), 0));
    TRUE));
TEST("rate/window/0/failures", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_0, "failures", "missing"), 0));
    TRUE));
TEST("rate/window/0/tracked_ips", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_0, "tracked_ips", "missing"), 1));
    TRUE));
LET(rl_window_1, RATE_LIMIT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "client_ip", "10.1.0.1"), "now_ms", 1700000001000), "event", "request"), "max_requests", 5), "window_seconds", 60), "max_failures", 5), "lockout_seconds", 300)));
TEST("rate/window/1/allowed", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_1, "allowed", "missing"), TRUE));
    TRUE));
TEST("rate/window/1/retry_after", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_1, "retry_after", "missing"), 60));
    TRUE));
TEST("rate/window/1/locked", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_1, "locked", "missing"), FALSE));
    TRUE));
TEST("rate/window/1/lockout_remaining", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_1, "lockout_remaining", "missing"), 0));
    TRUE));
TEST("rate/window/1/failures", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_1, "failures", "missing"), 0));
    TRUE));
TEST("rate/window/1/tracked_ips", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_1, "tracked_ips", "missing"), 1));
    TRUE));
LET(rl_window_2, RATE_LIMIT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "client_ip", "10.1.0.1"), "now_ms", 1700000002000), "event", "request"), "max_requests", 5), "window_seconds", 60), "max_failures", 5), "lockout_seconds", 300)));
TEST("rate/window/2/allowed", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_2, "allowed", "missing"), TRUE));
    TRUE));
TEST("rate/window/2/retry_after", FUN(() ,
    (ASSERT_EQ(AT_K(rl_window_2, "retry_after", "missing"), 59));
    TRUE));
TEST("rate/window/2/locked", FUN(() ,
