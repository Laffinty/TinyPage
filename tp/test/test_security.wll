// ⚠ RUN_TESTS() 的失败不影响退出码（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS"]);
IMPORT("wlwl:std.str", ["CAT", "JOIN"]);
IMPORT("wlwl:std.regex", ["RE", "RE_TEST"]);
IMPORT("./../lib/security.wll", ["NEW_CSRF_TOKEN", "VALIDATE_CSRF_TOKEN", "CSRF_COOKIE_HEADER", "NEW_SESSION_TOKEN", "SESSION_COOKIE_HEADER", "SESSION_CLEAR_COOKIE_HEADER", "SESSION_CREATE", "SESSION_VALIDATE", "SESSION_DESTROY", "SESSION_RESET", "SESSION_COUNT", "SESSION_FROM_COOKIE", "SESSION_CONFIG", "RATE_LIMIT", "RATE_LIMIT_RESET", "AUDIT_EVENT", "HASH_PASSWORD", "VERIFY_PASSWORD"]);

// ── CSRF token：注入 secret/random/now_ms ⇒ 与 Python 逐字节一致 ──────
LET(tok, NEW_CSRF_TOKEN(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "secret", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "random_hex", "000102030405060708090a0b0c0d0e0f"), "now_ms", 1700000000000)));
TEST("csrf/token_exact", FUN(() ,
    (ASSERT_EQ(tok, "AAECAwQFBgcICQoLDA0OD2VT8QADsOV5qW0XQQ2jO5X_wSocFyL4QUc3Vwia16wd6b0WaQ=="));
    (ASSERT_EQ(LEN(tok), 72));
    TRUE));
TEST("csrf/token_shape", FUN(() ,
    (ASSERT_EQ(LEN(tok), 72));
    (ASSERT(ENDS_WITH(tok, "==")));
    (ASSERT(RE_TEST(RE("^[A-Za-z0-9_-]+==$"), tok)));
    TRUE));
LET(rt1, NEW_CSRF_TOKEN(DICT()));
LET(rt2, NEW_CSRF_TOKEN(DICT()));
TEST("csrf/random_distinct", FUN(() ,
    (ASSERT(!=(rt1, rt2)));
    (ASSERT_EQ(LEN(rt1), 72));
    (ASSERT_EQ(LEN(rt2), 72));
    TRUE));
LET(rt_ok, VALIDATE_CSRF_TOKEN(INDEX_SET(INDEX_SET(DICT(), "token", rt1), "cookie", CAT("csrf_token=", rt1))));
TEST("csrf/random_token_validates", FUN(() ,
    (ASSERT_EQ(rt_ok, TRUE));
    TRUE));

