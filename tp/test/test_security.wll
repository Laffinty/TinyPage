LET(au_1, AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "CSRF-FAIL"), "now_ms", 1700000000000), "msg", "[CSRF-FAIL] Cookie mismatch from 203.0.113.7"), "fields", INDEX_SET(DICT(), "client_ip", "203.0.113.7"))));
TEST("audit/csrf_fail_cookie_mismatch", FUN(() ,
    (ASSERT_EQ(au_1, "{\"ts\":1700000000000,\"level\":\"WARN\",\"event\":\"CSRF-FAIL\",\"msg\":\"[CSRF-FAIL] Cookie mismatch from 203.0.113.7\",\"fields\":{\"client_ip\":\"203.0.113.7\"}}"));
    (ASSERT_EQ(LEN(SPLIT(au_1, "\n")), 1));
    TRUE));
