// delete_article —— 字面形式取自 content.py:144（不执行文件系统操作）
LET(au_6, AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "DELETE"), "now_ms", 1700000000000), "msg", "[DELETE] Article: 2024-02-03-hello.html"), "fields", INDEX_SET(DICT(), "path", "2024-02-03-hello.html"))));
TEST("audit/delete_article", FUN(() ,
    (ASSERT_EQ(au_6, "{\"ts\":1700000000000,\"level\":\"INFO\",\"event\":\"DELETE\",\"msg\":\"[DELETE] Article: 2024-02-03-hello.html\",\"fields\":{\"path\":\"2024-02-03-hello.html\"}}"));
    (ASSERT_EQ(LEN(SPLIT(au_6, "\n")), 1));
    TRUE));
// delete_quoting —— 钉 JSON 转义与 Python json.dumps 逐字一致
LET(au_7, AUDIT_EVENT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "event", "DELETE"), "now_ms", 1700000000000), "msg", "[DELETE] Article: a\"b\\c-中文.html"), "fields", INDEX_SET(INDEX_SET(DICT(), "path", "a\"b\\c-中文.html"), "note", "引号\\反斜杠"))));
TEST("audit/delete_quoting", FUN(() ,
    (ASSERT_EQ(au_7, "{\"ts\":1700000000000,\"level\":\"INFO\",\"event\":\"DELETE\",\"msg\":\"[DELETE] Article: a\\\"b\\\\c-中文.html\",\"fields\":{\"path\":\"a\\\"b\\\\c-中文.html\",\"note\":\"引号\\\\反斜杠\"}}"));
    (ASSERT_EQ(LEN(SPLIT(au_7, "\n")), 1));
    TRUE));
