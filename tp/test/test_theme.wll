// ── 反向守卫（卡 S2-3 的要求）─────────────────────────────────
// ① ../etc 形态的主题名必须被拒（D5）
TEST("guard/traversal_theme_name_rejected", FUN(() ,
    (ASSERT_EQ(VALIDATE_THEME_NAME("../etc"), FALSE));
    (ASSERT_EQ(VALIDATE_THEME_NAME(".."), FALSE));
    (ASSERT_EQ(VALIDATE_THEME_NAME("a/b"), FALSE));
    (ASSERT_EQ(VALIDATE_THEME_NAME("a\\b"), FALSE));
    (ASSERT_EQ(VALIDATE_THEME_NAME(""), FALSE));
    TRUE));
// ② 即使目录里**真的**存在 themes 之外的 etc/manifest.json，
//    恶意主题名也必须拿到 NULL —— 这是 D5 的可执行形态。
LET(_GUARD_ROOT_, PATH_JOIN(_TD_, "guard_manifest"));
MKDIRS(PATH_JOIN(_GUARD_ROOT_, "themes/alpha"));
MKDIRS(PATH_JOIN(_GUARD_ROOT_, "etc"));
WRITE_BYTES(PATH_JOIN(_GUARD_ROOT_, "etc/manifest.json"), UTF8_ENCODE("{\"name\": \"evil\"}"));
LET(_GUARD_THEMES_, PATH_JOIN(_GUARD_ROOT_, "themes"));
TEST("guard/traversal_manifest_is_null", FUN(() ,
    (ASSERT_EQ(TYPE(LOAD_THEME_MANIFEST("../etc", _GUARD_THEMES_)), "NULL"));
    TRUE));
// ③ CRLF 文件读出的 CSS **不得**含 \r（D7 之外的另一半：换行归一）
//    ⚠ 这条与 load_theme_css/c04 的逐字节对照互补：那条断「等于什么」，
//      这条断「不得含什么」，防的是「两边一起错成 CRLF」。
LET(_CRLF_DIR_, PATH_JOIN(_TD_, "guard_crlf"));
MKDIRS(_CRLF_DIR_);
WRITE_BYTES(PATH_JOIN(_CRLF_DIR_, "theme.css"), UTF8_ENCODE("a\r\nb\r\n"));
LET(_CRLF_CSS_, AT_K(LOAD_THEME_CSS(_CRLF_DIR_), "css", NULL));
TEST("guard/crlf_css_has_no_cr", FUN(() ,
    (ASSERT(!CONTAINS_SUB(_CRLF_CSS_, "\r")));
    (ASSERT_EQ(_CRLF_CSS_, "a\nb\n"));
    TRUE));
// ④ 主题列表必须**目录名升序** —— 目录按**逆序**创建（zeta, mm, alpha）
//    ⇒ 若实现跟随文件系统/创建顺序，这里必红。这是 D6 的可执行形态。
LET(_ORD_DIR_, PATH_JOIN(_TD_, "guard_order"));
MKDIRS(_ORD_DIR_);
MKDIRS(PATH_JOIN(_ORD_DIR_, "zeta"));
MKDIRS(PATH_JOIN(_ORD_DIR_, "mm"));
MKDIRS(PATH_JOIN(_ORD_DIR_, "alpha"));
LET(_ORD_, LIST_THEMES(_ORD_DIR_));
TEST("guard/themes_sorted_ascending", FUN(() ,
    (ASSERT_EQ(LEN(_ORD_), 3));
    (ASSERT_EQ(AT_K(AT(_ORD_, 0, DICT()), "name", NULL), "alpha"));
    (ASSERT_EQ(AT_K(AT(_ORD_, 1, DICT()), "name", NULL), "mm"));
    (ASSERT_EQ(AT_K(AT(_ORD_, 2, DICT()), "name", NULL), "zeta"));
    TRUE));

// ── 跑测试 ────────────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_theme: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_theme: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_theme: FAILED"); PANIC("theme tests failed")), NULL);
PRINT("test_theme: OK");