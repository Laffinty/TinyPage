    (ASSERT_EQ(ESCAPE_HTML(src_case_07), want_case_07));
    TRUE));
TEST("esc/case_08", FUN(() ,
    (ASSERT_EQ(ESCAPE_HTML(src_case_08), want_case_08));
    TRUE));
TEST("esc/case_09", FUN(() ,
    (ASSERT_EQ(ESCAPE_HTML(src_case_09), want_case_09));
    TRUE));
TEST("esc/case_10", FUN(() ,
    (ASSERT_EQ(ESCAPE_HTML(src_case_10), want_case_10));
    TRUE));
TEST("esc/case_11", FUN(() ,
    (ASSERT_EQ(ESCAPE_HTML(src_case_11), want_case_11));
    TRUE));
TEST("esc/case_12", FUN(() ,
    (ASSERT_EQ(ESCAPE_HTML(src_case_12), want_case_12));
    TRUE));
TEST("esc/case_13", FUN(() ,
    (ASSERT_EQ(ESCAPE_HTML(src_case_13), want_case_13));
    TRUE));
