// ── 反向守卫 ──────────────────────────────────────────
// 单引号必须是 &#x27; 而不是内建的 &#39;（与 Python 逐字节对齐）
TEST("guard/apostrophe_is_x27", FUN(() ,
    (ASSERT_EQ(ESCAPE_HTML("'"), "&#x27;"));
    TRUE));

// 字面 &#39; 不得被误替换成 &#x27;（& 已先转成 &amp; ⇒ 子串不成立）
TEST("guard/literal_entity_not_mangled", FUN(() ,
    (ASSERT_EQ(ESCAPE_HTML("&#39;"), "&amp;#39;"));
    TRUE));

// ── 跑测试 ──────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_esc: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_esc: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_esc: FAILED"); PANIC("esc tests failed")), NULL);
PRINT("test_esc: OK");