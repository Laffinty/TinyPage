// ── 反向守卫 ──────────────────────────────────────────
// guard/alias_display_is_b_not_merged
TEST("guard/alias_display_is_b_not_merged", FUN(() ,
    (LET(r, PARSE_BIDIRECTIONAL_LINKS("[[a|b]]", DICT())); ASSERT_EQ(r[0], "[b](/article/a.html)"); ASSERT_EQ(AT_K(r[1][0], "title", "?"), "a"); ASSERT_EQ(AT_K(r[1][0], "display", "?"), "b"));
    TRUE));

// guard/title_whitespace_stripped
TEST("guard/title_whitespace_stripped", FUN(() ,
    (LET(r, PARSE_BIDIRECTIONAL_LINKS("[[ a ]]", DICT())); ASSERT_EQ(r[0], "[a](/article/a.html)"); ASSERT_EQ(AT_K(r[1][0], "title", "?"), "a"));
    TRUE));

// guard/no_wikilink_passthrough
TEST("guard/no_wikilink_passthrough", FUN(() ,
    (LET(t, "普通文本，没有链接。"); LET(r, PARSE_BIDIRECTIONAL_LINKS(t, DICT())); ASSERT_EQ(r[0], t); ASSERT_EQ(r[1], []); ASSERT_EQ(EXTRACT_BIDIRECTIONAL_LINKS(t), []));
    TRUE));

// guard/extract_strips_like_real_python
TEST("guard/extract_strips_like_real_python", FUN(() ,
    (ASSERT_EQ(EXTRACT_BIDIRECTIONAL_LINKS("[[ a ]]"), ["a"]); ASSERT_EQ(EXTRACT_BIDIRECTIONAL_LINKS("[[   ]]"), []));
    TRUE));

// guard/null_map_supported
TEST("guard/null_map_supported", FUN(() ,
    (LET(r, PARSE_BIDIRECTIONAL_LINKS("[[x]]", NULL)); ASSERT_EQ(r[0], "[x](/article/x.html)"));
    TRUE));

// guard/multi_pipe_display
TEST("guard/multi_pipe_display", FUN(() ,
    (LET(r, PARSE_BIDIRECTIONAL_LINKS("[[a|b|c]]", DICT())); ASSERT_EQ(r[0], "[b|c](/article/a.html)"));
    TRUE));

// ── 跑测试 ──────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_wikilink: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_wikilink: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_wikilink: FAILED"); PANIC("wikilink tests failed")), NULL);
PRINT("test_wikilink: OK");