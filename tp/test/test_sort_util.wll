// dates_empty —— 空数组
LET(in_dates_empty, [
]);
LET(want_dates_empty, [
]);

// dates_single —— 单元素 DICT
LET(in_dates_single, [
        ["date": "2024-05-06 07:08", "tag": "x"]
]);
LET(want_dates_single, [
        ["date": "2024-05-06 07:08", "tag": "x"]
]);

// dates_basic_dict —— 三个不同日期 ⇒ **倒序**（新→旧），对齐 content.py:196
LET(in_dates_basic_dict, [
        ["date": "2024-01-02 10:00", "tag": "a"], ["date": "2024-03-02 10:00", "tag": "b"], ["date": "2023-12-31 23:59", "tag": "c"]
]);
LET(want_dates_basic_dict, [
        ["date": "2024-03-02 10:00", "tag": "b"], ["date": "2024-01-02 10:00", "tag": "a"], ["date": "2023-12-31 23:59", "tag": "c"]
]);

// dates_stability_dict —— **相等键** ⇒ 相对次序必须不变（Python sorted 稳定 ⇒ 这是它的答案）
LET(in_dates_stability_dict, [
        ["date": "2024-01-01 00:00", "tag": "p1"], ["date": "2024-02-02 00:00", "tag": "q1"], ["date": "2024-01-01 00:00", "tag": "p2"], ["date": "2024-02-02 00:00", "tag": "q2"], ["date": "2024-01-01 00:00", "tag": "p3"]
]);
LET(want_dates_stability_dict, [
        ["date": "2024-02-02 00:00", "tag": "q1"], ["date": "2024-02-02 00:00", "tag": "q2"], ["date": "2024-01-01 00:00", "tag": "p1"], ["date": "2024-01-01 00:00", "tag": "p2"], ["date": "2024-01-01 00:00", "tag": "p3"]
]);

// dates_missing_date_dict —— 缺 date 键 ⇒ 键为空 ⇒ 与 Python 的 datetime.min 同向（降序排最后）
LET(in_dates_missing_date_dict, [
        ["date": "2024-01-02 10:00", "tag": "has"], ["tag": "missing"], ["date": "2023-01-02 10:00", "tag": "old"]
]);
LET(want_dates_missing_date_dict, [
        ["date": "2024-01-02 10:00", "tag": "has"], ["date": "2023-01-02 10:00", "tag": "old"], ["tag": "missing"]
]);

// dates_seconds_dict —— 带秒的日期串 ⇒ 两键都是 [:16] ⇒ 相等 ⇒ 保持输入次序（稳定）
LET(in_dates_seconds_dict, [
        ["date": "2024-01-01 10:30:45", "tag": "sec"], ["date": "2024-01-01 10:30:10", "tag": "sec2"]
]);
LET(want_dates_seconds_dict, [
        ["date": "2024-01-01 10:30:45", "tag": "sec"], ["date": "2024-01-01 10:30:10", "tag": "sec2"]
]);

// dates_basic_strings —— 纯日期串数组 ⇒ 倒序
LET(in_dates_basic_strings, [
        "2024-01-02 10:00", "2024-03-02 10:00", "2023-12-31 23:59"
]);
LET(want_dates_basic_strings, [
        "2024-03-02 10:00", "2024-01-02 10:00", "2023-12-31 23:59"
]);

// dates_mixed_shape —— DICT 与 STRING **混排**（两种形态都要支持）
LET(in_dates_mixed_shape, [
        ["date": "2024-01-02 10:00", "tag": "d1"], "2024-03-02 10:00", ["date": "2023-12-31 23:59", "tag": "d2"]
]);
LET(want_dates_mixed_shape, [
        "2024-03-02 10:00", ["date": "2024-01-02 10:00", "tag": "d1"], ["date": "2023-12-31 23:59", "tag": "d2"]
]);

