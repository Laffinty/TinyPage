// 基准：tp/test/fixtures/sort_util_baseline.json
//   （由 tp/test/gen_sort_util_baseline.py 用真 Python 生成：
//     · SORT_STRINGS / SORT_BY_DATE 的期望值 = Python 内建 sorted(...)；
//     · dates_real_list_articles 的期望值 = **真项目函数**
//       tinypage.content.list_articles() 的返回顺序 —— 两个独立来源互证。）
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS"]);
IMPORT("wlwl:std.time", ["MONOTONIC"]);
IMPORT("./../lib/sort_util.wll", ["SORT_BY_DATE", "SORT_STRINGS"]);

