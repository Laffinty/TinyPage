// strings_empty —— 空数组
LET(in_strings_empty, [
]);
LET(want_strings_empty, [
]);

// strings_single —— 单元素
LET(in_strings_single, [
        "only"
]);
LET(want_strings_single, [
        "only"
]);

// strings_basic —— 三个不同串
LET(in_strings_basic, [
        "banana", "apple", "cherry"
]);
LET(want_strings_basic, [
        "apple", "banana", "cherry"
]);

// strings_dup —— 重复键 ⇒ 验稳定性（相等元素相对次序不变）
LET(in_strings_dup, [
        "b", "a", "b", "a", "c",
        "a"
]);
LET(want_strings_dup, [
        "a", "a", "a", "b", "b",
        "c"
]);

// strings_case —— ASCII 大小写 ⇒ 码点序（不是 locale 序）
LET(in_strings_case, [
        "b", "A", "a", "B", "Z",
        "z"
]);
LET(want_strings_case, [
        "A", "B", "Z", "a", "b",
        "z"
]);

// strings_unicode —— 非 ASCII（中文/带音标）⇒ 码点序
LET(in_strings_unicode, [
        "中", "a", "文", "Z", "é",
        "中", "a"
]);
LET(want_strings_unicode, [
        "Z", "a", "a", "é", "中",
        "中", "文"
]);

// strings_prefix —— 前缀关系 + 空串
LET(in_strings_prefix, [
        "abc", "ab", "abcd", "a", "",
        "b"
]);
LET(want_strings_prefix, [
        "", "a", "ab", "abc", "abcd",
        "b"
]);

// strings_punct —— 标点与空白 ⇒ 码点序
LET(in_strings_punct, [
        "-", "0", "9", "A", "_",
        "a", "~", " "
]);
LET(want_strings_punct, [
        " ", "-", "0", "9", "A",
        "_", "a", "~"
]);

// strings_sorted —— 已升序（不该动）
LET(in_strings_sorted, [
        "a", "b", "c", "d"
]);
LET(want_strings_sorted, [
        "a", "b", "c", "d"
]);

// strings_reversed —— 已降序
LET(in_strings_reversed, [
        "d", "c", "b", "a"
]);
LET(want_strings_reversed, [
        "a", "b", "c", "d"
]);

