    (ASSERT(&&(EXISTS(PATH_JOIN(_TAA_UP_12_ST_, "images/2026-11/same-1.png")), _TAA_ARR_EQ_(READ_BYTES(PATH_JOIN(_TAA_UP_12_ST_, "images/2026-11/same-1.png")), [137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 1, 0, 0, 0, 1, 8, 6, 0, 0, 0, 31, 21, 196, 137, 0, 0, 0, 13, 73, 68, 65, 84, 120, 218, 99, 252, 207, 192, 240, 31, 0, 5, 0, 1, 255, 171, 206, 54, 137, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130, 0, 0]))));
    TRUE));

// ── 已登记差异 D1b：base64 尾部多一个 "="（Python 宽容、本模块拒）────
// 基准 deviations.b64_lenient_pad：Python 把 "AAAA=" 解成 3 字节，
// 本模块要求「= 只在结尾且补位后恰好补齐一组」⇒ 报 Invalid base64 data。
// 两种口径下都过不了 magic bytes，对外差别只在错误码。
LET(_TAA_DEV_PAD_D_, PATH_JOIN(_TAA_ROOT_, "dev_pad"));
MKDIRS(_TAA_DEV_PAD_D_);
LET(_TAA_DEV_PAD_, UPLOAD_IMAGE(["filename": "p.png", "data": "AAAA=", "static_dir": _TAA_DEV_PAD_D_, "year": 2026, "month": 11]));
// Python 侧 base64.b64decode('AAAA=') == b'\x00\x00\x00'（3 字节）；这里钉 WLWL 口径
TEST("deviation/b64_lenient_pad", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_DEV_PAD_, "ok", TRUE), FALSE));
    (ASSERT_EQ(AT_K(_TAA_DEV_PAD_, "error", ""), "Invalid base64 data"));
    TRUE));

// ── ⑦ 主题：SET_THEME 只做「选中 + 落 config」；重建交给 REGEN ─────
LET(_TAA_THEMES_, PATH_JOIN(_TAA_ROOT_, "themes"));
LET(_TAA_MANIFEST_, PATH_JOIN(_TAA_THEMES_, "default/manifest.json"));
MKDIRS(PATH_JOIN(_TAA_THEMES_, "default"));
WRITE_FILE(_TAA_MANIFEST_, "{}");
// ① 全新：目录里没有 config.json
LET(_TAA_CFG1_, PATH_JOIN(_TAA_ROOT_, "cfg_fresh"));
MKDIRS(_TAA_CFG1_);
LET(_TAA_CFG1_F_, PATH_JOIN(_TAA_CFG1_, "config.json"));
LET(_TAA_T1_, SET_THEME(["theme": "default", "themes_dir": _TAA_THEMES_, "config_dir": _TAA_CFG1_]));
TEST("theme/set_ok", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_T1_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_T1_, "theme", ""), "default"));
    (ASSERT_EQ(AT_K(_TAA_T1_, "persisted", FALSE), TRUE));
    TRUE));
// 基准 fresh_config = {"theme_name":"default"}（D6：WLWL 紧凑+排序，按语义比）
TEST("theme/fresh_config", FUN(() ,
    (ASSERT(EXISTS(_TAA_CFG1_F_)));
    (ASSERT_EQ(AT_K(PARSE(READ_FILE(_TAA_CFG1_F_)), "theme_name", ""), "default"));
    TRUE));
// ② 已有 config.json（含 locale）⇒ 合并，其余键保留
LET(_TAA_CFG2_, PATH_JOIN(_TAA_ROOT_, "cfg_merge"));
MKDIRS(_TAA_CFG2_);
LET(_TAA_CFG2_F_, PATH_JOIN(_TAA_CFG2_, "config.json"));
WRITE_FILE(_TAA_CFG2_F_, "{\"locale\": \"zh\"}");
LET(_TAA_T2_, SET_THEME(["theme": "default", "themes_dir": _TAA_THEMES_, "config_dir": _TAA_CFG2_]));
// 基准 merged_config = {"locale":"zh","theme_name":"default"}
TEST("theme/merged_config", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_T2_, "persisted", FALSE), TRUE));
    (ASSERT_EQ(AT_K(PARSE(READ_FILE(_TAA_CFG2_F_)), "theme_name", ""), "default"));
    (ASSERT_EQ(AT_K(PARSE(READ_FILE(_TAA_CFG2_F_)), "locale", ""), "zh"));
    TRUE));
// ③ 现有 config.json 不是合法 JSON ⇒ Python 抛 JSONDecodeError ⇒ 只 warning、不写
LET(_TAA_CFG3_, PATH_JOIN(_TAA_ROOT_, "cfg_broken"));
MKDIRS(_TAA_CFG3_);
LET(_TAA_CFG3_F_, PATH_JOIN(_TAA_CFG3_, "config.json"));
WRITE_FILE(_TAA_CFG3_F_, "{oops");
LET(_TAA_T3_, SET_THEME(["theme": "default", "themes_dir": _TAA_THEMES_, "config_dir": _TAA_CFG3_]));
// 读失败/解析失败 ⇒ set_theme 仍成功，但不持久化（actions.py:367）
TEST("theme/broken_config_not_overwritten", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_T3_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_T3_, "persisted", TRUE), FALSE));
    (ASSERT_EQ(READ_FILE(_TAA_CFG3_F_), "{oops"));
    TRUE));

// ── ⑧ 预览（只做 Markdown 渲染）+ 重建（只回报「该重建了」）──────
LET(_TAA_PV_00_R_, PREVIEW(["content": "# 标题\n\n正文 **粗** 与 `code`\n"]));
LET(_TAA_PV_01_R_, PREVIEW(["content": "- a\n- b\n"]));
LET(_TAA_PV_02_R_, PREVIEW(["content": "段落一\n\n段落二\n"]));
LET(_TAA_PV_03_R_, PREVIEW(["content": ""]));
// 输入 '# 标题'
TEST("preview/00", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_PV_00_R_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_PV_00_R_, "html", ""), "<h1>标题</h1>\n<p>正文 <strong>粗</strong> 与 <code>code</code></p>\n"));
    TRUE));
// 输入 '- a'
TEST("preview/01", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_PV_01_R_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_PV_01_R_, "html", ""), "<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n"));
    TRUE));
// 输入 '段落一'
TEST("preview/02", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_PV_02_R_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_PV_02_R_, "html", ""), "<p>段落一</p>\n<p>段落二</p>\n"));
    TRUE));
// 输入 '<empty>'
TEST("preview/03", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_PV_03_R_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_PV_03_R_, "html", ""), "<p class=\"preview-placeholder\">（无内容）</p>"));
    TRUE));
LET(_TAA_REGEN_, REGEN(DICT()));
// 全站构建在 tp/bin/build.wll::BUILD，本模块只回报「该重建了」
TEST("regen/ok", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_REGEN_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_REGEN_, "regen", FALSE), TRUE));
    TRUE));

// ── ⑨ 错误路径：20 例（消息逐字 + 状态码映射）───────────────────
LET(_TAA_ERR_, PATH_JOIN(_TAA_ROOT_, "err"));
MKDIRS(_TAA_ERR_);
WRITE_FILE(PATH_JOIN(_TAA_ERR_, "dup.html"), "<!-- title: d -->\n");
LET(_TAA_E00_R_, CREATE_ARTICLE(["article_dir": _TAA_ERR_, "title": "", "date": "2026-01-02 10:30", "content": "c"]));
LET(_TAA_E01_R_, CREATE_ARTICLE(["article_dir": _TAA_ERR_, "title": "T", "date": "", "content": "c"]));
LET(_TAA_E02_R_, CREATE_ARTICLE(["article_dir": _TAA_ERR_, "title": "T", "date": "abcdefghij", "content": "c"]));
LET(_TAA_E03_R_, CREATE_ARTICLE(["article_dir": _TAA_ERR_, "title": _TAA_T201_, "date": "2026-01-02 10:30", "content": "c"]));
LET(_TAA_E04_R_, CREATE_ARTICLE(["article_dir": _TAA_ERR_, "title": "T", "date": "2026-01-02 10:30", "content": _TAA_C50001_]));
LET(_TAA_E05_R_, SAVE_ARTICLE(["article_dir": _TAA_ERR_, "file": "2026-01-02-t.html", "title": "T", "date": "2026-13-01 10:00", "content": "c"]));
LET(_TAA_E06_R_, SAVE_ARTICLE(["article_dir": _TAA_ERR_, "file": "", "title": "T", "date": "2026-01-02 10:30", "content": "c"]));
LET(_TAA_E07_R_, SAVE_ARTICLE(["article_dir": _TAA_ERR_, "file": "bad.html", "title": "T", "date": "2026-01-02 10:30", "content": "c"]));
LET(_TAA_E08_R_, DELETE_ARTICLE(["article_dir": _TAA_ERR_, "file": "/etc/passwd"]));
LET(_TAA_E09_R_, CREATE_PAGE(["standalone_dir": _TAA_ERR_, "title": "T", "slug": "", "content": "c"]));
LET(_TAA_E10_R_, CREATE_PAGE(["standalone_dir": _TAA_ERR_, "title": "T", "slug": "a/b", "content": "c"]));
LET(_TAA_E11_R_, CREATE_PAGE(["standalone_dir": _TAA_ERR_, "title": "T", "slug": "dup", "content": "c"]));
LET(_TAA_E12_R_, SAVE_PAGE(["standalone_dir": _TAA_ERR_, "file": "a b.html", "title": "T", "slug": "s", "content": "c"]));
LET(_TAA_E13_R_, DELETE_PAGE(["standalone_dir": _TAA_ERR_, "file": "x.txt"]));
LET(_TAA_E14_R_, SET_THEME(["theme": "", "themes_dir": _TAA_THEMES_, "config_dir": _TAA_ERR_]));
LET(_TAA_E15_R_, SET_THEME(["theme": "nope", "themes_dir": _TAA_THEMES_, "config_dir": _TAA_ERR_]));
LET(_TAA_E16_R_, UPLOAD_IMAGE(["filename": "", "data": "x", "static_dir": _TAA_ERR_]));
LET(_TAA_E17_R_, UPLOAD_IMAGE(["filename": "shell.php", "data": "PD9waHA=", "static_dir": _TAA_ERR_, "year": 2026, "month": 11]));
LET(_TAA_E18_R_, UPLOAD_IMAGE(["filename": "a.png", "data": "AAAAA", "static_dir": _TAA_ERR_, "year": 2026, "month": 11]));
LET(_TAA_E19_R_, UPLOAD_IMAGE(["filename": "a.png", "data": "PD9waHAgZWNobyAxOyA/Pg==", "static_dir": _TAA_ERR_, "year": 2026, "month": 11]));

