// ── ⑩ 反向守卫（卡点名 ①②③ + 补 ④⑤⑥⑦）──────────────────────
// ① 扩展名白名单：.php / .html 即使内容是合法 PNG 也必须拒
LET(_TAA_G_PHP_, UPLOAD_IMAGE(["filename": "x.php", "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFAAH/q842iQAAAABJRU5ErkJggg==", "static_dir": _TAA_GST_, "year": 2026, "month": 11]));
LET(_TAA_G_HTML_, UPLOAD_IMAGE(["filename": "x.html", "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFAAH/q842iQAAAABJRU5ErkJggg==", "static_dir": _TAA_GST_, "year": 2026, "month": 11]));
// 内容 = 合法 1×1 PNG 的 base64
TEST("guard/upload_php_rejected", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_G_PHP_, "ok", TRUE), FALSE));
    (ASSERT_EQ(AT_K(_TAA_G_PHP_, "error", ""), "File type not allowed: .php"));
    TRUE));
TEST("guard/upload_html_rejected", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_G_HTML_, "ok", TRUE), FALSE));
    (ASSERT_EQ(AT_K(_TAA_G_HTML_, "error", ""), "File type not allowed: .html"));
    TRUE));
TEST("guard/upload_php_html_not_on_disk", FUN(() ,
    (ASSERT(!EXISTS(PATH_JOIN(_TAA_GST_, "images/2026-11/x.php"))));
    (ASSERT(!EXISTS(PATH_JOIN(_TAA_GST_, "images/2026-11/x.html"))));
    TRUE));
// ② 扩展名合法但内容不是图片 ⇒ magic bytes 必须拒
LET(_TAA_G_MAGIC_, UPLOAD_IMAGE(["filename": "shell.png", "data": "PD9waHAgc3lzdGVtKCRfR0VUW2NdKTsgPz4=", "static_dir": _TAA_GST_, "year": 2026, "month": 11]));
// data = base64("<?php system($_GET[c]); ?>")
TEST("guard/upload_php_as_png_rejected", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_G_MAGIC_, "ok", TRUE), FALSE));
    (ASSERT_EQ(AT_K(_TAA_G_MAGIC_, "error", ""), "Invalid image format"));
    (ASSERT(!EXISTS(PATH_JOIN(_TAA_GST_, "images/2026-11/shell.png"))));
    TRUE));
// ③（见上：guard/delete_failure_*）
// ④ 删除文件名带 `..` ⇒ 拒，且目录外文件不受影响
WRITE_FILE(PATH_JOIN(_TAA_ROOT_, "outside.txt"), "keep");
LET(_TAA_G_TRAV_, DELETE_ARTICLE(["article_dir": _TAA_ART_, "file": "../outside.txt"]));
TEST("guard/delete_traversal_rejected", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_G_TRAV_, "ok", TRUE), FALSE));
    (ASSERT(EXISTS(PATH_JOIN(_TAA_ROOT_, "outside.txt"))));
    (ASSERT_EQ(READ_FILE(PATH_JOIN(_TAA_ROOT_, "outside.txt")), "keep"));
    TRUE));
// ⑤ 上传文件名带 `..` ⇒ 净化后仍含 `..` ⇒ 拒，且不落盘
LET(_TAA_G_UPTRAV_, UPLOAD_IMAGE(["filename": "../x.png", "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFAAH/q842iQAAAABJRU5ErkJggg==", "static_dir": _TAA_GST_, "year": 2026, "month": 11]));
// 净化把 `/` 换成 `_` ⇒ ".._x.png"；`..` 仍在 ⇒ 拒
TEST("guard/upload_traversal_rejected", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_G_UPTRAV_, "ok", TRUE), FALSE));
    (ASSERT_EQ(AT_K(_TAA_G_UPTRAV_, "error", ""), "Invalid filename"));
    (ASSERT(!EXISTS(PATH_JOIN(_TAA_ROOT_, "x.png"))));
    (ASSERT(!EXISTS(PATH_JOIN(_TAA_GST_, "images/2026-11/.._x.png"))));
    TRUE));
// ⑥ 独立页 slug 带 `../` ⇒ 拒，且目录外无文件
LET(_TAA_G_SLUG_, CREATE_PAGE(["standalone_dir": _TAA_PG_, "title": "T", "slug": "../evil", "content": "c"]));
TEST("guard/page_slug_traversal_rejected", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_G_SLUG_, "ok", TRUE), FALSE));
    (ASSERT_EQ(AT_K(_TAA_G_SLUG_, "error", ""), "Invalid slug"));
    (ASSERT(!EXISTS(PATH_JOIN(_TAA_ROOT_, "evil.html"))));
    TRUE));
// ⑦ SAVE_PAGE 改 slug ⇒ 旧文件必须消失 —— 见 page/save_old_removed

// ── 跑测试 ────────────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_admin_actions: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_admin_actions: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_admin_actions: FAILED"); PANIC("admin_actions tests failed")), NULL);
PRINT("test_admin_actions: OK");