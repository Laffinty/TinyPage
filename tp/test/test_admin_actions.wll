// ── ② 文章：create → save → delete ──────────────────────────
// ⚠ 测试体在 RUN_TESTS() 里才跑（晚于全部顶层 LET）⇒ create 与 save 必须
//   用**两个目录**，否则 save 覆盖同文件后 create 的断言比的是 save 的产物。
//   基准里两者共用一条路径、按时间顺序各读一次；这里用 `art_create` /
//   `art_save` 两个目录复现同一序列（save 目录先 create 再 save）。
LET(_TAA_ARTD_C_, PATH_JOIN(_TAA_ROOT_, "art_create"));
LET(_TAA_ARTD_S_, PATH_JOIN(_TAA_ROOT_, "art_save"));
MKDIRS(_TAA_ARTD_C_);
MKDIRS(_TAA_ARTD_S_);
LET(_TAA_ART_C_, CREATE_ARTICLE(["article_dir": _TAA_ARTD_C_, "title": "Hello World", "date": "2026-01-02 10:30", "content": "正文 **粗体**\n\n- 一\n- 二", "tags": "a,b", "category": "tech", "status": "draft"]));
LET(_TAA_ART_HTML_, PATH_JOIN(_TAA_ARTD_C_, "2026-01-02-hello-world.html"));
LET(_TAA_ART_MD_, PATH_JOIN(_TAA_ARTD_C_, "2026-01-02-hello-world.md"));
TEST("article/create_ok", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_ART_C_, "ok", FALSE), TRUE));
    TRUE));
TEST("article/create_file", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_ART_C_, "file", ""), "2026-01-02-hello-world.html"));
    TRUE));
// 正文在兄弟 .md 里（skip_html_generation，差异 D5）
TEST("article/create_md", FUN(() ,
    (ASSERT_EQ(READ_FILE(_TAA_ART_MD_), "正文 **粗体**\n\n- 一\n- 二"));
    TRUE));
// 文章 .html = 7 行 meta 头（基准 create.html）
TEST("article/create_html", FUN(() ,
    (ASSERT_EQ(READ_FILE(_TAA_ART_HTML_), "<!-- title: Hello World -->\n<!-- date: 2026-01-02 10:30 -->\n<!-- slug: hello-world -->\n<!-- tags: a,b -->\n<!-- summary:  -->\n<!-- category: tech -->\n<!-- status: draft -->\n"));
    TRUE));
// save 目录：先 create 出同一份文件，再 save 覆盖（与基准同起点）
LET(_TAA_ART_S0_, CREATE_ARTICLE(["article_dir": _TAA_ARTD_S_, "title": "Hello World", "date": "2026-01-02 10:30", "content": "正文 **粗体**\n\n- 一\n- 二", "tags": "a,b", "category": "tech", "status": "draft"]));
LET(_TAA_ART_S_, SAVE_ARTICLE(["article_dir": _TAA_ARTD_S_, "file": "2026-01-02-hello-world.html", "title": "Hello World v2", "date": "2026-01-03 08:00", "content": "第二版正文", "tags": "x", "category": "misc", "status": "published"]));
LET(_TAA_ART_SHTML_, PATH_JOIN(_TAA_ARTD_S_, "2026-01-02-hello-world.html"));
LET(_TAA_ART_SMD_, PATH_JOIN(_TAA_ARTD_S_, "2026-01-02-hello-world.md"));
// 快照：后面的 delete 会删掉这两个文件，而测试体要晚于全部顶层 LET 才跑
LET(_TAA_ART_SMD_TXT_, _TAA_READ_(_TAA_ART_SMD_));
LET(_TAA_ART_SHTML_TXT_, _TAA_READ_(_TAA_ART_SHTML_));
TEST("article/save_ok", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_ART_S_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_ART_S_, "file", ""), "2026-01-02-hello-world.html"));
    TRUE));
TEST("article/save_md", FUN(() ,
    (ASSERT_EQ(_TAA_ART_SMD_TXT_, "第二版正文"));
    TRUE));
// 改标题后 slug 变 hello-world-v2，但**文件名不变** —— 与 Python 同
TEST("article/save_html", FUN(() ,
    (ASSERT_EQ(_TAA_ART_SHTML_TXT_, "<!-- title: Hello World v2 -->\n<!-- date: 2026-01-03 08:00 -->\n<!-- slug: hello-world-v2 -->\n<!-- tags: x -->\n<!-- summary:  -->\n<!-- category: misc -->\n<!-- status: published -->\n"));
    TRUE));
LET(_TAA_ART_D_, DELETE_ARTICLE(["article_dir": _TAA_ARTD_S_, "file": "2026-01-02-hello-world.html"]));
TEST("article/delete_ok", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_ART_D_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_ART_D_, "deleted", FALSE), TRUE));
    TRUE));
TEST("article/delete_files_gone", FUN(() ,
    (ASSERT(!EXISTS(_TAA_ART_SHTML_)));
    (ASSERT(!EXISTS(_TAA_ART_SMD_)));
    TRUE));
// 基准 backup_left == []（备份必须清干净）
TEST("article/delete_no_backup_left", FUN(() ,
    (ASSERT(!EXISTS(CAT(_TAA_ART_SHTML_, ".backup"))));
    (ASSERT(!EXISTS(CAT(_TAA_ART_SMD_, ".backup"))));
    TRUE));
LET(_TAA_ART_DM_, DELETE_ARTICLE(["article_dir": _TAA_ARTD_S_, "file": "2026-01-02-nope.html"]));
// Python: `if path.is_file()` 不成立 ⇒ 什么都不做、仍重定向（actions.py:102）
TEST("article/delete_missing_ok", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_ART_DM_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_ART_DM_, "deleted", TRUE), FALSE));
    TRUE));

// ── ③ 删除失败 ⇒ 回滚（卡点名守卫 ③）────────────────────────────
// Python 侧靠 monkeypatch `shutil.copy2` 第二次调用抛 OSError 造失败；
// WLWL 没有注入点 ⇒ 用**同义的失败源**：把备份目标 `<file>.html.backup`
// 先造成一个**目录** ⇒ COPY 必然失败（Python 的 copy2 到目录同样抛）。
// 断言的可观察结果与基准一致：失败 + 文章与 .md 都还在、内容未变。
LET(_TAA_RB_, PATH_JOIN(_TAA_ROOT_, "rollback"));
MKDIRS(_TAA_RB_);
LET(_TAA_RB_HTML_, PATH_JOIN(_TAA_RB_, "2026-02-03-rollback.html"));
LET(_TAA_RB_MD_, PATH_JOIN(_TAA_RB_, "2026-02-03-rollback.md"));
WRITE_FILE(_TAA_RB_HTML_, "<!-- title: R -->\n");
WRITE_FILE(_TAA_RB_MD_, "回滚正文");
MKDIRS(CAT(_TAA_RB_HTML_, ".backup"));
LET(_TAA_RB_R_, DELETE_ARTICLE(["article_dir": _TAA_RB_, "file": "2026-02-03-rollback.html"]));
TEST("guard/delete_failure_reports_error", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_RB_R_, "ok", TRUE), FALSE));
    (ASSERT_EQ(_TAA_STATUS_(AT_K(_TAA_RB_R_, "error", "")), "500"));
    TRUE));
// 基准 html_still_there == True 且内容未变
TEST("guard/delete_failure_html_kept", FUN(() ,
    (ASSERT(EXISTS(_TAA_RB_HTML_)));
    (ASSERT_EQ(READ_FILE(_TAA_RB_HTML_), "<!-- title: R -->\n"));
    TRUE));
// 基准 md_still_there == True 且内容未变
TEST("guard/delete_failure_md_kept", FUN(() ,
    (ASSERT(EXISTS(_TAA_RB_MD_)));
    (ASSERT_EQ(READ_FILE(_TAA_RB_MD_), "回滚正文"));
    TRUE));

// ── ④ 重名创建：改用 `<date>-<slug>-<suffix>.html`（差异 D2）────
LET(_TAA_COL_, PATH_JOIN(_TAA_ROOT_, "collision"));
MKDIRS(_TAA_COL_);
WRITE_FILE(PATH_JOIN(_TAA_COL_, "2026-01-02-hello-world.html"), "<!-- title: old -->\n");
LET(_TAA_COL_R_, CREATE_ARTICLE(["article_dir": _TAA_COL_, "title": "Hello World", "date": "2026-01-02 10:30", "content": "正文 **粗体**\n\n- 一\n- 二", "tags": "a,b", "category": "tech", "status": "draft", "suffix": "AbC123"]));
// 基准 names_after 里新文件是 2026-01-02-hello-world-AbC123.html
TEST("article/collision_new_name", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_COL_R_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_COL_R_, "file", ""), "2026-01-02-hello-world-AbC123.html"));
    TRUE));
// 旧文件必须原样保留（不能被覆盖）
TEST("article/collision_both_exist", FUN(() ,
    (ASSERT(EXISTS(PATH_JOIN(_TAA_COL_, "2026-01-02-hello-world-AbC123.html"))));
    (ASSERT(EXISTS(PATH_JOIN(_TAA_COL_, "2026-01-02-hello-world.html"))));
    (ASSERT_EQ(READ_FILE(PATH_JOIN(_TAA_COL_, "2026-01-02-hello-world.html")), "<!-- title: old -->\n"));
    TRUE));

// ── ⑤ 独立页：create → save（改 slug）→ delete ────────────────
// ⚠ 同 ②：create 与 save 用两个目录（save 会删掉旧 slug 的文件）。
LET(_TAA_PGD_C_, PATH_JOIN(_TAA_ROOT_, "pg_create"));
LET(_TAA_PGD_S_, PATH_JOIN(_TAA_ROOT_, "pg_save"));
MKDIRS(_TAA_PGD_C_);
MKDIRS(_TAA_PGD_S_);
LET(_TAA_PG_C_, CREATE_PAGE(["standalone_dir": _TAA_PGD_C_, "title": "关于", "slug": "about", "content": "# 关于\n\n你好"]));
LET(_TAA_PG_OLD_, PATH_JOIN(_TAA_PGD_C_, "about.html"));
LET(_TAA_PG_OLDM_, PATH_JOIN(_TAA_PGD_C_, "about.md"));
TEST("page/create_ok", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_PG_C_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_PG_C_, "file", ""), "about.html"));
    TRUE));
TEST("page/create_md", FUN(() ,
    (ASSERT_EQ(READ_FILE(_TAA_PG_OLDM_), "# 关于\n\n你好"));
    TRUE));
// D5：整页渲染交给 REGEN ⇒ 只剩 title/summary 两行 meta 头
TEST("page/create_html", FUN(() ,
    (ASSERT_EQ(READ_FILE(_TAA_PG_OLD_), "<!-- title: 关于 -->\n<!-- summary:  -->\n"));
    TRUE));
// save 目录：先 create 出 about.html，再 save 成 contact.html
LET(_TAA_PG_C0_, CREATE_PAGE(["standalone_dir": _TAA_PGD_S_, "title": "关于", "slug": "about", "content": "# 关于\n\n你好"]));
LET(_TAA_PG_OLD2_, PATH_JOIN(_TAA_PGD_S_, "about.html"));
LET(_TAA_PG_OLD2M_, PATH_JOIN(_TAA_PGD_S_, "about.md"));
LET(_TAA_PG_S_, SAVE_PAGE(["standalone_dir": _TAA_PGD_S_, "file": "about.html", "title": "联系", "slug": "contact", "content": "联系正文"]));
LET(_TAA_PG_NEW_, PATH_JOIN(_TAA_PGD_S_, "contact.html"));
LET(_TAA_PG_NEWM_, PATH_JOIN(_TAA_PGD_S_, "contact.md"));
// 快照（后面的 delete 会删掉这两个文件；测试体跑得更晚）
LET(_TAA_PG_NEWM_TXT_, _TAA_READ_(_TAA_PG_NEWM_));
LET(_TAA_PG_NEW_TXT_, _TAA_READ_(_TAA_PG_NEW_));
TEST("page/save_ok", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_PG_S_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_PG_S_, "file", ""), "contact.html"));
    TRUE));
// 基准 save.left == [contact.html, contact.md] ⇒ about.* 必须消失（守卫⑦）
TEST("page/save_old_removed", FUN(() ,
    (ASSERT(!EXISTS(_TAA_PG_OLD2_)));
    (ASSERT(!EXISTS(_TAA_PG_OLD2M_)));
    TRUE));
TEST("page/save_new_content", FUN(() ,
    (ASSERT_EQ(_TAA_PG_NEWM_TXT_, "联系正文"));
    (ASSERT_EQ(_TAA_PG_NEW_TXT_, "<!-- title: 联系 -->\n<!-- summary:  -->\n"));
    TRUE));
LET(_TAA_PG_D_, DELETE_PAGE(["standalone_dir": _TAA_PGD_S_, "file": "contact.html"]));
TEST("page/delete_ok", FUN(() ,
    (ASSERT_EQ(AT_K(_TAA_PG_D_, "ok", FALSE), TRUE));
    (ASSERT_EQ(AT_K(_TAA_PG_D_, "deleted", FALSE), TRUE));
    TRUE));
// 基准 delete.left == []
TEST("page/delete_files_gone", FUN(() ,
    (ASSERT(!EXISTS(_TAA_PG_NEW_)));
    (ASSERT(!EXISTS(_TAA_PG_NEWM_)));
    TRUE));

