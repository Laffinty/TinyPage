// tp/test/test_admin_actions.wll —— 卡 S4-4：文章/独立页 CRUD + 上传 + 主题 + 预览
//
// ⚠ 本文件由 tp/test/gen_test_admin_actions.py 生成 —— 请勿手改。
//
// 期望值全部来自 tp/test/fixtures/admin_actions_baseline.json
//   （gen_admin_actions_baseline.py 用**真 Python** action 产出）。
//
// ⚠ 与 Python 的已登记差异（D1–D11）见 tp/test/gen_admin_actions.py 的 docstring；
//   本文件把其中**可观察**的三条也钉住（D3 slug unicode / D1b base64 补位 /
//   title="" 走不到 slugify），钉的是 WLWL 侧自己的口径。
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS", "TEMP_DIR"]);
IMPORT("wlwl:std.fs", ["MKDIRS", "WRITE_FILE", "WRITE_BYTES", "READ_FILE",
     "READ_BYTES", "EXISTS", "PATH_JOIN", "FILE_META"]);
IMPORT("wlwl:std.json", ["PARSE"]);
IMPORT("wlwl:std.str", ["CAT", "INDEX_OF"]);
IMPORT("./../lib/admin_actions.wll", ["CREATE_ARTICLE", "SAVE_ARTICLE",
     "DELETE_ARTICLE", "CREATE_PAGE", "SAVE_PAGE", "DELETE_PAGE",
     "SET_THEME", "PREVIEW", "REGEN", "UPLOAD_IMAGE"]);

// ── 测试侧工具（顶层名一律 TAA_ 前缀：陷阱 #52 顶层绑定跨模块共享）──
// // _TAA_ARR_EQ_(a, b) -> BOOLEAN
     LET(_TAA_ARR_EQ_, FUN((a, b), (
               // 字节数组逐元素比较（避免依赖 `==` 对 ARRAY 的语义）;
               IF(||(!=(TYPE(a), "ARRAY"), !=(TYPE(b), "ARRAY")), (
                    FALSE
               ), (
                    LET(na, LEN(a));
                    LET(nb, LEN(b));
                    IF(!=(na, nb), (
                         FALSE
                    ), (
                         LET MUT(i, 0);
                         LET MUT(same, TRUE);
                         WHILE(&&(same, <(i, na)), (
                              IF(!=(AT(a, i, -1), AT(b, i, -1)), (
                                   SET(same, FALSE)
                              ), (
                                   NULL
                              ));
                              SET(i, +(i, 1))
                         ));
                         same
                    ))
               ))
     )));

// // _TAA_DBL_(unit, times) -> STRING
     LET(_TAA_DBL_, FUN((unit, times), (
               // 反复自拼 n 次：1 → 2 → 4 → … ⇒ O(n) 步；用来造超长输入;
               LET MUT(s, unit);
               LET MUT(i, 0);
               WHILE(<(i, times), (
                    SET(s, +(s, s));
                    SET(i, +(i, 1))
               ));
               s
     )));

// 读文件；不存在时给哨兵（避免 LET 直接绑 ERR ⇒ E0103，陷阱 #25）
// // _TAA_READ_(p) -> STRING
     LET(_TAA_READ_, FUN((p), (
               IF(EXISTS(p), (READ_FILE(p)), ("<missing>"))
     )));

// // _TAA_STATUS_(msg) -> "400"/"409"/"500"
     LET(_TAA_STATUS_, FUN((msg), (
               // 错误文本 → Python 侧会给出的 HTTP 状态码（见生成器 docstring 的对照表）;
               LET(map, _TAA_STATUS_MAP_);
               LET MUT(i, 0);
               LET MUT(done, FALSE);
               LET MUT(out, "500");
               WHILE(&&(!done, <(i, LEN(map))), (
                    LET(row, AT(map, i, []));
                    LET(pfx, AT(row, 0, ""));
                    IF(==(INDEX_OF(msg, pfx), 0), (
                         SET(out, AT(row, 1, "500"));
                         SET(done, TRUE)
                    ), (
                         NULL
                    ));
                    SET(i, +(i, 1))
               ));
               out
     )));

// 状态码映射表：**先 409、再 500 专属前缀、最后 400**。
// ⚠ 顺序有意义：`Invalid filename: x`（500）以 `Invalid filename`（400）开头。
LET(_TAA_STATUS_MAP_, [
    ["Page already exists", "409"],
    ["Invalid filename: ", "500"],
    ["Title invalid or too long: ", "500"],
    ["Content validation failed: ", "500"],
    ["Invalid date format: ", "500"],
    ["Invalid page filename: ", "500"],
    ["Missing fields", "400"],
    ["Invalid filename", "400"],
    ["Invalid slug", "400"],
    ["Missing theme name", "400"],
    ["Theme not found", "400"],
    ["Missing filename or data", "400"],
    ["File type not allowed: ", "400"],
    ["Invalid base64 data", "400"],
    ["Invalid image format", "400"],
    ["File too large", "400"]
]);

// ── 工作区（TEMP_DIR ⇒ 绝不出现机器相关路径）────────────────────
LET(_TAA_ROOT_, TEMP_DIR());
LET(_TAA_ART_, PATH_JOIN(_TAA_ROOT_, "articles"));
LET(_TAA_PG_, PATH_JOIN(_TAA_ROOT_, "pages"));
LET(_TAA_GST_, PATH_JOIN(_TAA_ROOT_, "guard_static"));
MKDIRS(_TAA_ART_);
MKDIRS(_TAA_PG_);
MKDIRS(_TAA_GST_);

// 201 / 50001 字符的输入：倍增到 ≥ 长度再 SUB 裁切（WLWL 没有 REPEAT 内建）
LET(_TAA_T201_, SUB(_TAA_DBL_("T", 8), 0, 201));
LET(_TAA_C50001_, SUB(_TAA_DBL_("x", 16), 0, 50001));

