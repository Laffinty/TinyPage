    TRUE));
TEST("md/code_fence_quotes", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_code_fence_quotes), want_code_fence_quotes));
    TRUE));
TEST("md/empty", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_empty), want_empty));
    TRUE));
TEST("md/heading_h1", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_heading_h1), want_heading_h1));
    TRUE));
