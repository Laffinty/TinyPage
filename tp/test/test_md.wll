    (ASSERT_EQ(RENDER_MD(src_heading_h6), want_heading_h6));
    TRUE));
TEST("md/heading_with_inline", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_heading_with_inline), want_heading_with_inline));
    TRUE));
TEST("md/hr", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_hr), want_hr));
    TRUE));
TEST("md/hr_star", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_hr_star), want_hr_star));
    TRUE));
TEST("md/inline_bold", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_inline_bold), want_inline_bold));
    TRUE));
TEST("md/inline_code", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_inline_code), want_inline_code));
    TRUE));
TEST("md/inline_escape_html", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_inline_escape_html), want_inline_escape_html));
    TRUE));
TEST("md/inline_italic", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_inline_italic), want_inline_italic));
    TRUE));
TEST("md/inline_link", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_inline_link), want_inline_link));
    TRUE));
TEST("md/inline_link_relative", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_inline_link_relative), want_inline_link_relative));
    TRUE));
TEST("md/list_with_inline", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_list_with_inline), want_list_with_inline));
    TRUE));
TEST("md/ol", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_ol), want_ol));
    TRUE));
TEST("md/ol_paren", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_ol_paren), want_ol_paren));
    TRUE));
TEST("md/only_blank", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_only_blank), want_only_blank));
    TRUE));
TEST("md/para_blank_sep", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_para_blank_sep), want_para_blank_sep));
    TRUE));
TEST("md/para_multi_line", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_para_multi_line), want_para_multi_line));
    TRUE));
TEST("md/para_single", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_para_single), want_para_single));
    TRUE));
TEST("md/text_no_trailing_nl", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_text_no_trailing_nl), want_text_no_trailing_nl));
    TRUE));
TEST("md/ul", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_ul), want_ul));
    TRUE));
TEST("md/ul_plus", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_ul_plus), want_ul_plus));
    TRUE));

// ── 反向守卫：代码块内不得解析行内语法 ──────────────────
// 围栏代码块里的 ** 与 ` 必须是**字面量**（对齐 mistune）
LET(src_guard_code, "```\n**not bold** and `not code`\n```\n");
LET(want_guard_code, "<pre><code>**not bold** and `not code`\n</code></pre>\n");
TEST("guard/code_block_keeps_markdown_literal", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_guard_code), want_guard_code));
    TRUE));

// 围栏里的 # 不是标题
LET(src_guard_hash, "```\n# not a heading\n```\n");
LET(want_guard_hash, "<pre><code># not a heading\n</code></pre>\n");
TEST("guard/code_block_hash_is_not_heading", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_guard_hash), want_guard_hash));
    TRUE));

// 未闭合围栏必须闭合而不是吞掉剩余全文
LET(src_guard_open, "```\nunclosed\n");
LET(want_guard_open, "<pre><code>unclosed\n</code></pre>\n");
TEST("guard/unclosed_fence_closes", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_guard_open), want_guard_open));
    TRUE));

// ── 跑测试 ──────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_md: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_md: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_md: FAILED"); PANIC("md tests failed")), NULL);
PRINT("test_md: OK");