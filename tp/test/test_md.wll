// tp/test/test_md.wll —— 块级解析器测试（对照 mistune 3.2.1）
//
// ⚠ 本文件由 tp/test/gen_test_md.py 生成 —— 请勿手改。
//
// 验收方式：每个用例都与**真正的 mistune 3.2.1** 的输出逐字节对照。
// 基准：tp/test/fixtures/mistune_baseline.json
//   （由 tp/test/gen_mistune_baseline.py 用真 mistune 生成）
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS"]);
IMPORT("wlwl:std.str", ["CONTAINS_SUB"]);
IMPORT("./../lib/md.wll", ["RENDER_MD"]);

// blockquote
LET(src_blockquote, "> quoted\n");
LET(want_blockquote, "<blockquote>\n<p>quoted</p>\n</blockquote>\n");

// code_fence_lang
LET(src_code_fence_lang, "```python\nx = 1\n```\n");
LET(want_code_fence_lang, "<pre><code class=\"language-python\">x = 1\n</code></pre>\n");

// code_fence_nolang
LET(src_code_fence_nolang, "```\nplain\n```\n");
LET(want_code_fence_nolang, "<pre><code>plain\n</code></pre>\n");

// code_fence_quote_lang
LET(src_code_fence_quote_lang, "```js\na'b\n```\n");
LET(want_code_fence_quote_lang, "<pre><code class=\"language-js\">a'b\n</code></pre>\n");

// code_fence_quotes
LET(src_code_fence_quotes, "```\nx'y\"z<w>&v\n```\n");
LET(want_code_fence_quotes, "<pre><code>x'y&quot;z&lt;w&gt;&amp;v\n</code></pre>\n");

// empty
LET(src_empty, "");
LET(want_empty, "");

// heading_h1
LET(src_heading_h1, "# Title\n");
LET(want_heading_h1, "<h1>Title</h1>\n");

// heading_h6
LET(src_heading_h6, "###### Six\n");
LET(want_heading_h6, "<h6>Six</h6>\n");

// heading_with_inline
LET(src_heading_with_inline, "## Sub *it*\n");
LET(want_heading_with_inline, "<h2>Sub <em>it</em></h2>\n");

// hr
LET(src_hr, "---\n");
LET(want_hr, "<hr />\n");

// hr_star
LET(src_hr_star, "***\n");
LET(want_hr_star, "<hr />\n");

// inline_bold
LET(src_inline_bold, "a **b** c\n");
LET(want_inline_bold, "<p>a <strong>b</strong> c</p>\n");

// inline_code
LET(src_inline_code, "a `b` c\n");
LET(want_inline_code, "<p>a <code>b</code> c</p>\n");

// inline_escape_html
LET(src_inline_escape_html, "<script>alert(1)</script>\n");
LET(want_inline_escape_html, "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>\n");

// inline_italic
LET(src_inline_italic, "a *b* c\n");
LET(want_inline_italic, "<p>a <em>b</em> c</p>\n");

// inline_link
LET(src_inline_link, "[t](https://a.b/c)\n");
LET(want_inline_link, "<p><a href=\"https://a.b/c\">t</a></p>\n");

// inline_link_relative
LET(src_inline_link_relative, "[t](/x/y)\n");
LET(want_inline_link_relative, "<p><a href=\"/x/y\">t</a></p>\n");

// list_with_inline
LET(src_list_with_inline, "- a **b**\n- c `d`\n");
LET(want_list_with_inline, "<ul>\n<li>a <strong>b</strong></li>\n<li>c <code>d</code></li>\n</ul>\n");

// ol
LET(src_ol, "1. one\n2. two\n");
LET(want_ol, "<ol>\n<li>one</li>\n<li>two</li>\n</ol>\n");

// ol_paren
LET(src_ol_paren, "1) one\n2) two\n");
LET(want_ol_paren, "<ol>\n<li>one</li>\n<li>two</li>\n</ol>\n");

// only_blank
LET(src_only_blank, "\n\n\n");
LET(want_only_blank, "");

// para_blank_sep
LET(src_para_blank_sep, "First para.\n\nSecond para.\n");
LET(want_para_blank_sep, "<p>First para.</p>\n<p>Second para.</p>\n");

// para_multi_line
LET(src_para_multi_line, "Line one\nLine two\nLine three\n");
LET(want_para_multi_line, "<p>Line one\nLine two\nLine three</p>\n");

// para_single
LET(src_para_single, "Just one paragraph.\n");
LET(want_para_single, "<p>Just one paragraph.</p>\n");

// text_no_trailing_nl
LET(src_text_no_trailing_nl, "no newline at end");
LET(want_text_no_trailing_nl, "<p>no newline at end</p>\n");

// ul
LET(src_ul, "- one\n- two\n");
LET(want_ul, "<ul>\n<li>one</li>\n<li>two</li>\n</ul>\n");

// ul_plus
LET(src_ul_plus, "+ one\n+ two\n");
LET(want_ul_plus, "<ul>\n<li>one</li>\n<li>two</li>\n</ul>\n");

// ── 用例 ──────────────────────────────────────────────
TEST("md/blockquote", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_blockquote), want_blockquote));
    TRUE));
TEST("md/code_fence_lang", FUN(() ,
    (ASSERT_EQ(RENDER_MD(src_code_fence_lang), want_code_fence_lang));
    TRUE));
