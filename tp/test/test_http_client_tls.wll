// tp/test/test_http_client_tls.wll —— 出站 HTTPS 客户端的脱网测试（卡 S5-1）
//
// ⚠ 本文件由 tp/test/gen_test_http_client_tls.py 生成 —— 请勿手改。
//
// 被测：tp/lib/http_client_tls.wll
//   HTTP_BUILD_REQUEST / HTTP_PARSE_RESPONSE（纯函数，逐字节）
//   HTTP_REQUEST / HTTPS_POST_JSON / CHAT_COMPLETION（用注入的假传输跑全链路）
// 基准：tp/test/fixtures/http_client_tls_baseline.json
//   · 手写期望值 + 出处；生成期对 Python http.client 做过交叉校验
//   · 刻意偏离 Python 的三处登记在该 JSON 的 meta.divergences
//
// ⚠ **本文件不碰 TLS**：不带 --ext 也能全绿（CI 没有 TLS 扩展）。
//   真正的 TLS 往返只在本机探针 tp/probe/probe_s5_https.wll 里验。
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS"]);
IMPORT("wlwl:std.str", ["INDEX_OF", "CONTAINS_SUB", "COUNT", "JOIN", "CAT"]);
IMPORT("wlwl:std.encode", ["BYTE_LEN"]);
IMPORT("./../lib/http_client_tls.wll", ["HTTP_BUILD_REQUEST", "HTTP_PARSE_RESPONSE",
        "HTTP_REQUEST", "HTTPS_POST_JSON", "CHAT_COMPLETION"]);

// ── 测试缝：假传输（记下真实发出的请求文本，回放夹具里的响应）──────────
// ⚠ 闭包可以写外层的 LET MUT（坑 12），所以这里能记下 hc0_seen。
LET MUT(T0_seen, "");
LET MUT(T0_reply, "");
LET(T0_exchange, FUN((req), (SET(T0_seen, req); T0_reply)));

// ── ① 请求报文逐字节（纯函数 HTTP_BUILD_REQUEST）─────────────────
// post_json —— POST + Bearer + JSON：请求行 / Host / Authorization / Content-Type / Content-Length / Connection: close 的**顺序与字节**
//   出处：ai_assistance.py:50-54（_build_headers）+ :67-73（Request(data, headers, method)）
LET(hc0_build_post_json, HTTP_BUILD_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "host", "api.example.com"), "path", "/v1/chat/completions"), "headers", INDEX_SET(INDEX_SET(DICT(), "Authorization", "Bearer sk-test"), "Content-Type", "application/json")), "body", "{\"model\":\"gpt-3.5-turbo\",\"messages\":[]}")));
// post_utf8_body —— body 是中文 ⇒ Content-Length 必须是 **BYTE_LEN**（UTF-8 字节数），不是 LEN（码点数）
//   出处：卡 S5-1「逐字节」+ 标准库册 §11.3（BYTE_LEN 给字节数）
LET(hc0_build_post_utf8_body, HTTP_BUILD_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "host", "api.example.com"), "path", "/v1/chat/completions"), "headers", INDEX_SET(DICT(), "Content-Type", "application/json")), "body", "{\"text\":\"中文 body\"}")));
// get_no_body —— 无 body 的 GET ⇒ **不发** Content-Length（对齐 urllib 对 GET 的处理），仍发 Connection: close
//   出处：ai_assistance.py 只有 POST；GET 分支是本模块的通用层（HTTP_REQUEST）
LET(hc0_build_get_no_body, HTTP_BUILD_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "host", "api.example.com"), "path", "/v1/models"), "headers", DICT())));
// host_port_8443 —— 非 443 端口 ⇒ Host 头**带端口**（RFC 7230 §5.4）
//   出处：RFC 7230 §5.4（Host = uri-host [":" port]）
LET(hc0_build_host_port_8443, HTTP_BUILD_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "host", "api.example.com"), "port", 8443), "path", "/v1/chat/completions"), "headers", DICT()), "body", "{}")));
// post_empty_body —— POST + 空 body ⇒ 仍要发 `Content-Length: 0`（POST 有 body 语义）
//   出处：RFC 7230 §3.3.2（无 body 的 POST 要显式 0）
LET(hc0_build_post_empty_body, HTTP_BUILD_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "host", "api.example.com"), "path", "/v1/chat/completions"), "headers", DICT()), "body", "")));
// header_injection —— 头值里夹 CRLF ⇒ 必须压成一行（否则凭空多一行头 = 头注入）
//   出处：安全守卫（本模块 HC_ONELINE）；卡 S5-1「手写 HTTP/1.1」的必然要求
LET(hc0_build_header_injection, HTTP_BUILD_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "host", "api.example.com"), "path", "/v1/chat/completions"), "headers", INDEX_SET(DICT(), "X-Evil", "a\r\nX-Injected: 1")), "body", "")));
// dup_host_and_length —— 调用方自带 Host / Content-Length ⇒ 一律**丢弃**（报文里只允许有一份，且由本模块算）
//   出处：反向守卫：两个互相矛盾的 Content-Length 会让服务端读到错的位置
LET(hc0_build_dup_host_and_length, HTTP_BUILD_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "host", "api.example.com"), "path", "/v1/chat/completions"), "headers", INDEX_SET(INDEX_SET(DICT(), "Host", "evil.example"), "Content-Length", "9999")), "body", "abc")));
// path_normalized —— path 不以 "/" 开头 ⇒ 补一个（避免拼出 "POST v1/x HTTP/1.1"）
//   出处：RFC 7230 §5.3.1（origin-form = absolute-path）
LET(hc0_build_path_normalized, HTTP_BUILD_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "host", "api.example.com"), "path", "v1/models")));

TEST("build/post_json", FUN(() ,
    (ASSERT_EQ(hc0_build_post_json, "POST /v1/chat/completions HTTP/1.1\r\nHost: api.example.com\r\nAuthorization: Bearer sk-test\r\nContent-Type: application/json\r\nContent-Length: 39\r\nConnection: close\r\n\r\n{\"model\":\"gpt-3.5-turbo\",\"messages\":[]}"));
    TRUE));
TEST("build/post_utf8_body", FUN(() ,
    (ASSERT_EQ(hc0_build_post_utf8_body, "POST /v1/chat/completions HTTP/1.1\r\nHost: api.example.com\r\nContent-Type: application/json\r\nContent-Length: 22\r\nConnection: close\r\n\r\n{\"text\":\"中文 body\"}"));
    TRUE));
TEST("build/get_no_body", FUN(() ,
    (ASSERT_EQ(hc0_build_get_no_body, "GET /v1/models HTTP/1.1\r\nHost: api.example.com\r\nConnection: close\r\n\r\n"));
    TRUE));
TEST("build/host_port_8443", FUN(() ,
    (ASSERT_EQ(hc0_build_host_port_8443, "POST /v1/chat/completions HTTP/1.1\r\nHost: api.example.com:8443\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}"));
    TRUE));
TEST("build/post_empty_body", FUN(() ,
    (ASSERT_EQ(hc0_build_post_empty_body, "POST /v1/chat/completions HTTP/1.1\r\nHost: api.example.com\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"));
    TRUE));
TEST("build/header_injection", FUN(() ,
    (ASSERT_EQ(hc0_build_header_injection, "POST /v1/chat/completions HTTP/1.1\r\nHost: api.example.com\r\nX-Evil: a X-Injected: 1\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"));
    TRUE));
TEST("build/dup_host_and_length", FUN(() ,
    (ASSERT_EQ(hc0_build_dup_host_and_length, "POST /v1/chat/completions HTTP/1.1\r\nHost: api.example.com\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc"));
    TRUE));
TEST("build/path_normalized", FUN(() ,
    (ASSERT_EQ(hc0_build_path_normalized, "GET /v1/models HTTP/1.1\r\nHost: api.example.com\r\nConnection: close\r\n\r\n"));
    TRUE));

// ── 反向守卫：Content-Length 只许有一份；头注入不得多出一行 ──────────
TEST("guard/single_content_length", FUN(() ,
    (ASSERT_EQ(COUNT(hc0_build_dup_host_and_length, "Content-Length"), 1));
    TRUE));
TEST("guard/no_injected_header_line", FUN(() ,
    // 5 行头 + 1 个空行 = 6 个 CRLF；注入成功会变 7 个
    (ASSERT_EQ(COUNT(hc0_build_header_injection, "\r\n"), 6));
    TRUE));
TEST("guard/host_not_overridden", FUN(() ,
    (ASSERT_EQ(COUNT(hc0_build_dup_host_and_length, "evil.example"), 0));
    TRUE));

// ── 反向守卫：中文 body 的 Content-Length 必须按**字节**算 ───────────
// 若夹具里的 body 换成纯 ASCII，这条会红 —— 它守着「这条断言还有区分力」。
LET(hc0_utf8_body, "{\"text\":\"中文 body\"}");
TEST("guard/content_length_is_bytes_not_codepoints", FUN(() ,
    (ASSERT(!=(BYTE_LEN(hc0_utf8_body), LEN(hc0_utf8_body)),
            "fixture body must contain multi-byte chars, else BYTE_LEN/LEN are indistinguishable"));
    TRUE));

// ── ② 响应解析（纯函数 HTTP_PARSE_RESPONSE）──────────────────────
// ok_json —— 200 + Content-Length 正确 ⇒ ok，头名小写，body 逐字节
//   出处：卡 S5-1「响应解析：状态行 + 头 + body」
LET(hc0_parse_ok_json, HTTP_PARSE_RESPONSE("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 7\r\n\r\n{\"a\":1}"));
// headers_mixed_case —— 头名大小写混写 ⇒ 查表一律按小写（HTTP 头名不区分大小写）
//   出处：RFC 7230 §3.2（field-name 大小写不敏感）
LET(hc0_parse_headers_mixed_case, HTTP_PARSE_RESPONSE("HTTP/1.1 200 OK\r\nCONTENT-LENGTH: 2\r\nContent-TYPE: Application/JSON\r\nX-Trace-Id: abc\r\n\r\n{}"));
// no_body —— 204 无 Content-Length、空行后无字节 ⇒ body 是空串
//   出处：RFC 7230 §3.3（204 无 body）
LET(hc0_parse_no_body, HTTP_PARSE_RESPONSE("HTTP/1.1 204 No Content\r\nDate: Mon, 02 Nov 2026 00:00:00 GMT\r\n\r\n"));
// cl_smaller_than_actual —— **反向守卫**：实收 body 多于 Content-Length ⇒ 不得截断，body 给全部字节 + 记差额
//   出处：卡 S5-1 反向守卫「响应体超过 Content-Length ⇒ 不得截断读取」
LET(hc0_parse_cl_smaller_than_actual, HTTP_PARSE_RESPONSE("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello world"));
// cl_larger_truncated —— 实收 body 少于 Content-Length ⇒ ok:FALSE（读不全就是错，不交付半截 body）
//   出处：反向守卫（本模块取舍 ③）
LET(hc0_parse_cl_larger_truncated, HTTP_PARSE_RESPONSE("HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\nhello"));
// status_401 —— 4xx：解析层**仍判成形**（ok:TRUE），成败由 HC_VERDICT 定 —— 两件事分开测
//   出处：卡 S5-1 反向守卫「4xx/5xx 必须 ERR」（落在 HTTP_REQUEST 层）
LET(hc0_parse_status_401, HTTP_PARSE_RESPONSE("HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\nContent-Length: 19\r\n\r\n{\"error\":\"bad key\"}"));
// status_500 —— 5xx：同上（解析成形，成败在策略层）
//   出处：卡 S5-1 反向守卫「4xx/5xx 必须 ERR」
LET(hc0_parse_status_500, HTTP_PARSE_RESPONSE("HTTP/1.1 500 Internal Server Error\r\nContent-Length: 16\r\n\r\n{\"error\":\"boom\"}"));
// dup_headers —— 同名头出现两次 ⇒ 按出现顺序用 ", " 合并（RFC 7230 §3.2.2）
//   出处：RFC 7230 §3.2.2（recipient MAY combine field-values with ", "）
LET(hc0_parse_dup_headers, HTTP_PARSE_RESPONSE("HTTP/1.1 200 OK\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\nContent-Length: 0\r\n\r\n"));
// status_without_reason —— 状态行没有 reason 短语 ⇒ reason 是空串（不得报错）
//   出处：RFC 7230 §3.1.2（reason-phrase 可以为空）
LET(hc0_parse_status_without_reason, HTTP_PARSE_RESPONSE("HTTP/1.1 204\r\n\r\n"));
// blank_lines_in_body —— body 里含 CRLFCRLF ⇒ 头块仍切在**第一个** CRLFCRLF（不能被 body 里的空行骗到）
//   出处：RFC 7230 §3（头块以**第一个**空行结束）
LET(hc0_parse_blank_lines_in_body, HTTP_PARSE_RESPONSE("HTTP/1.1 200 OK\r\nContent-Length: 14\r\n\r\n{\"t\":\"a\r\n\r\nb\"}"));
// no_terminator —— 没有 CRLFCRLF ⇒ ok:FALSE（不得把整条报文当 body）
//   出处：反向守卫（本模块取舍：只认 CRLFCRLF）
LET(hc0_parse_no_terminator, HTTP_PARSE_RESPONSE("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n"));
// bad_status_code —— 状态码不是整数 ⇒ ok:FALSE
//   出处：RFC 7230 §3.1.2（status-code = 3DIGIT）
LET(hc0_parse_bad_status_code, HTTP_PARSE_RESPONSE("HTTP/1.1 ABC OK\r\nContent-Length: 0\r\n\r\n"));
// bad_protocol —— 不是 HTTP/ 开头 ⇒ ok:FALSE
//   出处：RFC 7230 §2.6（HTTP-version）
LET(hc0_parse_bad_protocol, HTTP_PARSE_RESPONSE("FTP/1.1 200 OK\r\n\r\n"));
// chunked —— Transfer-Encoding: chunked ⇒ ok:FALSE（不实现分块解码，明确失败）
//   出处：本模块取舍 ④（Python 的 http.client 会解码 —— 已登记差异）
LET(hc0_parse_chunked, HTTP_PARSE_RESPONSE("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\n{}\r\n0\r\n\r\n"));
// bad_content_length —— Content-Length 不是整数 ⇒ ok:FALSE（fail closed，不猜长度）
//   出处：RFC 7230 §3.3.2（Content-Length = 1*DIGIT）
LET(hc0_parse_bad_content_length, HTTP_PARSE_RESPONSE("HTTP/1.1 200 OK\r\nContent-Length: abc\r\n\r\nx"));


// ok_json
TEST("parse/ok_json/ok", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_parse_ok_json, "ok", "?"), TRUE));
    TRUE));
TEST("parse/ok_json/status", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_parse_ok_json, "status", -999), 200));
    TRUE));
TEST("parse/ok_json/reason", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_parse_ok_json, "reason", "?"), "OK"));
    TRUE));
TEST("parse/ok_json/header_order", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(AT_K(hc0_parse_ok_json, "headers", DICT())), "|"), "content-type|content-length"));
    TRUE));
TEST("parse/ok_json/header/content-type", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(hc0_parse_ok_json, "headers", DICT()), "content-type", "<missing>"), "application/json"));
    TRUE));
TEST("parse/ok_json/header/content-length", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(hc0_parse_ok_json, "headers", DICT()), "content-length", "<missing>"), "7"));
    TRUE));
TEST("parse/ok_json/body", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_parse_ok_json, "body", "<missing>"), "{\"a\":1}"));
    TRUE));
TEST("parse/ok_json/length_mismatch", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_parse_ok_json, "length_mismatch", "?"), FALSE));
    TRUE));
TEST("parse/ok_json/extra_bytes", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_parse_ok_json, "extra_bytes", -999), 0));
    TRUE));

