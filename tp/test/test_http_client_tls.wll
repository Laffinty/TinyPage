// ── ④ CHAT_COMPLETION（取 choices[0].message.content）────────────
// ok —— 正常：取 choices[0].message.content（含中文）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 65\r\n\r\n{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"你好\"}}]}");
LET(hc0_chat_ok, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));
LET(hc0_chatwire_ok, T0_seen);
// custom_model_temperature —— model / temperature 透传到请求体（键序是 STRINGIFY 的**字典序**）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 65\r\n\r\n{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"你好\"}}]}");
LET(hc0_chat_custom_model_temperature, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "model", "deepseek-chat"), "temperature", 0.3), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));
LET(hc0_chatwire_custom_model_temperature, T0_seen);
// no_choices —— 响应里没有 choices ⇒ ok:FALSE（Python 这里抛 AIAssistanceError）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 10\r\n\r\n{\"id\":\"x\"}");
LET(hc0_chat_no_choices, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));
// empty_choices —— choices 是空数组 ⇒ ok:FALSE（等价 Python 的 `if not choices`）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 14\r\n\r\n{\"choices\":[]}");
LET(hc0_chat_empty_choices, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));
// missing_message —— choices[0] 没有 message ⇒ ok:FALSE
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 25\r\n\r\n{\"choices\":[{\"index\":0}]}");
LET(hc0_chat_missing_message, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));
// missing_content —— message 里没有 content ⇒ ok:FALSE（不得静默返回空串）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 46\r\n\r\n{\"choices\":[{\"message\":{\"role\":\"assistant\"}}]}");
LET(hc0_chat_missing_content, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));
// not_json —— body 不是 JSON ⇒ ok:FALSE（**不得**让 PARSE 的 E0070 中止整个运行）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 8\r\n\r\nnot json");
LET(hc0_chat_not_json, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));
// json_array —— body 是 JSON 但不是对象 ⇒ ok:FALSE
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n[]");
LET(hc0_chat_json_array, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));
// status_401 —— 后端 401 ⇒ ok:FALSE，status 401（不进入 content 提取）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\nContent-Length: 19\r\n\r\n{\"error\":\"bad key\"}");
LET(hc0_chat_status_401, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));
// no_key —— 未配置 API key ⇒ ok:FALSE（同 Python 的 `raise AIAssistanceError("API key not configured")`）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 65\r\n\r\n{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"你好\"}}]}");
LET(hc0_chat_no_key, CHAT_COMPLETION(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "host", "api.example.com"), "messages", [INDEX_SET(INDEX_SET(DICT(), "role", "user"), "content", "hi")]), "exchange", T0_exchange)));


// ok
TEST("chat/ok/ok", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_chat_ok, "ok", "?"), TRUE));
    TRUE));
TEST("chat/ok/status", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_chat_ok, "status", -999), 200));
    TRUE));
TEST("chat/ok/content", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_chat_ok, "content", "<missing>"), "你好"));
    TRUE));
TEST("chat/ok/wire_body", FUN(() ,
    // 请求体 = 报文里第一个 CRLFCRLF 之后的全部
    (ASSERT_EQ(SUB(hc0_chatwire_ok, +(INDEX_OF(hc0_chatwire_ok, "\r\n\r\n"), 4)), "{\"messages\":[{\"content\":\"hi\",\"role\":\"user\"}],\"model\":\"gpt-3.5-turbo\",\"temperature\":0.7}"));
    TRUE));

// custom_model_temperature
TEST("chat/custom_model_temperature/ok", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_chat_custom_model_temperature, "ok", "?"), TRUE));
    TRUE));
TEST("chat/custom_model_temperature/status", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_chat_custom_model_temperature, "status", -999), 200));
    TRUE));
TEST("chat/custom_model_temperature/content", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_chat_custom_model_temperature, "content", "<missing>"), "你好"));
    TRUE));
TEST("chat/custom_model_temperature/wire_body", FUN(() ,
    // 请求体 = 报文里第一个 CRLFCRLF 之后的全部
    (ASSERT_EQ(SUB(hc0_chatwire_custom_model_temperature, +(INDEX_OF(hc0_chatwire_custom_model_temperature, "\r\n\r\n"), 4)), "{\"messages\":[{\"content\":\"hi\",\"role\":\"user\"}],\"model\":\"deepseek-chat\",\"temperature\":0.3}"));
    TRUE));

