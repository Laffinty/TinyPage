TEST("parse/headers_mixed_case/header/x-trace-id", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(hc0_parse_headers_mixed_case, "headers", DICT()), "x-trace-id", "<missing>"), "abc"));
    TRUE));
TEST("parse/headers_mixed_case/body", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_parse_headers_mixed_case, "body", "<missing>"), "{}"));
    TRUE));
TEST("parse/headers_mixed_case/length_mismatch", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_parse_headers_mixed_case, "length_mismatch", "?"), FALSE));
    TRUE));
TEST("parse/headers_mixed_case/extra_bytes", FUN(() ,
    (ASSERT_EQ(AT_K(hc0_parse_headers_mixed_case, "extra_bytes", -999), 0));
    TRUE));

