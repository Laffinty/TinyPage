// ── ⑤ 形状契约：三个出参的键序（卡 S5-1 写明了键集合）──────────────
TEST("shape/parse_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(hc0_parse_ok_json), "|"),
        "ok|status|reason|headers|body|length_mismatch|extra_bytes"));
    TRUE));
TEST("shape/success_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(hc0_req_post_ok), "|"), "ok|status|headers|body"));
    TRUE));
TEST("shape/failure_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(hc0_req_post_401), "|"), "ok|status|error"));
    TRUE));
TEST("shape/chat_success_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(hc0_chat_ok), "|"), "ok|status|content"));
    TRUE));

// ── 跑测试 + 自己把关退出码 ─────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_http_client_tls: ", LEN(records), " test(s) run");
LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"), " :: ", AT_K(rec, "error", ""))))));
PRINT("test_http_client_tls: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_http_client_tls: FAILED"); PANIC("http_client_tls tests failed")), NULL);
PRINT("test_http_client_tls: OK");