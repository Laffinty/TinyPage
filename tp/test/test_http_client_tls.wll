// ── ③ 请求链（HTTP_REQUEST / HTTPS_POST_JSON，假传输）─────────────
// post_ok —— 200 ⇒ ok:TRUE，status/body 原样透出；请求真的走了 exchange（且带 Bearer）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 7\r\n\r\n{\"a\":1}");
LET(hc0_req_post_ok, HTTPS_POST_JSON(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "body", "{\"x\":1}"), "exchange", T0_exchange)));
LET(hc0_reqwire_post_ok, T0_seen);
// post_401 —— **反向守卫**：401 ⇒ ok:FALSE，status 保留，error 里带服务端正文
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\nContent-Length: 19\r\n\r\n{\"error\":\"bad key\"}");
LET(hc0_req_post_401, HTTPS_POST_JSON(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "body", "{\"x\":1}"), "exchange", T0_exchange)));
LET(hc0_reqwire_post_401, T0_seen);
// post_500 —— **反向守卫**：500 ⇒ ok:FALSE
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 16\r\n\r\n{\"error\":\"boom\"}");
LET(hc0_req_post_500, HTTPS_POST_JSON(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "api_key", "sk-test"), "host", "api.example.com"), "body", "{\"x\":1}"), "exchange", T0_exchange)));
LET(hc0_reqwire_post_500, T0_seen);
// no_key —— **反向守卫**：未配置 API key ⇒ 明确报错，且**根本不碰传输**（exchange 不该被调）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 7\r\n\r\n{\"a\":1}");
LET(hc0_req_no_key, HTTPS_POST_JSON(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "host", "api.example.com"), "body", "{\"x\":1}"), "exchange", T0_exchange)));
LET(hc0_reqwire_no_key, T0_seen);
// get_no_key —— 通用层 GET 不要求 API key（key 是 HTTPS_POST_JSON / CHAT 的门）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 7\r\n\r\n{\"a\":1}");
LET(hc0_req_get_no_key, HTTP_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "host", "api.example.com"), "path", "/v1/models"), "exchange", T0_exchange)));
LET(hc0_reqwire_get_no_key, T0_seen);
// transport_error —— 传输失败 ⇒ ok:FALSE、status NULL、error 原样带出
SET(T0_seen, "");
SET(T0_reply, INDEX_SET(INDEX_SET(DICT(), "ok", FALSE), "error", "tls connect failed: boom"));
LET(hc0_req_transport_error, HTTP_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "host", "api.example.com"), "exchange", T0_exchange)));
LET(hc0_reqwire_transport_error, T0_seen);
// host_missing —— 缺 host ⇒ ok:FALSE（不得拼出 "POST  HTTP/1.1" 这种废报文）
SET(T0_seen, "");
SET(T0_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 7\r\n\r\n{\"a\":1}");
LET(hc0_req_host_missing, HTTP_REQUEST(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "exchange", T0_exchange)));
LET(hc0_reqwire_host_missing, T0_seen);
// garbage_response —— 对端回的不是 HTTP ⇒ ok:FALSE（不得当 body 交给上层）
SET(T0_seen, "");
SET(T0_reply, "<html>not http</html>");
LET(hc0_req_garbage_response, HTTP_REQUEST(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "host", "api.example.com"), "exchange", T0_exchange)));
LET(hc0_reqwire_garbage_response, T0_seen);


// post_ok
