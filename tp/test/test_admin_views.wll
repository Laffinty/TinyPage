// ── 反向守卫 ──────────────────────────────────────────────────
// ① 渲染结果**不得**残留占位符（safe_substitute 缺键时会原样留下 `$key`）
TEST("guard/dashboard_no_leftover_placeholder", FUN(() ,
    (ASSERT(!CONTAINS_SUB(_TAV_OUT_d_09, "\$total"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_d_09, "\$draft_count"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_d_09, "\$page_count"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_d_09, "\$rows"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_d_09, "\$nav_html"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_d_09, "\$csrf_token"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_d_09, "\$pages")));
    TRUE));

// ② 表单里的正文必须是**转义后**的（`<tag>` ⇒ `&lt;tag&gt;`），且占位符全被替换
TEST("guard/article_form_content_escaped", FUN(() ,
    (ASSERT(CONTAINS_SUB(_TAV_OUT_af_03, "&lt;tag&gt;"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_af_03, "<tag>"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_af_03, "\$content"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_af_03, "\$datalist")));
    TRUE));

// ③ locked **覆盖** error（views.py:279-282 的赋值顺序）
TEST("guard/login_locked_overrides_error", FUN(() ,
    (ASSERT_EQ(_TAV_OUT_lg_03, _TAV_OUT_lg_02);
     ASSERT(!= (_TAV_OUT_lg_03, _TAV_OUT_lg_01)));
    TRUE));

// ④ current_path 不匹配 ⇒ 不得有高亮（templates.py:52-53）
TEST("guard/nav_no_active_when_no_match", FUN(() ,
    (ASSERT(!CONTAINS_SUB(_TAV_OUT_nv_02, "nav-active"));
     ASSERT(!CONTAINS_SUB(_TAV_OUT_nv_02, "aria-current")));
    TRUE));

// ⑤ 未知 icon_name ⇒ 回落 "•"；标签原样（不转义，因为 Python 也不转）
TEST("guard/nav_icon_fallback_and_raw_label", FUN(() ,
    (ASSERT(CONTAINS_SUB(_TAV_OUT_nv_03, "•"));
     ASSERT(CONTAINS_SUB(_TAV_OUT_nv_03, "<未&转义>"));
     ASSERT(CONTAINS_SUB(_TAV_OUT_nv_03, "nav-active")));
    TRUE));

// ⑥ not-found 分支是**短路**的：不套模板（输出就是那一段 <p>）
TEST("guard/article_form_not_found_short_circuits", FUN(() ,
    (ASSERT_EQ(_TAV_OUT_af_05, "<p>Article not found</p>"));
    TRUE));

// ⑦ 空输入 ⇒ 空串（不得留下分隔符残渣）
TEST("guard/nav_empty_is_empty", FUN(() ,
    (ASSERT_EQ(_TAV_OUT_nv_04, ""));
    TRUE));

// ── 跑测试 ────────────────────────────────────────────────────
LET(_TAV_RECORDS, RUN_TESTS());
PRINT("test_admin_views: ", LEN(_TAV_RECORDS), " test(s) run");

LET MUT(_TAV_FAILED, 0);
FOR(_TAV_REC, _TAV_RECORDS,
    (IF(AT_K(_TAV_REC, "passed", FALSE),
        PRINT("  PASS ", AT_K(_TAV_REC, "name", "?")),
        (SET(_TAV_FAILED, +(_TAV_FAILED, 1));
         PRINT("  FAIL ", AT_K(_TAV_REC, "name", "?"))))));
PRINT("test_admin_views: failed=", _TAV_FAILED);
IF(>(_TAV_FAILED, 0), (PRINT_ERR("test_admin_views: FAILED"); PANIC("admin views tests failed")), NULL);
PRINT("test_admin_views: OK");