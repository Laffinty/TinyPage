LET(_TAV_WANT_af_00, "<div class=\"admin-wrapper\">\n  <h1>新建文章</h1>\n  <div class=\"editor-grid\">\n    <div class=\"editor-form\">\n      <form method=\"post\" action=\"/create\" id=\"article-form\">\n        <input type=\"hidden\" name=\"csrf_token\" value=\"tok-fixed-0123456789\">\n        \n        <div class=\"form-group\">\n          <input name=\"title\" value=\"\" placeholder=\"文章标题\" required maxlength=\"200\">\n        </div>\n        <div class=\"form-group\">\n          <input name=\"date\" value=\"2026-01-02 03:04\" required pattern=\"\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}\">\n        </div>\n        <div class=\"form-group\">\n          <input name=\"category\" list=\"category-list\" value=\"\" placeholder=\"分类\">\n          <datalist id=\"category-list\"><option value=\"&lt;cat&gt;\">\n<option value=\"tech\">\n<option value=\"生活\">\n<option value=\"空白\"></datalist>\n        </div>\n        <div class=\"form-group\">\n          <input name=\"tags\" value=\"\" placeholder=\"标签，用逗号分隔\">\n        </div>\n        <div class=\"form-group\">\n          <select name=\"status\">\n            <option value=\"published\" selected>发布</option>\n            <option value=\"draft\">草稿</option>\n          </select>\n        </div>\n        \n        <div id=\"drop-zone\" onclick=\"document.getElementById('file-input').click()\" ondragover=\"event.preventDefault();this.classList.add('dragover')\" ondragleave=\"this.classList.remove('dragover')\" ondrop=\"handleDrop(event)\">\n          <span class=\"drop-icon\">📎</span>\n          <span>拖拽图片到此处上传，或点击选择文件</span>\n          <input type=\"file\" id=\"file-input\" accept=\"image/*\" style=\"display:none\" onchange=\"handleFileSelect(event)\">\n        </div>\n        <div class=\"form-group\">\n          <textarea name=\"content\" placeholder=\"支持 Markdown：# 标题、**粗体**、*斜体*、`代码`、[链接](url)、```代码块```\" required maxlength=\"50000\" hx-trigger=\"keyup changed delay:500ms\" hx-post=\"/preview\" hx-target=\"#live-preview\" hx-inclu