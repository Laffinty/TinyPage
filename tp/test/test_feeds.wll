// ── ROBOTS：用例（robots.txt 无独立函数 ⇒ 基准是真跑 generate_static_pages）
LET(got_robots_empty_url, ROBOTS(INDEX_SET(DICT(), "site_url", "")));
LET(want_robots_empty_url, "User-agent: *\nAllow: /\nSitemap: /sitemap.xml\n");
// ⚠ robots/empty_url：F3：不回落 localhost ⇒ `Sitemap: /sitemap.xml`
TEST("robots/empty_url", FUN(() ,
    (ASSERT_EQ(got_robots_empty_url, want_robots_empty_url));
    TRUE));

LET(got_robots_trailing_slash, ROBOTS(INDEX_SET(DICT(), "site_url", "https://ex.com/")));
LET(want_robots_trailing_slash, "User-agent: *\nAllow: /\nSitemap: https://ex.com//sitemap.xml\n");
// ⚠ robots/trailing_slash：F3：**没有** rstrip ⇒ `//sitemap.xml`（证明这里不是 rss/sitemap 的口径）
TEST("robots/trailing_slash", FUN(() ,
    (ASSERT_EQ(got_robots_trailing_slash, want_robots_trailing_slash));
    TRUE));

LET(got_robots_with_url, ROBOTS(INDEX_SET(DICT(), "site_url", "https://ex.com")));
LET(want_robots_with_url, "User-agent: *\nAllow: /\nSitemap: https://ex.com/sitemap.xml\n");
TEST("robots/with_url", FUN(() ,
    (ASSERT_EQ(got_robots_with_url, want_robots_with_url));
    TRUE));

// ── 反向守卫 ────────────────────────────────────────────────
// ① 每个 & 都必须是一个合法实体（XML 里不得出现裸 &）
//    做法：数 "&" 的总数，与 "&(amp|lt|gt|quot|#x27);" 的匹配数比。
//    ⚠ 不能用 RE_TEST（整串锚定，判不出"含子串"，见 README 陷阱 #36）
LET(_amp_all_, LEN(RE_FIND_ALL(RE("&"), got_rss_special_chars)));
LET(_amp_ent_, LEN(RE_FIND_ALL(RE("&(amp|lt|gt|quot|#x27);"), got_rss_special_chars)));
TEST("guard/rss_no_bare_amp", FUN(() ,
    (ASSERT(>(_amp_all_, 0)));
    (ASSERT_EQ(_amp_ent_, _amp_all_));
    TRUE));

// ② 25 篇输入只出 20 个 <item>（截断在 generate_rss 内部）
TEST("guard/rss_cap_is_20", FUN(() ,
    (ASSERT_EQ(LEN(ar_rss_cap20), 25));
    (ASSERT_EQ(LEN(RE_FIND_ALL(RE("<item>"), got_rss_cap20)), 20));
    TRUE));

// ③ sitemap 不得有 lastmod / changefreq（与现状一致）
TEST("guard/sitemap_no_lastmod_changefreq", FUN(() ,
    (ASSERT_EQ(LEN(RE_FIND_ALL(RE("<lastmod"), got_sitemap_all)), 0));
    (ASSERT_EQ(LEN(RE_FIND_ALL(RE("<changefreq"), got_sitemap_all)), 0));
    TRUE));

// ④ robots 的 Sitemap: 行**不回落** localhost（F3）
TEST("guard/robots_no_localhost_fallback", FUN(() ,
    (ASSERT_EQ(LEN(RE_FIND_ALL(RE("localhost:8080"), got_robots_empty_url)), 0));
    (ASSERT_EQ(LEN(RE_FIND_ALL(RE("Sitemap: /sitemap[.]xml"), got_robots_empty_url)), 1));
    TRUE));

// ⑤ 草稿的两层：raw 层在、filtered 层不在（F1）
//    ⚠ 字面量点用 [.]（README 陷阱 #26：RE 里 "\." 是字面反斜杠+点）
//    ⚠ raw 层的计数是 **2**（<link> 与 <guid> 各一次，都指向同一 URL）⇒ 判 >0，
//      别写成 ==1（写死具体次数会把「模板加了一条重复引用」也测成红的）。
TEST("guard/rss_draft_layer", FUN(() ,
    (ASSERT(>(LEN(RE_FIND_ALL(RE("draft[.]html"), got_rss_draft_raw)), 0)));
    (ASSERT_EQ(LEN(RE_FIND_ALL(RE("draft[.]html"), got_rss_draft_filtered)), 0));
    TRUE));

// ⑥ 钉死上游现状：sitemap 用的是未过滤的 articles ⇒ 草稿**在** sitemap 里
//    （卡片的「草稿不得出现在 sitemap」与 generator.py:736 冲突 —— 已登记为
//      差异项；这里按**真实实现**断言，改动上游时要先改这条）
TEST("guard/sitemap_draft_present_upstream", FUN(() ,
    (ASSERT_EQ(LEN(RE_FIND_ALL(RE("draft[.]html"), got_sitemap_draft_included)), 1));
    TRUE));

// ⑦ 三个导出函数收到 NULL 不得崩（AT_K(NULL, …) 是 E0030，先判 TYPE）
TEST("guard/null_opts_ok", FUN(() ,
    (ASSERT_EQ(TYPE(RSS(NULL)), "STRING"));
    (ASSERT_EQ(TYPE(SITEMAP(NULL)), "STRING"));
    (ASSERT_EQ(TYPE(ROBOTS(NULL)), "STRING"));
    TRUE));

// ── 跑测试 ──────────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_feeds: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_feeds: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_feeds: FAILED"); PANIC("feeds tests failed")), NULL);
PRINT("test_feeds: OK");