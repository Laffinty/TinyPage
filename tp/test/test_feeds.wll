// tp/test/test_feeds.wll —— 订阅源与站点文件的逐字节对照测试 + 反向守卫
//
// ⚠ 本文件由 tp/test/gen_test_feeds.py 生成 —— 请勿手改。
//
// 验收方式：每个用例都与**真 Python** 的结果逐字节对照。
// 基准：tp/test/fixtures/feeds_baseline.json
//   （由 tp/test/gen_feeds_baseline.py 用真 Python 生成；robots 段是真跑
//     generate_static_pages 读回 robots.txt，**不是复刻**。）
//
// ⚠ 分层：草稿过滤**不在** generate_rss 里，在调用方 generator.py:730
//   ⇒ rss/draft_raw（原样）与 rss/draft_filtered（调用方过滤后）两条都要对。
// ⚠ sitemap 用的是**未过滤**的 articles（generator.py:736）⇒ 草稿在 sitemap 里，
//   这是上游现状，不是本实现的偏差（见 guard/sitemap_draft_present_upstream）。
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件末尾自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS"]);
IMPORT("wlwl:std.regex", ["RE", "RE_FIND_ALL"]);
IMPORT("./../lib/feeds.wll", ["RSS", "SITEMAP", "ROBOTS"]);

// ── 工具：把基准的 6 个字段包成 ArticleMeta 的 DICT ────────────────
//   date_obj："" ⇒ NULL；否则 DICT{"iso": <datetime.isoformat()>}
//   （iso_date 只用到 isoformat()，故与 Python 逐字节等价；见 lib/feeds.wll）
LET(_ART, FUN((t, d, s, st, f, iso), (
      LET MUT(a, DICT());
      SET(a, INDEX_SET(a, "title", t));
      SET(a, INDEX_SET(a, "date", d));
      SET(a, INDEX_SET(a, "slug", ""));
      SET(a, INDEX_SET(a, "tags", ""));
      SET(a, INDEX_SET(a, "summary", s));
      SET(a, INDEX_SET(a, "category", ""));
      SET(a, INDEX_SET(a, "status", st));
      SET(a, INDEX_SET(a, "file", f));
      SET(a, INDEX_SET(a, "date_obj", IF(==(iso, ""), NULL, INDEX_SET(DICT(), "iso", iso))));
      a)));

