// ── SITEMAP：用例 ───────────────────────────────────────────
LET MUT(o_sitemap_all, DICT());
SET(o_sitemap_all, INDEX_SET(o_sitemap_all, "articles", ar_sitemap_all));
SET(o_sitemap_all, INDEX_SET(o_sitemap_all, "standalones", st_sitemap_all));
SET(o_sitemap_all, INDEX_SET(o_sitemap_all, "categories", ct_sitemap_all));
SET(o_sitemap_all, INDEX_SET(o_sitemap_all, "config", cfg_sitemap_all));
LET(got_sitemap_all, SITEMAP(o_sitemap_all));
TEST("sitemap/all", FUN(() ,
    (ASSERT_EQ(got_sitemap_all, want_sitemap_all));
    TRUE));

