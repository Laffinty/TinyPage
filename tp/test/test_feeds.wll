// ── RSS：用例 ────────────────────────────────────────────────
LET MUT(o_rss_basic, DICT());
SET(o_rss_basic, INDEX_SET(o_rss_basic, "articles", ar_rss_basic));
SET(o_rss_basic, INDEX_SET(o_rss_basic, "config", cfg_rss_basic));
LET(got_rss_basic, RSS(o_rss_basic));
TEST("rss/basic", FUN(() ,
    (ASSERT_EQ(got_rss_basic, want_rss_basic));
    TRUE));

LET MUT(o_rss_cap20, DICT());
SET(o_rss_cap20, INDEX_SET(o_rss_cap20, "articles", ar_rss_cap20));
SET(o_rss_cap20, INDEX_SET(o_rss_cap20, "config", cfg_rss_cap20));
LET(got_rss_cap20, RSS(o_rss_cap20));
// ⚠ rss/cap20：25 篇 ⇒ generate_rss 内部 articles[:20] 截断到 20 条
TEST("rss/cap20", FUN(() ,
    (ASSERT_EQ(got_rss_cap20, want_rss_cap20));
    TRUE));

LET MUT(o_rss_date_obj, DICT());
SET(o_rss_date_obj, INDEX_SET(o_rss_date_obj, "articles", ar_rss_date_obj));
SET(o_rss_date_obj, INDEX_SET(o_rss_date_obj, "config", cfg_rss_date_obj));
LET(got_rss_date_obj, RSS(o_rss_date_obj));
// ⚠ rss/date_obj：date_obj 存在 ⇒ 用 datetime.isoformat()，忽略 date
TEST("rss/date_obj", FUN(() ,
    (ASSERT_EQ(got_rss_date_obj, want_rss_date_obj));
    TRUE));

LET MUT(o_rss_date_space, DICT());
SET(o_rss_date_space, INDEX_SET(o_rss_date_space, "articles", ar_rss_date_space));
SET(o_rss_date_space, INDEX_SET(o_rss_date_space, "config", cfg_rss_date_space));
LET(got_rss_date_space, RSS(o_rss_date_space));
// ⚠ rss/date_space：iso_date：date 含空格 ⇒ 全部空格替换成 T（str.replace）
TEST("rss/date_space", FUN(() ,
    (ASSERT_EQ(got_rss_date_space, want_rss_date_space));
    TRUE));

LET MUT(o_rss_default_config, DICT());
SET(o_rss_default_config, INDEX_SET(o_rss_default_config, "articles", ar_rss_default_config));
SET(o_rss_default_config, INDEX_SET(o_rss_default_config, "config", cfg_rss_default_config));
LET(got_rss_default_config, RSS(o_rss_default_config));
// ⚠ rss/default_config：空 config ⇒ 取 Config() 的默认值（site_title/site_description/lang）
TEST("rss/default_config", FUN(() ,
    (ASSERT_EQ(got_rss_default_config, want_rss_default_config));
    TRUE));

LET MUT(o_rss_draft_filtered, DICT());
SET(o_rss_draft_filtered, INDEX_SET(o_rss_draft_filtered, "articles", ar_rss_draft_filtered));
SET(o_rss_draft_filtered, INDEX_SET(o_rss_draft_filtered, "config", cfg_rss_draft_filtered));
LET(got_rss_draft_filtered, RSS(o_rss_draft_filtered));
// ⚠ rss/draft_filtered：F1：这是**调用方** generator.py:730 过滤后的输入 ⇒ 草稿不在输出里
TEST("rss/draft_filtered", FUN(() ,
    (ASSERT_EQ(got_rss_draft_filtered, want_rss_draft_filtered));
    TRUE));

LET MUT(o_rss_draft_raw, DICT());
SET(o_rss_draft_raw, INDEX_SET(o_rss_draft_raw, "articles", ar_rss_draft_raw));
SET(o_rss_draft_raw, INDEX_SET(o_rss_draft_raw, "config", cfg_rss_draft_raw));
LET(got_rss_draft_raw, RSS(o_rss_draft_raw));
// ⚠ rss/draft_raw：F1：原样喂进去 ⇒ generate_rss 不过滤，草稿在输出里（与 Python 一致）
TEST("rss/draft_raw", FUN(() ,
    (ASSERT_EQ(got_rss_draft_raw, want_rss_draft_raw));
    TRUE));

LET MUT(o_rss_empty, DICT());
SET(o_rss_empty, INDEX_SET(o_rss_empty, "articles", ar_rss_empty));
SET(o_rss_empty, INDEX_SET(o_rss_empty, "config", cfg_rss_empty));
LET(got_rss_empty, RSS(o_rss_empty));
// ⚠ rss/empty：空列表 ⇒ items 为空串；模板里 {items} 前那 4 个空格仍在（行尾空白，逐字节必须一致）
TEST("rss/empty", FUN(() ,
    (ASSERT_EQ(got_rss_empty, want_rss_empty));
    TRUE));

LET MUT(o_rss_empty_site_url, DICT());
SET(o_rss_empty_site_url, INDEX_SET(o_rss_empty_site_url, "articles", ar_rss_empty_site_url));
SET(o_rss_empty_site_url, INDEX_SET(o_rss_empty_site_url, "config", cfg_rss_empty_site_url));
LET(got_rss_empty_site_url, RSS(o_rss_empty_site_url));
// ⚠ rss/empty_site_url：generator.py:545 回落 "http://localhost:8080"（channel link 用回落值）
TEST("rss/empty_site_url", FUN(() ,
    (ASSERT_EQ(got_rss_empty_site_url, want_rss_empty_site_url));
    TRUE));

LET MUT(o_rss_special_chars, DICT());
SET(o_rss_special_chars, INDEX_SET(o_rss_special_chars, "articles", ar_rss_special_chars));
SET(o_rss_special_chars, INDEX_SET(o_rss_special_chars, "config", cfg_rss_special_chars));
LET(got_rss_special_chars, RSS(o_rss_special_chars));
// ⚠ rss/special_chars：标题/摘要/站点标题/描述都含 & < > " ' ⇒ 必须走 html.escape(quote=True)
TEST("rss/special_chars", FUN(() ,
    (ASSERT_EQ(got_rss_special_chars, want_rss_special_chars));
    TRUE));

LET MUT(o_rss_trailing_slash, DICT());
SET(o_rss_trailing_slash, INDEX_SET(o_rss_trailing_slash, "articles", ar_rss_trailing_slash));
SET(o_rss_trailing_slash, INDEX_SET(o_rss_trailing_slash, "config", cfg_rss_trailing_slash));
LET(got_rss_trailing_slash, RSS(o_rss_trailing_slash));
// ⚠ rss/trailing_slash：item link 走 rstrip("/")，但 channel <link> 用**原值**（带尾斜杠）
TEST("rss/trailing_slash", FUN(() ,
    (ASSERT_EQ(got_rss_trailing_slash, want_rss_trailing_slash));
    TRUE));

LET MUT(o_rss_upper_status, DICT());
SET(o_rss_upper_status, INDEX_SET(o_rss_upper_status, "articles", ar_rss_upper_status));
SET(o_rss_upper_status, INDEX_SET(o_rss_upper_status, "config", cfg_rss_upper_status));
LET(got_rss_upper_status, RSS(o_rss_upper_status));
// ⚠ rss/upper_status：status 原样传递；rss 不读 status（大小写不影响输出）
TEST("rss/upper_status", FUN(() ,
    (ASSERT_EQ(got_rss_upper_status, want_rss_upper_status));
    TRUE));

