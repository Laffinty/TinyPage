// ── 反向守卫（卡 S2-3 的要求）─────────────────────────────────
// ① 缺占位符 ⇒ 严格版**必须**返回 ERR，且**不得**静默留下 `$var`
LET(_G_TMPL_, "hi \$missing there");
LET(_G_MAP_, DICT());
LET(_G_PAY_, TAKE_ERR(SUBSTITUTE(_G_TMPL_, _G_MAP_)));
LET(_G_STR_, IF(IS_ERR(SUBSTITUTE(_G_TMPL_, _G_MAP_)), "<ERR>", SUBSTITUTE(_G_TMPL_, _G_MAP_)));
TEST("guard/strict_missing_returns_err", FUN(() ,
    (ASSERT_EQ(TYPE(_G_PAY_), "DICT"));
    (ASSERT_EQ(AT_K(_G_PAY_, "kind", ""), "KeyError"));
    (ASSERT_EQ(AT_K(_G_PAY_, "key", ""), "missing"));
    TRUE));
TEST("guard/strict_missing_not_silently_kept", FUN(() ,
    (ASSERT(!= (_G_STR_, _G_TMPL_)));
    TRUE));

// ② 宽容版对**同一个**输入必须原样保留（与严格版分叉的证据）
TEST("guard/safe_missing_keeps_placeholder", FUN(() ,
    (ASSERT_EQ(SAFE_SUBSTITUTE(_G_TMPL_, _G_MAP_), _G_TMPL_));
    TRUE));

// ③ 代入值里的 `$` **不得**被二次扫描（Python 侧是一次性扫描）
LET(_G_DOLLAR_, INDEX_SET(DICT(), "a", "\$b \${c}"));
TEST("guard/no_rescan_of_values", FUN(() ,
    (ASSERT_EQ(SUBSTITUTE("\$a!", _G_DOLLAR_), "\$b \${c}!"));
    TRUE));

// ④ 骨架产物的**首尾**逐字节判定（首行无前导空白、末行 `</html>` 后无换行）
TEST("guard/skeleton_edge_bytes", FUN(() ,
    (ASSERT_EQ(SUB(out_r00, 0, 15), "<!DOCTYPE html>"));
    (ASSERT_EQ(SUB(out_r00, -(LEN(out_r00), 7)), "</html>"));
    TRUE));

// ⑤ 渲染**不得**残留任何占位符（19 个 `$name` 必须全被替换）
TEST("guard/skeleton_no_leftover_placeholder", FUN(() ,
    (ASSERT(!CONTAINS(out_r04, "\$lang")));
    (ASSERT(!CONTAINS(out_r04, "\$site_title")));
    (ASSERT(!CONTAINS(out_r04, "\$nav_links")));
    (ASSERT(!CONTAINS(out_r04, "\$theme_toggle")));
    TRUE));

// ── 跑测试 ────────────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_template: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_template: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_template: FAILED"); PANIC("template tests failed")), NULL);
PRINT("test_template: OK");