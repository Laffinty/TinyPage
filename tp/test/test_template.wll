// ⚠ safe_s66：已知差异（值类型渲染）：Python 的 `str(None)` 是 "None"，WLWL 的 `STR(NULL)` 渲染成 "NULL" ⇒ 文本不同。根因：`str()` 的容器/空值渲染是**宿主语言**的口径，与 `string.Template` 的语义无关，WLWL 侧无法逐字复刻。
TEST("safe_substitute/s66", FUN(() ,
    (ASSERT(!iserr_safe_s66);
     ASSERT_EQ(out_safe_s66, want_safe_s66));
    TRUE));
// ⚠ safe_s67：已知差异（值类型渲染）：Python 的 `str(True)` 是 "True"，WLWL 的 `STR(TRUE)` 是 "TRUE"（布尔的字面量口径不同）。
TEST("safe_substitute/s67", FUN(() ,
    (ASSERT(!iserr_safe_s67);
     ASSERT_EQ(out_safe_s67, want_safe_s67));
    TRUE));
// ⚠ safe_s68：已知差异（值类型渲染）：Python 的 `str({"k": 1})` 是 "{'k': 1}"，WLWL 的 `STR(字典)` 是 "[k: 1]"（字典的渲染语法不同）。
TEST("safe_substitute/s68", FUN(() ,
    (ASSERT(!iserr_safe_s68);
     ASSERT_EQ(out_safe_s68, want_safe_s68));
    TRUE));
