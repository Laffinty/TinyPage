      "want": "标题 &amp; &lt;正文&gt;"
    },
    "mv_collapse_newlines": {
      "src": "a\n\n\nb",
      "src_type": "str",
      "want": "a b"
    },
    "mv_crlf": {
      "src": "a\r\nb",
      "src_type": "str",
      "want": "a b"
    },
    "mv_empty": {
      "src": "",
      "src_type": "str",
      "want": ""
    },
    "mv_html": {
      "src": "<b>&x</b>",
