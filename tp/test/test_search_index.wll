// opts 两个键都缺省 ⇒ 空数组（对齐 Python 的 [] / None）
TEST("search_index/empty_opts_dict", FUN(() ,
    (ASSERT_EQ(SEARCH_INDEX(DICT()), "[]"));
    TRUE));
// 显式 NULL（= Python 的 None）⇒ 同样空数组
TEST("search_index/null_lists", FUN(() ,
    (ASSERT_EQ(SEARCH_INDEX(INDEX_SET(INDEX_SET(DICT(), "articles", NULL), "standalones", NULL)), "[]"));
    TRUE));

// ── 结构化断言：先 JSON_VALIDATE 再 PARSE ─────────────────────
// ⚠ 顺序不可换：PARSE 失败直接 E0070 中止，无法捕获。
// ⚠ 非法时退回 [] ⇒ 变成一条「条数不符」的 FAIL，而不是中止整个运行。
LET(out_drafts_included, SEARCH_INDEX(opts_drafts_included));
LET(doc_drafts_included, IF(IS_ERR(JSON_VALIDATE(out_drafts_included)), [], PARSE(out_drafts_included)));
// drafts_included ⇒ 3 条记录
TEST("structure/drafts_included_record_count", FUN(() ,
    (ASSERT_EQ(LEN(doc_drafts_included), 3));
    TRUE));
TEST("structure/drafts_included_record_keys", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(AT(doc_drafts_included, 0, DICT()))), 6));
    TRUE));

LET(out_multi, SEARCH_INDEX(opts_multi));
LET(doc_multi, IF(IS_ERR(JSON_VALIDATE(out_multi)), [], PARSE(out_multi)));
// multi ⇒ 3 条记录
TEST("structure/multi_record_count", FUN(() ,
    (ASSERT_EQ(LEN(doc_multi), 3));
    TRUE));
TEST("structure/multi_record_keys", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(AT(doc_multi, 0, DICT()))), 6));
    TRUE));

LET(out_with_standalones, SEARCH_INDEX(opts_with_standalones));
LET(doc_with_standalones, IF(IS_ERR(JSON_VALIDATE(out_with_standalones)), [], PARSE(out_with_standalones)));
// with_standalones ⇒ 4 条记录
TEST("structure/with_standalones_record_count", FUN(() ,
    (ASSERT_EQ(LEN(doc_with_standalones), 4));
    TRUE));
TEST("structure/with_standalones_record_keys", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(AT(doc_with_standalones, 0, DICT()))), 6));
    TRUE));

// with_standalones 的第 3 条记录是 standalone（about.html）：
// 输入 date="2024-01-01 00:00"、tags="ignored, tags"、category="ignored"，
// 但产物必须是 "" / [] / ""（generator.py:617-624 硬编码）。
LET(sa0, AT(doc_with_standalones, 2, DICT()));
TEST("guard/standalone_fields_hardcoded", FUN(() ,
    (ASSERT_EQ(AT_K(sa0, "date", "?"), ""));
    (ASSERT_EQ(LEN(AT_K(sa0, "tags", [1])), 0));
    (ASSERT_EQ(AT_K(sa0, "category", "?"), ""));
    (ASSERT_EQ(AT_K(sa0, "url", "?"), "/standalone/about.html"));
    TRUE));

// ── 反向守卫（卡 S2-4 要求 ≥2 条）─────────────────────────────
// ① 产物必须是合法 JSON（空数组与含转义的两个极端都钉住）
TEST("guard/output_is_valid_json", FUN(() ,
    (ASSERT(!IS_ERR(JSON_VALIDATE(SEARCH_INDEX(opts_multi)))));
    (ASSERT(!IS_ERR(JSON_VALIDATE(SEARCH_INDEX(opts_escaping)))));
    (ASSERT(!IS_ERR(JSON_VALIDATE(SEARCH_INDEX(opts_with_standalones)))));
    (ASSERT(!IS_ERR(JSON_VALIDATE(SEARCH_INDEX(opts_drafts_included)))));
    (ASSERT(!IS_ERR(JSON_VALIDATE(SEARCH_INDEX(DICT())))));
    TRUE));

// ② 不得出现悬挂逗号（记录分隔符写错的典型症状）
TEST("guard/no_dangling_separator", FUN(() ,
    (ASSERT(!CONTAINS(SEARCH_INDEX(opts_multi), ",]")));
    (ASSERT(!CONTAINS(SEARCH_INDEX(opts_multi), ", }")));
    (ASSERT(CONTAINS(SEARCH_INDEX(opts_with_standalones), "[{")));
    TRUE));

// ③ 草稿**必须**出现在产物里：本模块不过滤草稿（见 wll 头部说明）。
//    ⚠ 这条是「将来的自己」的哨兵：谁在 SEARCH_INDEX 里顺手加个草稿过滤，
//      它就红 —— 因为那会让本模块与 generate_search_index 不再一一对应。
LET(out_draftpass, SEARCH_INDEX(opts_drafts_included));
TEST("guard/drafts_pass_through", FUN(() ,
    (ASSERT(CONTAINS(out_draftpass, "大写草稿标题-DRAFT-UPPER")));
    (ASSERT(CONTAINS(out_draftpass, "小写草稿标题-DRAFT-LOWER")));
    (ASSERT(CONTAINS(out_draftpass, "\"hidden\"")));
    TRUE));
TEST("guard/all_drafts_pass_through", FUN(() ,
    (ASSERT(CONTAINS(SEARCH_INDEX(opts_all_drafts), "大写草稿标题-DRAFT-UPPER-2")));
    (ASSERT(CONTAINS(SEARCH_INDEX(opts_all_drafts), "小写草稿标题-DRAFT-LOWER-2")));
    TRUE));

// ④ 正文（`content`）不得进索引：哨兵串与键名都不得出现
LET(out_extra_fields_ignored, SEARCH_INDEX(opts_extra_fields_ignored));
TEST("guard/content_marker_absent", FUN(() ,
    (ASSERT(!CONTAINS(out_extra_fields_ignored, "CONTENT-MUST-NOT-APPEAR-IN-INDEX")));
    TRUE));
TEST("guard/content_key_absent", FUN(() ,
    (ASSERT(!CONTAINS(out_extra_fields_ignored, "\"content\"")));
    TRUE));

// ⑤ 记录键恰好是 6 个索引字段（顺序由逐字节对照钉住，这里钉"不多不少"）
TEST("guard/record_keys_exact", FUN(() ,
    (ASSERT(CONTAINS(out_drafts_included, "\"title\": ")));
    (ASSERT(CONTAINS(out_drafts_included, "\"summary\": ")));
    (ASSERT(CONTAINS(out_drafts_included, "\"url\": ")));
    (ASSERT(CONTAINS(out_drafts_included, "\"date\": ")));
    (ASSERT(CONTAINS(out_drafts_included, "\"tags\": ")));
    (ASSERT(CONTAINS(out_drafts_included, "\"category\": ")));
    (ASSERT_EQ(LEN(KEYS(AT(doc_drafts_included, 0, DICT()))), 6));
    TRUE));

// ⑥ tag 必须按逗号切、各自 strip（不能把 "a , b" 当一个 tag）
TEST("guard/tags_split_and_trimmed", FUN(() ,
    (ASSERT(CONTAINS(SEARCH_INDEX(opts_tags_edges), "\"tags\": [\"a\", \"b\"]")));
    (ASSERT(!CONTAINS(SEARCH_INDEX(opts_tags_edges), "\" a , b \"")));
    TRUE));

// ── 跑测试 ────────────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_search_index: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_search_index: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_search_index: FAILED"); PANIC("search_index tests failed")), NULL);
PRINT("test_search_index: OK");