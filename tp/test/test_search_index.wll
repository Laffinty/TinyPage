// 基准：tp/test/fixtures/search_index_baseline.json
//   （由 tp/test/gen_search_index_baseline.py 用真 Python 生成）
//
// 对齐目标：tinypage/generator.py:599 generate_search_index
//   ⇒ WLWL 侧 SEARCH_INDEX(opts)
//
// ⚠ 草稿：**本模块不过滤**（= generate_search_index 的现状）。
//   排除在生产链路的调用方 cli.py:139 (list_articles(include_drafts=False)，
//   过滤点 content.py:187-189)；反向守卫 guard/drafts_pass_through 钉住这条。
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS"]);
// ⚠ PARSE 失败会产生 E0070 且**无法捕获**（中止整个运行）
//   ⇒ 只对「先过了 JSON_VALIDATE」的产物做 PARSE。
IMPORT("wlwl:std.json", ["JSON_VALIDATE", "PARSE"]);
IMPORT("./../lib/search_index.wll", ["SEARCH_INDEX"]);

