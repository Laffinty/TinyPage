    (ASSERT_EQ(TYPE(AT_K(T2_pipe_no_api_key, "status", NULL)), "NULL"));
    TRUE));
TEST("pipeline/no_api_key/error", FUN(() ,
    (ASSERT(CONTAINS_SUB(AT_K(T2_pipe_no_api_key, "error", ""), "not configured"),
            "no_api_key: error must mention 'not configured'"));
    TRUE));
// 反向守卫：未配置 / 禁用 / 空文本 ⇒ **根本不碰传输**
TEST("pipeline/no_api_key/transport_not_called", FUN(() ,
    (ASSERT_EQ(T2_wire_no_api_key, ""));
    TRUE));

