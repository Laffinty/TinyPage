// 反向守卫：停用词**永远**不能出现在标签里（两字词也被 `len > 2` 挡掉）
TEST("fallback/guard_no_stopwords", FUN(() ,
    (LET(t, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "the and of to in is are be been"), "max_tags", 5)));
     (ASSERT(==(LEN(t), 0), "stopword-only text must yield no tags"));
     TRUE)));

// ── ⑤ 是否构建 + 端点（IS_ENABLED / ENDPOINT_PARTS）────────────────
// both_set —— 两项都满足 ⇒ 构建
LET(T2_en_both_set, IS_ENABLED(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-x")));
// no_key —— enabled 但没 key ⇒ 不构建
LET(T2_en_no_key, IS_ENABLED(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "")));
// disabled —— 有 key 但没启用 ⇒ 不构建
LET(T2_en_disabled, IS_ENABLED(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", FALSE), "ai_api_key", "sk-x")));
// nothing_set —— 都没设 ⇒ 不构建（getattr 缺省 FALSE / ""）
LET(T2_en_nothing_set, IS_ENABLED(DICT()));

TEST("enabled/both_set", FUN(() ,
    (ASSERT_EQ(T2_en_both_set, TRUE));
    TRUE));
TEST("enabled/no_key", FUN(() ,
    (ASSERT_EQ(T2_en_no_key, FALSE));
    TRUE));
TEST("enabled/disabled", FUN(() ,
    (ASSERT_EQ(T2_en_disabled, FALSE));
    TRUE));
TEST("enabled/nothing_set", FUN(() ,
    (ASSERT_EQ(T2_en_nothing_set, FALSE));
    TRUE));

// ⚠ 一个坑：`ai_enabled` 只认布尔 TRUE（Python 认任意真值）—— 刻意语义，钉住
TEST("enabled/guard_truthy_int_is_false", FUN(() ,
    (ASSERT_EQ(IS_ENABLED(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", 1), "ai_api_key", "k")), FALSE));
    TRUE));

// openai_default —— 缺省 provider ⇒ OpenAI 端点
//   Python 拼出的 url：https://api.openai.com/v1/chat/completions
LET(T2_ep_openai_default, ENDPOINT_PARTS(INDEX_SET(INDEX_SET(DICT(), "provider", "openai"), "endpoint", "")));
// deepseek_default —— provider=deepseek ⇒ api.deepseek.com/v1
//   Python 拼出的 url：https://api.deepseek.com/v1/chat/completions
LET(T2_ep_deepseek_default, ENDPOINT_PARTS(INDEX_SET(INDEX_SET(DICT(), "provider", "deepseek"), "endpoint", "")));
// provider_case —— provider 先 `.lower()`（大小写不敏感）
//   Python 拼出的 url：https://api.deepseek.com/v1/chat/completions
LET(T2_ep_provider_case, ENDPOINT_PARTS(INDEX_SET(INDEX_SET(DICT(), "provider", "DeepSeek"), "endpoint", "")));
// explicit —— 显式端点 ⇒ host/path 从它拆
//   Python 拼出的 url：https://example.com/custom/v1/chat/completions
LET(T2_ep_explicit, ENDPOINT_PARTS(INDEX_SET(INDEX_SET(DICT(), "provider", "openai"), "endpoint", "https://example.com/custom/v1")));
// explicit_port —— 端点带端口 ⇒ Host/port 都要带
//   Python 拼出的 url：https://example.com:8443/v1/chat/completions
LET(T2_ep_explicit_port, ENDPOINT_PARTS(INDEX_SET(INDEX_SET(DICT(), "provider", "openai"), "endpoint", "https://example.com:8443/v1")));
// trailing_slash —— 端点以 / 结尾：Python 拼出 `//chat/completions`；我们先剥尾斜杠（**已登记偏离**）
//   Python 拼出的 url：https://example.com/v1//chat/completions
LET(T2_ep_trailing_slash, ENDPOINT_PARTS(INDEX_SET(INDEX_SET(DICT(), "provider", "openai"), "endpoint", "https://example.com/v1/")));
// no_path —— 端点没有路径 ⇒ 补一个斜杠再拼（Python 同样只有一个 /）
//   Python 拼出的 url：https://example.com/chat/completions
LET(T2_ep_no_path, ENDPOINT_PARTS(INDEX_SET(INDEX_SET(DICT(), "provider", "openai"), "endpoint", "https://example.com")));
// http_scheme —— 明文 http：Python 会发明文请求；我们**明确失败**（传输层是 TLS-only，**已登记偏离**）
//   Python 拼出的 url：http://example.com/v1/chat/completions
LET(T2_ep_http_scheme, ENDPOINT_PARTS(INDEX_SET(INDEX_SET(DICT(), "provider", "openai"), "endpoint", "http://example.com/v1")));
// no_scheme —— 没有 scheme：urllib 抛 `unknown url type`；我们明确失败
//   Python 拼出的 url：example.com/v1/chat/completions
LET(T2_ep_no_scheme, ENDPOINT_PARTS(INDEX_SET(INDEX_SET(DICT(), "provider", "openai"), "endpoint", "example.com/v1")));


TEST("endpoint/openai_default", FUN(() ,
    (ASSERT_EQ(AT_K(T2_ep_openai_default, "ok", "?"), TRUE));
    (ASSERT_EQ(AT_K(T2_ep_openai_default, "host", "?"), "api.openai.com"));
    (ASSERT_EQ(AT_K(T2_ep_openai_default, "port", -1), 443));
    (ASSERT_EQ(AT_K(T2_ep_openai_default, "path", "?"), "/v1/chat/completions"));
    TRUE));

