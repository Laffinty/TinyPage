// tags_ok
TEST("pipeline/tags_ok/ok", FUN(() ,
    (ASSERT_EQ(AT_K(T2_pipe_tags_ok, "ok", "?"), TRUE));
    TRUE));
TEST("pipeline/tags_ok/tags", FUN(() ,
    (ASSERT_EQ(JOIN(AT_K(T2_pipe_tags_ok, "tags", []), "|"), "python|tutorial"));
    TRUE));
TEST("pipeline/tags_ok/fallback", FUN(() ,
    (ASSERT_EQ(AT_K(T2_pipe_tags_ok, "fallback", "?"), FALSE));
    TRUE));
TEST("pipeline/tags_ok/transport_called", FUN(() ,
    (ASSERT(>(LEN(T2_wire_tags_ok), 0), "tags_ok: exchange must be called"));
    TRUE));
TEST("pipeline/tags_ok/wire_body", FUN(() ,
    // 请求体 = 报文里第一个 CRLFCRLF 之后的全部（逐字节对照 STRINGIFY 口径）
    (ASSERT_EQ(SUB(T2_wire_tags_ok, +(INDEX_OF(T2_wire_tags_ok, "\r\n\r\n"), 4)), "{\"messages\":[{\"content\":\"You are a content analyst. Suggest exactly 5 relevant tags for this article. Tags should be short (1-3 words), lowercase, and relevant to the main topics. Return ONLY a JSON array of tag strings, like [\\\"python\\\", \\\"web\\\", \\\"tutorial\\\"]. No explanations.\",\"role\":\"system\"},{\"content\":\"Suggest tags for:\\n\\npython web python\",\"role\":\"user\"}],\"model\":\"gpt-3.5-turbo\",\"temperature\":0.3}"));
    TRUE));
TEST("pipeline/tags_ok/wire_has_auth", FUN(() ,
    // 传输层（卡 S5-1）负责 Authorization；这里只确认它真的进了报文
    (ASSERT(CONTAINS_SUB(T2_wire_tags_ok, "Authorization: Bearer "),
            "tags_ok: bearer header must be present"));
    TRUE));

