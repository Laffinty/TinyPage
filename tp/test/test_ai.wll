     (ASSERT_EQ(AT_K(bad, "ok", "?"), FALSE));
     (ASSERT(CONTAINS_SUB(AT_K(bad, "error", ""), "unknown capability"),
             "unknown capability must be reported, not silently skipped"));
     TRUE)));

