TEST("build/translate_default", FUN(() ,
    (ASSERT_EQ(AT_K(T2_build_translate_default, "ok", "?"), TRUE));
    (ASSERT_EQ(AT_K(T2_build_translate_default, "capability", "?"), "translate"));
    (ASSERT_EQ(AT_K(T2_build_translate_default, "model", "?"), "gpt-3.5-turbo"));
