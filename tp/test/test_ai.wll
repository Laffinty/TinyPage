// ── ④ 词频降级（纯函数 FALLBACK_SUGGEST_TAGS）────────────────────
// english_repeat
//   按词频降序；同频按**首次出现**顺序（sorted 是稳定排序）
//   出处：ai_assistance.py:252-259
LET(T2_fb_english_repeat, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "python python web python web tutorial"), "max_tags", 5)));
// cjk_repeat
//   两字词**全被丢**：切词要求 {2,}，但计数前还有 `len(word) > 2` ⇒ 中文两字词取不到
//   出处：ai_assistance.py:252,255（两个门槛叠加）
LET(T2_fb_cjk_repeat, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "中文 文章 中文 文章 测试"), "max_tags", 5)));
// cjk_run_no_space
//   **没有空格**的中文是一个整串（Python 的 `{2,}` 是贪心连续匹配），不是分词
//   出处：ai_assistance.py:252
LET(T2_fb_cjk_run_no_space, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "中文文章测试"), "max_tags", 5)));
// stopwords_only
//   全是停用词 ⇒ []
//   出处：ai_assistance.py:245-250（停用词表）
LET(T2_fb_stopwords_only, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "the and of to in is are be been"), "max_tags", 5)));
// short_words
//   切词要求 {2,}，但**计数前**还要求 `len(word) > 2` ⇒ 两字符的词全被丢
//   出处：ai_assistance.py:255（`len(word) > 2`）
LET(T2_fb_short_words, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "ab cd ef gh"), "max_tags", 5)));
// ties
//   同频 ⇒ 取**先出现**的两个（稳定排序）
//   出处：ai_assistance.py:258-259
LET(T2_fb_ties, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "alpha beta gamma delta"), "max_tags", 2)));
// punctuation
//   `-` `_` `!` `.` 都不是词内字符 ⇒ 各切成两段
//   出处：ai_assistance.py:252
LET(T2_fb_punctuation, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "test-tag foo_bar hey! end."), "max_tags", 5)));
// numbers
//   数字不是词内字符 ⇒ "abc"/"def" 留下，纯数字段**不匹配**
//   出处：ai_assistance.py:252
LET(T2_fb_numbers, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "abc123 def456 7 89"), "max_tags", 5)));
// mixed_script_run
//   中英混排**在同一个字符类里** ⇒ "abc中文" 是**一个**词（与「先按脚本切」不同）
//   出处：ai_assistance.py:252
LET(T2_fb_mixed_script_run, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "abc中文 def"), "max_tags", 5)));
// uppercase_fold
//   先 `.lower()` 再切词 ⇒ 三次都落到 python
//   出处：ai_assistance.py:252（`text.lower()`）
LET(T2_fb_uppercase_fold, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "Python PYTHON python"), "max_tags", 5)));
// max_tags_zero
//   max_tags=0 ⇒ []
//   出处：ai_assistance.py:259（`[:0]`）
LET(T2_fb_max_tags_zero, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "python python web"), "max_tags", 0)));
// max_tags_one
//   只取最高频的一个
//   出处：ai_assistance.py:259
LET(T2_fb_max_tags_one, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "python web web"), "max_tags", 1)));
// empty_text
//   空文本 ⇒ []
//   出处：ai_assistance.py:242-243
LET(T2_fb_empty_text, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", ""), "max_tags", 5)));
// ordering_by_count
//   ccc=3 在前，bbb=2 次之，aaa=1 最后（不是字典序）
//   出处：ai_assistance.py:258
LET(T2_fb_ordering_by_count, FALLBACK_SUGGEST_TAGS(INDEX_SET(INDEX_SET(DICT(), "text", "ccc bbb aaa ccc bbb ccc"), "max_tags", 3)));


