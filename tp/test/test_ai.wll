TEST("build/tags_default", FUN(() ,
    (ASSERT_EQ(AT_K(T2_build_tags_default, "ok", "?"), TRUE));
    (ASSERT_EQ(AT_K(T2_build_tags_default, "capability", "?"), "suggest_tags"));
    (ASSERT_EQ(AT_K(T2_build_tags_default, "model", "?"), "gpt-3.5-turbo"));
    (ASSERT_EQ(AT_K(T2_build_tags_default, "temperature", -1), 0.3));
    (ASSERT_EQ(AT_K(T2_build_tags_default, "skip", "?"), FALSE));
    (ASSERT_EQ(LEN(AT_K(T2_build_tags_default, "messages", [])), 2));
    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_tags_default, "messages", []), 0, DICT()), "role", "?"), "system"));
    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_tags_default, "messages", []), 0, DICT()), "content", "?"), "You are a content analyst. Suggest exactly 5 relevant tags for this article. Tags should be short (1-3 words), lowercase, and relevant to the main topics. Return ONLY a JSON array of tag strings, like [\"python\", \"web\", \"tutorial\"]. No explanations."));
    (ASSERT_EQ(JOIN(KEYS(AT(AT_K(T2_build_tags_default, "messages", []), 0, DICT())), "|"), "role|content"));
    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_tags_default, "messages", []), 1, DICT()), "role", "?"), "user"));
    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_tags_default, "messages", []), 1, DICT()), "content", "?"), "Suggest tags for:\n\nshort text"));
    (ASSERT_EQ(JOIN(KEYS(AT(AT_K(T2_build_tags_default, "messages", []), 1, DICT())), "|"), "role|content"));
    TRUE));

