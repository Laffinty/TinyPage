    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_complete_hint, "messages", []), 0, DICT()), "content", "?"), "You are a helpful writing assistant. Continue the user's text naturally and coherently. The user wants to focus on: tone: friendly"));
