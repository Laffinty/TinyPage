// ── ⑧ 反向守卫：后端 4xx 必须变成 JSON 错误（卡 S5-2 的核心守卫）────────
// 直接拿 pipeline 里那次 401 的**真实**失败结果去做出参 JSON
LET(T2_err_body, JSON_ENVELOPE(INDEX_SET(INDEX_SET(DICT(), "ok", AT_K(T2_pipe_complete_http_401, "ok", TRUE)), "error", AT_K(T2_pipe_complete_http_401, "error", ""))));
TEST("guard/401_envelope_is_json", FUN(() ,
    (ASSERT_EQ(SUB(T2_err_body, 0, 10), "{\"error\": "));
    (ASSERT(CONTAINS_SUB(T2_err_body, "HTTP 401"), "status must survive into the JSON error"));
    TRUE));

// ── ⑨ 形状契约（键集合固定，调用方可以安全地 AT_K）──────────────────
TEST("shape/build_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(T2_build_complete_basic), "|"),
        "ok|capability|model|temperature|messages|skip"));
    TRUE));
TEST("shape/extract_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(T2_extract_normal), "|"), "ok|status|content"));
    TRUE));
TEST("shape/failure_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(T2_pipe_no_api_key), "|"), "ok|status|error"));
    TRUE));
TEST("shape/tags_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(T2_pipe_tags_ok), "|"), "ok|tags|fallback"));
    TRUE));
TEST("shape/endpoint_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(T2_ep_openai_default), "|"),
        "ok|endpoint|scheme|host|port|path"));
    TRUE));

// ── 跑测试 + 自己把关退出码 ─────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_ai: ", LEN(records), " test(s) run");
LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"), " :: ", AT_K(rec, "error", ""))))));
PRINT("test_ai: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_ai: FAILED"); PANIC("ai tests failed")), NULL);
PRINT("test_ai: OK");