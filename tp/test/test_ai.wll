// ── ③ 后处理（纯函数 FINISH：strip / 摘要截断 / 标签解析）──────────
// complete_strip
//   complete 的返回值过 `.strip()`
//   出处：ai_assistance.py:113（`result.strip()`）
LET(T2_fin_complete_strip, FINISH(INDEX_SET(INDEX_SET(DICT(), "capability", "complete"), "content", "  Text with spaces. \n")));
// complete_ideographic_space
//   Python 的 strip 去掉 U+3000；内建 TRIM **只去 ASCII 空白** ⇒ 必须用 PY_WS 集合
//   出处：ai_assistance.py:113 + tp/README 坑 41
LET(T2_fin_complete_ideographic_space, FINISH(INDEX_SET(INDEX_SET(DICT(), "capability", "complete"), "content", "　全角空白　")));
// complete_nbsp
//   NBSP（U+00A0）同样要剥
//   出处：ai_assistance.py:113 + Python str.isspace()
LET(T2_fin_complete_nbsp, FINISH(INDEX_SET(INDEX_SET(DICT(), "capability", "complete"), "content", " nbsp text ")));
// polish_strip
//   polish 也 strip
//   出处：ai_assistance.py:139
LET(T2_fin_polish_strip, FINISH(INDEX_SET(INDEX_SET(DICT(), "capability", "polish"), "content", "\n\nPolished.\n")));
// translate_strip
//   translate 也 strip
//   出处：ai_assistance.py:166
LET(T2_fin_translate_strip, FINISH(INDEX_SET(INDEX_SET(DICT(), "capability", "translate"), "content", " 翻訳 ")));
// summarize_short
//   不超过上限 ⇒ 原样
//   出处：ai_assistance.py:195-196
LET(T2_fin_summarize_short, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "summarize"), "content", "Short."), "max_length", 160)));
// summarize_exact_160
//   **恰好** 160 ⇒ 不截断（判定是 `>`，不是 `>=`）
//   出处：ai_assistance.py:195
LET(T2_fin_summarize_exact_160, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "summarize"), "content", "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"), "max_length", 160)));
// summarize_over_spaces
//   超长且有空格 ⇒ 前 160 码点里**最后一个空格**之前 + "..."（`rsplit(" ", 1)[0]`）
//   出处：ai_assistance.py:196
LET(T2_fin_summarize_over_spaces, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "summarize"), "content", "word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word "), "max_length", 160)));
// summarize_over_nospace
//   超长且**没有**空格 ⇒ 前 160 码点原样 + "..."
//   出处：ai_assistance.py:196（rsplit 无空格时只剩整段）
LET(T2_fin_summarize_over_nospace, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "summarize"), "content", ""), "max_length", 160)));
// summarize_cjk
//   中文没有空格 ⇒ 按**码点**截到 160（不是字节）
//   出处：ai_assistance.py:195-196
LET(T2_fin_summarize_cjk, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "summarize"), "content", "中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中"), "max_length", 160)));
// summarize_max200
//   180 < 200 ⇒ 不截断（max_length 是参数，不是常量 160）
//   出处：ai_assistance.py:168,195
LET(T2_fin_summarize_max200, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "summarize"), "content", "qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq"), "max_length", 200)));
// tags_plain_array
//   纯 JSON 数组
//   出处：ai_assistance.py:232-234
LET(T2_fin_tags_plain_array, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "[\"python\", \"web\"]"), "max_tags", 5)));
// tags_fenced_json
//   ```json 围栏
//   出处：ai_assistance.py:228-230
LET(T2_fin_tags_fenced_json, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "```json\n[\"python\", \"web\"]\n```"), "max_tags", 5)));
// tags_fenced_plain
//   ``` 无语言标记
//   出处：ai_assistance.py:229（`(?:json)?` 可选）
LET(T2_fin_tags_fenced_plain, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "```\n[\"python\"]\n```"), "max_tags", 5)));
// tags_fenced_upper_json
//   ```JSON 大写**不**被 `(?:json)?` 吃掉 ⇒ 解析失败 ⇒ 走词频降级
//   出处：ai_assistance.py:229（正则区分大小写）
LET(T2_fin_tags_fenced_upper_json, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "```JSON\n[\"python\"]\n```"), "max_tags", 5)));
// tags_fenced_spaces
//   先 strip，再剥围栏与围栏后的空白
//   出处：ai_assistance.py:226-230
LET(T2_fin_tags_fenced_spaces, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "  ```json\n  [\"a\", \"b\"]  \n```  "), "max_tags", 5)));
// tags_with_numbers
//   数组里有非字符串 ⇒ Python 返回 **[]**（**不**降级）
//   出处：ai_assistance.py:233-235
LET(T2_fin_tags_with_numbers, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "[\"a\", 1]"), "max_tags", 5)));
// tags_object_root
//   根不是数组 ⇒ []
//   出处：ai_assistance.py:233-235
LET(T2_fin_tags_object_root, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "{\"tags\": [\"a\"]}"), "max_tags", 5)));
// tags_string_root
//   根是字符串 ⇒ []
//   出处：ai_assistance.py:233-235
LET(T2_fin_tags_string_root, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "\"just text\""), "max_tags", 5)));
// tags_empty_array
//   空数组 ⇒ [] 且**形状合法**（与「解析失败」要能分开）
//   出处：ai_assistance.py:233-234
LET(T2_fin_tags_empty_array, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "[]"), "max_tags", 5)));
// tags_not_json
//   不是 JSON ⇒ JSONDecodeError ⇒ 走词频降级
//   出处：ai_assistance.py:236-238
LET(T2_fin_tags_not_json, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "Sure! Here are tags: python, web"), "max_tags", 5)));
// tags_too_many
//   超过 max_tags ⇒ 只取前 N 个
//   出处：ai_assistance.py:234（`tags[:max_tags]`）
LET(T2_fin_tags_too_many, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "[\"a\", \"b\", \"c\", \"d\", \"e\"]"), "max_tags", 3)));
// tags_nested_array
//   元素是数组 ⇒ 形状非法 ⇒ []
//   出处：ai_assistance.py:233
LET(T2_fin_tags_nested_array, FINISH(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "content", "[[\"a\"], \"b\"]"), "max_tags", 5)));


