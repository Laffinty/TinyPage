// ── ⑥ 出参 JSON（纯函数 JSON_ENVELOPE —— 反向守卫「错误也必须是 JSON」）──
// error_ascii —— `json.dumps({"error": …})` —— admin 侧 200 + application/json
LET(T2_env_error_ascii, JSON_ENVELOPE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ok", FALSE), "error", "API key not configured"), "content", NULL), "tags", NULL)));
// error_unknown_action —— 中文错误消息：Python 写 \uXXXX（ensure_ascii=True），我们保留原字符（**已登记偏离**）
LET(T2_env_error_unknown_action, JSON_ENVELOPE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ok", FALSE), "error", "未知操作: frobnicate"), "content", NULL), "tags", NULL)));
// result_ascii —— `{"result": ...}`
LET(T2_env_result_ascii, JSON_ENVELOPE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ok", TRUE), "error", NULL), "content", "Polished text."), "tags", NULL)));
// result_quotes —— 引号 / 反斜杠 / 换行的转义要与 json.dumps 逐字节一致
LET(T2_env_result_quotes, JSON_ENVELOPE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ok", TRUE), "error", NULL), "content", "He said \"hi\"\\nbye"), "tags", NULL)));
// result_tags —— 标签是数组 ⇒ `{"result": ["a", "b"]}`（`", "` 分隔）
LET(T2_env_result_tags, JSON_ENVELOPE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ok", TRUE), "error", NULL), "content", NULL), "tags", ["python", "web", "tutorial"])));
// result_empty_tags —— 空数组 ⇒ `{"result": []}`
LET(T2_env_result_empty_tags, JSON_ENVELOPE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ok", TRUE), "error", NULL), "content", NULL), "tags", [])));


TEST("envelope/error_ascii", FUN(() ,
    (ASSERT_EQ(T2_env_error_ascii, "{\"error\": \"API key not configured\"}"));
    // 反向守卫：整条响应必须是一个 JSON 对象（以 { 开头、以 } 结尾）
    (ASSERT_EQ(SUB(T2_env_error_ascii, 0, 1), "{"));
    (ASSERT_EQ(SUB(T2_env_error_ascii, -(LEN(T2_env_error_ascii), 1)), "}"));
    TRUE));

TEST("envelope/error_unknown_action", FUN(() ,
    (ASSERT_EQ(T2_env_error_unknown_action, "{\"error\": \"未知操作: frobnicate\"}"));
    // 反向守卫：整条响应必须是一个 JSON 对象（以 { 开头、以 } 结尾）
    (ASSERT_EQ(SUB(T2_env_error_unknown_action, 0, 1), "{"));
    (ASSERT_EQ(SUB(T2_env_error_unknown_action, -(LEN(T2_env_error_unknown_action), 1)), "}"));
    TRUE));

TEST("envelope/result_ascii", FUN(() ,
    (ASSERT_EQ(T2_env_result_ascii, "{\"result\": \"Polished text.\"}"));
    // 反向守卫：整条响应必须是一个 JSON 对象（以 { 开头、以 } 结尾）
    (ASSERT_EQ(SUB(T2_env_result_ascii, 0, 1), "{"));
    (ASSERT_EQ(SUB(T2_env_result_ascii, -(LEN(T2_env_result_ascii), 1)), "}"));
    TRUE));

TEST("envelope/result_quotes", FUN(() ,
    (ASSERT_EQ(T2_env_result_quotes, "{\"result\": \"He said \\\"hi\\\"\\\\nbye\"}"));
    // 反向守卫：整条响应必须是一个 JSON 对象（以 { 开头、以 } 结尾）
    (ASSERT_EQ(SUB(T2_env_result_quotes, 0, 1), "{"));
    (ASSERT_EQ(SUB(T2_env_result_quotes, -(LEN(T2_env_result_quotes), 1)), "}"));
    TRUE));

TEST("envelope/result_tags", FUN(() ,
    (ASSERT_EQ(T2_env_result_tags, "{\"result\": [\"python\", \"web\", \"tutorial\"]}"));
    // 反向守卫：整条响应必须是一个 JSON 对象（以 { 开头、以 } 结尾）
    (ASSERT_EQ(SUB(T2_env_result_tags, 0, 1), "{"));
    (ASSERT_EQ(SUB(T2_env_result_tags, -(LEN(T2_env_result_tags), 1)), "}"));
    TRUE));

TEST("envelope/result_empty_tags", FUN(() ,
    (ASSERT_EQ(T2_env_result_empty_tags, "{\"result\": []}"));
    // 反向守卫：整条响应必须是一个 JSON 对象（以 { 开头、以 } 结尾）
    (ASSERT_EQ(SUB(T2_env_result_empty_tags, 0, 1), "{"));
    (ASSERT_EQ(SUB(T2_env_result_empty_tags, -(LEN(T2_env_result_empty_tags), 1)), "}"));
    TRUE));

// ── ⑦ 全链路（五个能力 + 注入的假传输；仍然不出网）───────────────
// complete_ok
//   整条链：建消息 → 建请求 → （假传输）→ 解析 → 取 content → strip
//   出处：ai_assistance.py:100-113 + 卡 S5-1 的 exchange 测试缝
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 84\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"  continued words.  \"}}]}");
LET(T2_pipe_complete_ok, COMPLETE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test"), "text", "Hello"), "exchange", T2_exchange)));
LET(T2_wire_complete_ok, T2_seen);
// polish_ok
//   polish 全链路（温度 0.5 进请求体）
//   出处：ai_assistance.py:115-139
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 78\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"Polished text.\"}}]}");
LET(T2_pipe_polish_ok, POLISH(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test"), "text", "rough  text"), "exchange", T2_exchange)));
LET(T2_wire_polish_ok, T2_seen);
// summarize_ok
//   summarize 全链路：max_length 既进 system 也做截断
//   出处：ai_assistance.py:168-198
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 116\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"This is a very long summary that should be cut down.\"}}]}");
LET(T2_pipe_summarize_ok, SUMMARIZE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test"), "text", "long text"), "max_length", 20), "exchange", T2_exchange)));
LET(T2_wire_summarize_ok, T2_seen);
// translate_ja_ok
//   lang=ja ⇒ 消息里是 Japanese，内容原样（strip 后）
//   出处：ai_assistance.py:141-166 + admin/actions.py:313-314
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 79\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"こんにちは\"}}]}");
LET(T2_pipe_translate_ja_ok, TRANSLATE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test"), "text", "你好"), "lang", "ja"), "exchange", T2_exchange)));
LET(T2_wire_translate_ja_ok, T2_seen);
// complete_http_401
//   4xx ⇒ ok:FALSE（**不得**当正常结果）；错误里头要能看见 401
//   出处：卡 S5-1 反向守卫 + 卡 S5-2「错误必须是 JSON」
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\nContent-Length: 122\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"{\\\"error\\\": {\\\"message\\\": \\\"Incorrect API key provided\\\"}}\"}}]}");
LET(T2_pipe_complete_http_401, COMPLETE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-bad"), "text", "Hello"), "exchange", T2_exchange)));
LET(T2_wire_complete_http_401, T2_seen);
// no_api_key
//   没有 key ⇒ 明确失败，且**根本不碰传输**
//   出处：ai_assistance.py:57-58 + 卡 S5-1 反向守卫
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 74\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"never sent\"}}]}");
LET(T2_pipe_no_api_key, COMPLETE(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "text", "Hello"), "exchange", T2_exchange)));
LET(T2_wire_no_api_key, T2_seen);
// disabled
//   未启用 ⇒ 不构建 AI（错误，而不是静默空串）
//   出处：ai_assistance.py:273-276 + admin/actions.py:302-304
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 74\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"never sent\"}}]}");
LET(T2_pipe_disabled, COMPLETE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", FALSE), "ai_api_key", "sk-test"), "text", "Hello"), "exchange", T2_exchange)));
LET(T2_wire_disabled, T2_seen);
// tags_ok
//   标签全链路：解析成功 ⇒ fallback=FALSE
//   出处：ai_assistance.py:200-238
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 90\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"[\\\"python\\\", \\\"tutorial\\\"]\"}}]}");
LET(T2_pipe_tags_ok, SUGGEST_TAGS(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test"), "text", "python web python"), "exchange", T2_exchange)));
LET(T2_wire_tags_ok, T2_seen);
// tags_shape_bad
//   形状非法 ⇒ **[]**（Python 此时**不**降级）
//   出处：ai_assistance.py:233-235
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 79\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"[\\\"python\\\", 1]\"}}]}");
LET(T2_pipe_tags_shape_bad, SUGGEST_TAGS(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test"), "text", "python web python"), "exchange", T2_exchange)));
LET(T2_wire_tags_shape_bad, T2_seen);
// tags_not_json
//   不是 JSON ⇒ 词频降级（与形状非法要分开）
//   出处：ai_assistance.py:236-238
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 88\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"Here you go: python, web\"}}]}");
LET(T2_pipe_tags_not_json, SUGGEST_TAGS(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test"), "text", "python web python"), "exchange", T2_exchange)));
LET(T2_wire_tags_not_json, T2_seen);
// tags_http_500
//   后端错误 ⇒ 降级词频（AIAssistanceError 分支）
//   出处：ai_assistance.py:236-238（`except (JSONDecodeError, AIAssistanceError)`）
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 500 Internal Server Error\r\nContent-Type: application/json\r\nContent-Length: 96\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"{\\\"error\\\": \\\"server exploded\\\"}\"}}]}");
LET(T2_pipe_tags_http_500, SUGGEST_TAGS(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test"), "text", "python web python"), "exchange", T2_exchange)));
LET(T2_wire_tags_http_500, T2_seen);
// complete_empty_text
//   空文本 ⇒ ""，且**不发请求**（transport_called=FALSE）
//   出处：ai_assistance.py:100-101
SET(T2_seen, "");
SET(T2_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 74\r\n\r\n{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"never sent\"}}]}");
LET(T2_pipe_complete_empty_text, COMPLETE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test"), "text", ""), "exchange", T2_exchange)));
LET(T2_wire_complete_empty_text, T2_seen);


// complete_ok
TEST("pipeline/complete_ok/ok", FUN(() ,
    (ASSERT_EQ(AT_K(T2_pipe_complete_ok, "ok", "?"), TRUE));
    TRUE));
TEST("pipeline/complete_ok/status", FUN(() ,
    (ASSERT_EQ(AT_K(T2_pipe_complete_ok, "status", -999), 200));
    TRUE));
TEST("pipeline/complete_ok/content", FUN(() ,
    (ASSERT_EQ(AT_K(T2_pipe_complete_ok, "content", "?"), "continued words."));
    TRUE));
TEST("pipeline/complete_ok/transport_called", FUN(() ,
    (ASSERT(>(LEN(T2_wire_complete_ok), 0), "complete_ok: exchange must be called"));
    TRUE));
TEST("pipeline/complete_ok/wire_body", FUN(() ,
    // 请求体 = 报文里第一个 CRLFCRLF 之后的全部（逐字节对照 STRINGIFY 口径）
    (ASSERT_EQ(SUB(T2_wire_complete_ok, +(INDEX_OF(T2_wire_complete_ok, "\r\n\r\n"), 4)), "{\"messages\":[{\"content\":\"You are a helpful writing assistant. Continue the user's text naturally and coherently.\",\"role\":\"system\"},{\"content\":\"Continue this text:\\n\\nHello\",\"role\":\"user\"}],\"model\":\"gpt-3.5-turbo\",\"temperature\":0.8}"));
    TRUE));
TEST("pipeline/complete_ok/wire_has_auth", FUN(() ,
    // 传输层（卡 S5-1）负责 Authorization；这里只确认它真的进了报文
    (ASSERT(CONTAINS_SUB(T2_wire_complete_ok, "Authorization: Bearer "),
            "complete_ok: bearer header must be present"));
    TRUE));

