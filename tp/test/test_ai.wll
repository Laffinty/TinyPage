    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_complete_hint, "messages", []), 1, DICT()), "content", "?"), "Continue this text:\n\nHello"));
    (ASSERT_EQ(JOIN(KEYS(AT(AT_K(T2_build_complete_hint, "messages", []), 1, DICT())), "|"), "role|content"));
    TRUE));

TEST("build/complete_empty", FUN(() ,
    (ASSERT_EQ(AT_K(T2_build_complete_empty, "ok", "?"), TRUE));
    (ASSERT_EQ(AT_K(T2_build_complete_empty, "capability", "?"), "complete"));
    (ASSERT_EQ(AT_K(T2_build_complete_empty, "model", "?"), "gpt-3.5-turbo"));
    // 空文本 ⇒ Python 没构建消息（也没有温度）
    (ASSERT_EQ(TYPE(AT_K(T2_build_complete_empty, "temperature", 0)), "NULL"));
    (ASSERT_EQ(AT_K(T2_build_complete_empty, "skip", "?"), TRUE));
    (ASSERT_EQ(LEN(AT_K(T2_build_complete_empty, "messages", [])), 0));
    TRUE));

