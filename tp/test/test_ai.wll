// ── ② 响应取内容（纯函数 EXTRACT_CONTENT）────────────────────────
// normal
//   正常：取 choices[0].message.content
//   出处：ai_assistance.py:77-81
LET(T2_extract_normal, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"Hello there\"}}]}"), "status", 200)));
// unicode_content
//   中文内容原样取回（转义 \u4e2d 由 JSON 解析处理）
//   出处：ai_assistance.py:77-81
LET(T2_extract_unicode_content, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": [{\"message\": {\"content\": \"中文内容\"}}]}"), "status", 200)));
// escaped_newline
//   内容里的转义换行要还原成真换行
//   出处：ai_assistance.py:77-81
LET(T2_extract_escaped_newline, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": [{\"message\": {\"content\": \"line1\\nline2\"}}]}"), "status", 200)));
// empty_content
//   空串 content 是**合法**结果（不是缺字段）
//   出处：ai_assistance.py:81
LET(T2_extract_empty_content, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": [{\"message\": {\"content\": \"\"}}]}"), "status", 200)));
// extra_fields
//   多余字段不影响
//   出处：ai_assistance.py:78-81
LET(T2_extract_extra_fields, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"id\": \"x\", \"choices\": [{\"index\": 0, \"message\": {\"content\": \"ok\"}, \"finish_reason\": \"stop\"}]}"), "status", 200)));
// empty_choices
//   choices 空 ⇒ Python 抛 "No response from AI"；我们 ok:FALSE
//   出处：ai_assistance.py:78-80
LET(T2_extract_empty_choices, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": []}"), "status", 200)));
// no_choices
//   没有 choices 键 ⇒ 同「空」
//   出处：ai_assistance.py:78-80
LET(T2_extract_no_choices, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"id\": \"x\"}"), "status", 200)));
// choices_not_array
//   choices 不是数组 ⇒ 我们 ok:FALSE；Python 会 `choices[0]` 崩成 KeyError/TypeError
//   出处：ai_assistance.py:78-81
LET(T2_extract_choices_not_array, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": {\"message\": {\"content\": \"x\"}}}"), "status", 200)));
// no_message
//   缺 message ⇒ Python **静默返回 ""**（`.get("message", {}).get("content", "")`）；我们 ok:FALSE
//   出处：ai_assistance.py:81
LET(T2_extract_no_message, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": [{\"index\": 0}]}"), "status", 200)));
// content_number
//   content 不是字符串 ⇒ Python 返回 int 123（后续 .strip() 会崩）；我们 ok:FALSE
//   出处：ai_assistance.py:81
LET(T2_extract_content_number, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": [{\"message\": {\"content\": 123}}]}"), "status", 200)));
// content_null
//   content 是 null ⇒ Python 返回 None；我们 ok:FALSE
//   出处：ai_assistance.py:81
LET(T2_extract_content_null, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": [{\"message\": {\"content\": null}}]}"), "status", 200)));
// not_json
//   不是 JSON ⇒ ok:FALSE（先 JSON_VALIDATE，别让 PARSE 以 E0070 中止）
//   出处：ai_assistance.py:77（json.loads 抛 JSONDecodeError）
LET(T2_extract_not_json, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "<html>502 Bad Gateway</html>"), "status", 502)));
// json_array_root
//   根是数组 ⇒ ok:FALSE
//   出处：ai_assistance.py:78（`result.get` 会 AttributeError）
LET(T2_extract_json_array_root, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "[\"choices\"]"), "status", 200)));
// status_echo
//   status 原样回带（不参与判定）
//   出处：卡 S5-1 的形状：{ok, status, content}
LET(T2_extract_status_echo, EXTRACT_CONTENT(INDEX_SET(INDEX_SET(DICT(), "body", "{\"choices\": [{\"message\": {\"content\": \"ok\"}}]}"), "status", 201)));


