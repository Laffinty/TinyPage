// tp/test/test_ai.wll —— 五个 AI 能力与降级的脱网测试（卡 S5-2）
//
// ⚠ 本文件由 tp/test/gen_test_ai.py 生成 —— 请勿手改。
//
// 被测：tp/lib/ai.wll
//   BUILD_MESSAGES / EXTRACT_CONTENT / FINISH / FALLBACK_SUGGEST_TAGS /
//   ENDPOINT_PARTS / JSON_ENVELOPE / IS_ENABLED   —— 纯函数，逐字对照真 Python
//   COMPLETE / POLISH / TRANSLATE / SUMMARIZE / SUGGEST_TAGS —— 用注入的假传输跑全链路
// 基准：tp/test/fixtures/ai_baseline.json
//   · 期望值由 gen_ai_baseline.py 从真 Python 现算（不是手抄）
//   · 六处刻意偏离登记在该 JSON 的 meta.divergences
//
// ⚠ **本文件不出网**：`opts.exchange` 是卡 S5-1 的传输注入点，
//   假传输回放夹具里的原始响应报文 ⇒ 不带 --ext、也不碰 tls 就能全绿。
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS"]);
IMPORT("wlwl:std.str", ["CAT", "JOIN", "INDEX_OF", "CONTAINS_SUB"]);
IMPORT("wlwl:std.json", ["STRINGIFY"]);
IMPORT("./../lib/ai.wll", [
        "IS_ENABLED",
        "BUILD_MESSAGES",
        "EXTRACT_CONTENT",
        "FINISH",
        "FALLBACK_SUGGEST_TAGS",
        "ENDPOINT_PARTS",
        "JSON_ENVELOPE",
        "COMPLETE",
        "POLISH",
        "TRANSLATE",
        "SUMMARIZE",
        "SUGGEST_TAGS"]);

// ── 测试缝：假传输（记下真实请求文本，回放夹具里的响应报文）──────────
// ⚠ 闭包可以写外层的 LET MUT（坑 12），所以这里能记下 T2_seen。
LET MUT(T2_seen, "");
LET MUT(T2_reply, "");
LET(T2_exchange, FUN((req), (SET(T2_seen, req); T2_reply)));

// ── ① 消息构造（纯函数 BUILD_MESSAGES）──────────────────────────
// ⚠ 期望值来自抓到的**真实** messages（Python 的 _call_api 被记录器顶替）
// complete_basic
//   complete：system 一条 + user 一条，温度 0.8
//   出处：ai_assistance.py:103-112（complete_text）
LET(T2_build_complete_basic, BUILD_MESSAGES(INDEX_SET(INDEX_SET(DICT(), "capability", "complete"), "text", "Hello world")));
// complete_hint
//   complete + prompt_hint ⇒ system 末尾**追加** ` The user wants to focus on: …`
//   出处：ai_assistance.py:104-105
LET(T2_build_complete_hint, BUILD_MESSAGES(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "complete"), "text", "Hello"), "prompt_hint", "tone: friendly")));
// complete_empty
//   空文本 ⇒ Python 直接返回 ""，**不构建消息、不发请求**（skip）
//   出处：ai_assistance.py:100-101
LET(T2_build_complete_empty, BUILD_MESSAGES(INDEX_SET(INDEX_SET(DICT(), "capability", "complete"), "text", "")));
// complete_spaces_only
//   只有空格**不是**空文本（Python 的 `if not text` 只判真空串）⇒ 仍要发请求
//   出处：ai_assistance.py:100（`if not text` 的空值判定）
LET(T2_build_complete_spaces_only, BUILD_MESSAGES(INDEX_SET(INDEX_SET(DICT(), "capability", "complete"), "text", "   ")));
// polish_basic
//   polish：温度 0.5；text **原样**进入 user 消息（不 strip）
//   出处：ai_assistance.py:127-138
LET(T2_build_polish_basic, BUILD_MESSAGES(INDEX_SET(INDEX_SET(DICT(), "capability", "polish"), "text", "  some rough text  ")));
// translate_default
//   translate 不给 target_lang ⇒ Python 默认 "English"
//   出处：ai_assistance.py:141（签名默认值 "English"）
LET(T2_build_translate_default, BUILD_MESSAGES(INDEX_SET(INDEX_SET(DICT(), "capability", "translate"), "text", "你好")));
// translate_ja
//   translate → Japanese（lang 码 "ja" 经 lang_map 得到的就是这个名字）
//   出处：ai_assistance.py:154-163 + admin/actions.py:313-315（lang_map）
LET(T2_build_translate_ja, BUILD_MESSAGES(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "translate"), "text", "你好"), "target_lang", "Japanese"), "lang", "ja")));
// translate_en_code
//   lang 码 "en" ⇒ English（硬编码映射，不认其它码）
//   出处：admin/actions.py:313-314（{"en": "English", "ja": "Japanese"}）
LET(T2_build_translate_en_code, BUILD_MESSAGES(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "translate"), "text", "你好"), "target_lang", "English"), "lang", "en")));
// translate_unknown_code
//   未知 lang 码 ⇒ 回落 English（`lang_map.get(lang, "English")`）
//   出处：admin/actions.py:314（get 的缺省 "English"）
LET(T2_build_translate_unknown_code, BUILD_MESSAGES(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "translate"), "text", "你好"), "target_lang", "English"), "lang", "fr")));
// summarize_default
//   summarize：温度 0.3；max_length 缺省 160 写进 system
//   出处：ai_assistance.py:168-192
LET(T2_build_summarize_default, BUILD_MESSAGES(INDEX_SET(INDEX_SET(DICT(), "capability", "summarize"), "text", "long text")));
// summarize_200
//   max_length=200（content.py:806 的调用就是这么传的）
//   出处：content.py:806（`ai.summarize(translated_content, 200)`）
LET(T2_build_summarize_200, BUILD_MESSAGES(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "summarize"), "text", "long text"), "max_length", 200)));
// tags_default
//   suggest_tags：温度 0.3；max_tags 缺省 5 写进 system
//   出处：ai_assistance.py:213-225
LET(T2_build_tags_default, BUILD_MESSAGES(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "text", "short text")));
// tags_max3
//   max_tags=3 ⇒ system 里是 "exactly 3"
//   出处：ai_assistance.py:216
LET(T2_build_tags_max3, BUILD_MESSAGES(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "text", "short text"), "max_tags", 3)));
// tags_long_text
//   user 消息里的正文被截到**前 2000 码点**（`text[:2000]`）
//   出处：ai_assistance.py:220（`text[:2000]`）
LET(T2_build_tags_long_text, BUILD_MESSAGES(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "text", "")));
// tags_empty
//   空文本 ⇒ Python 返回 []，不构建消息
//   出处：ai_assistance.py:210-211
LET(T2_build_tags_empty, BUILD_MESSAGES(INDEX_SET(INDEX_SET(DICT(), "capability", "suggest_tags"), "text", "")));


TEST("build/complete_basic", FUN(() ,
    (ASSERT_EQ(AT_K(T2_build_complete_basic, "ok", "?"), TRUE));
    (ASSERT_EQ(AT_K(T2_build_complete_basic, "capability", "?"), "complete"));
    (ASSERT_EQ(AT_K(T2_build_complete_basic, "model", "?"), "gpt-3.5-turbo"));
    (ASSERT_EQ(AT_K(T2_build_complete_basic, "temperature", -1), 0.8));
    (ASSERT_EQ(AT_K(T2_build_complete_basic, "skip", "?"), FALSE));
    (ASSERT_EQ(LEN(AT_K(T2_build_complete_basic, "messages", [])), 2));
    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_complete_basic, "messages", []), 0, DICT()), "role", "?"), "system"));
    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_complete_basic, "messages", []), 0, DICT()), "content", "?"), "You are a helpful writing assistant. Continue the user's text naturally and coherently."));
    (ASSERT_EQ(JOIN(KEYS(AT(AT_K(T2_build_complete_basic, "messages", []), 0, DICT())), "|"), "role|content"));
    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_complete_basic, "messages", []), 1, DICT()), "role", "?"), "user"));
    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_complete_basic, "messages", []), 1, DICT()), "content", "?"), "Continue this text:\n\nHello world"));
    (ASSERT_EQ(JOIN(KEYS(AT(AT_K(T2_build_complete_basic, "messages", []), 1, DICT())), "|"), "role|content"));
    TRUE));

TEST("build/complete_hint", FUN(() ,
    (ASSERT_EQ(AT_K(T2_build_complete_hint, "ok", "?"), TRUE));
    (ASSERT_EQ(AT_K(T2_build_complete_hint, "capability", "?"), "complete"));
