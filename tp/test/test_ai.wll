    (ASSERT_EQ(AT_K(T2_ep_deepseek_default, "host", "?"), "api.deepseek.com"));
    (ASSERT_EQ(AT_K(T2_ep_deepseek_default, "port", -1), 443));
    (ASSERT_EQ(AT_K(T2_ep_deepseek_default, "path", "?"), "/v1/chat/completions"));
    TRUE));

TEST("endpoint/provider_case", FUN(() ,
    (ASSERT_EQ(AT_K(T2_ep_provider_case, "ok", "?"), TRUE));
    (ASSERT_EQ(AT_K(T2_ep_provider_case, "host", "?"), "api.deepseek.com"));
    (ASSERT_EQ(AT_K(T2_ep_provider_case, "port", -1), 443));
    (ASSERT_EQ(AT_K(T2_ep_provider_case, "path", "?"), "/v1/chat/completions"));
    TRUE));

