    (ASSERT_EQ(TYPE(AT_K(T2_build_tags_empty, "temperature", 0)), "NULL"));
    (ASSERT_EQ(AT_K(T2_build_tags_empty, "skip", "?"), TRUE));
    (ASSERT_EQ(LEN(AT_K(T2_build_tags_empty, "messages", [])), 0));
    TRUE));

// 反向守卫：未知能力 ⇒ ok:FALSE（**不得**静默返回空消息）
