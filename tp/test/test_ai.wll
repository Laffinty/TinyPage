    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_translate_default, "messages", []), 0, DICT()), "role", "?"), "system"));
    (ASSERT_EQ(AT_K(AT(AT_K(T2_build_translate_default, "messages", []), 0, DICT()), "content", "?"), "You are a professional translator. Translate the text to English accurately and naturally. Only return the translated text, no explanations."));
