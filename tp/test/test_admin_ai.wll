// endpoint/backend_500 —— /translate 的后端错误同样必须是 JSON
//   出处：actions.py:322-329
SET(T5_seen, "");
SET(T5_reply, "HTTP/1.1 500 Internal Server Error\r\nContent-Type: application/json\r\nContent-Length: 17\r\n\r\n{\"error\": \"boom\"}");
LET(T5_e_backend_500, TRANSLATE_ENDPOINT(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "text", "Hello"), "target", "en"), "cfg", INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test")), "exchange", T5_exchange)));
LET(T5_ew_backend_500, T5_seen);
LET(T5_ej_backend_500, JSON_ENVELOPE(T5_e_backend_500));

// ── ① /ai-assist ────────────────────────────────────────────────
// ⚠ 期望值 = 真 ai_assist() 的 JSON；请求体 = 真 payload 按 STRINGIFY 口径重排

TEST("assist/complete_ok/ok", FUN(() ,
    (ASSERT_EQ(AT_K(T5_a_complete_ok, "ok", "?"), TRUE));
    TRUE));
TEST("assist/complete_ok/json", FUN(() ,
    (ASSERT_EQ(IS_ERR(JSON_VALIDATE(T5_aj_complete_ok)), FALSE));
    (ASSERT_EQ(TYPE(PARSE(T5_aj_complete_ok)), "DICT"));
    TRUE));
TEST("assist/complete_ok/body", FUN(() ,
    // 逐字节对齐真 Python 的 {"result"|"error": …}（ensure_ascii=False 口径）
    (ASSERT_EQ(T5_aj_complete_ok, "{\"result\": \"continued words.\"}"));
    TRUE));
TEST("assist/complete_ok/transport", FUN(() ,
    (ASSERT(>(LEN(T5_aw_complete_ok), 0),
            "complete_ok: exchange must be called"));
    TRUE));
TEST("assist/complete_ok/wire_body", FUN(() ,
    // 请求体 = 报文里第一个 CRLFCRLF 之后的全部（STRINGIFY 口径）
    (ASSERT_EQ(SUB(T5_aw_complete_ok, +(INDEX_OF(T5_aw_complete_ok, "\r\n\r\n"), 4)), "{\"messages\":[{\"content\":\"You are a helpful writing assistant. Continue the user's text naturally and coherently.\",\"role\":\"system\"},{\"content\":\"Continue this text:\\n\\nHello world\",\"role\":\"user\"}],\"model\":\"gpt-3.5-turbo\",\"temperature\":0.8}"));
    TRUE));

