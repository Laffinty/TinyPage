// ── ③ 反向守卫 ──────────────────────────────────────────────────
// 空 opts（连 cfg 都没有）⇒ 必须是同一句未配置文案，且**是 JSON**
LET(T5_g_empty_assist, JSON_ENVELOPE(AI_ASSIST(DICT())));
TEST("guard/empty_opts_unconfigured", FUN(() ,
    (ASSERT_EQ(T5_g_empty_assist, "{\"error\": \"AI 未启用或未配置 API Key\"}"));
    TRUE));
LET(T5_g_empty_translate, JSON_ENVELOPE(TRANSLATE_ENDPOINT(DICT())));
TEST("guard/empty_opts_translate", FUN(() ,
    (ASSERT_EQ(T5_g_empty_translate, "{\"error\": \"AI 未启用或未配置 API Key\"}"));
    TRUE));

// 失败形状固定为 {ok, error}（调用方可以安全地 AT_K）
TEST("shape/failure_keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(AI_ASSIST(DICT())), "|"), "ok|error"));
    TRUE));

// ⚠ 已登记刻意语义 ⑤：ai_enabled 只认布尔 TRUE（Python 认任意真值）
LET(T5_g_truthy, JSON_ENVELOPE(AI_ASSIST(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "action", "complete"), "text", "x"), "cfg", INDEX_SET(INDEX_SET(DICT(), "ai_enabled", 1), "ai_api_key", "sk-test")))));
TEST("guard/truthy_int_is_unconfigured", FUN(() ,
    (ASSERT_EQ(T5_g_truthy, "{\"error\": \"AI 未启用或未配置 API Key\"}"));
    TRUE));

// `AI_ASSIST_JSON` / `TRANSLATE_JSON` **就是** JSON_ENVELOPE(...) 的组合（接线公式）
// ⚠ 在顶层求值：每次调用前重设 T5_reply，否则回放的是上一条用例的响应
SET(T5_seen, "");
SET(T5_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 173\r\n\r\n{\"id\": \"chatcmpl-test\", \"object\": \"chat.completion\", \"choices\": [{\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": \"  continued words.  \"}, \"finish_reason\": \"stop\"}]}");
LET(T5_g_assist_json, AI_ASSIST_JSON(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "action", "complete"), "text", "Hello world"), "cfg", INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test")), "exchange", T5_exchange)));
SET(T5_seen, "");
SET(T5_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 170\r\n\r\n{\"id\": \"chatcmpl-test\", \"object\": \"chat.completion\", \"choices\": [{\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": \" こんにちは \"}, \"finish_reason\": \"stop\"}]}");
LET(T5_g_translate_json, TRANSLATE_JSON(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "text", "Hello"), "target", "ja"), "cfg", INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test")), "exchange", T5_exchange)));
TEST("guard/assist_json_is_envelope", FUN(() ,
    (ASSERT_EQ(T5_g_assist_json, "{\"result\": \"continued words.\"}"));
    TRUE));
TEST("guard/translate_json_is_envelope", FUN(() ,
    (ASSERT_EQ(T5_g_translate_json, "{\"result\": \"こんにちは\"}"));
    TRUE));

// 未知 action 的错误**不是**任何能力的成功结果（不落默认分支）
TEST("guard/unknown_is_not_a_result", FUN(() ,
    (ASSERT(CONTAINS_SUB(T5_aj_unknown_action, "未知操作: "),
            "unknown action must be named in the error"));
    (ASSERT(==(INDEX_OF(T5_aj_unknown_action, "\"result\""), -1),
            "unknown action must not produce a result"));
    TRUE));

// ── 跑测试 + 自己把关退出码 ─────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_admin_ai: ", LEN(records), " test(s) run");
LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"), " :: ", AT_K(rec, "error", ""))))));
PRINT("test_admin_ai: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_admin_ai: FAILED"); PANIC("admin_ai tests failed")), NULL);
PRINT("test_admin_ai: OK");