// tp/test/test_admin_ai.wll —— AI 端点接线的脱网测试（卡 S5-3）
//
// ⚠ 本文件由 tp/test/gen_test_admin_ai.py 生成 —— 请勿手改。
//
// 被测：tp/lib/admin_ai.wll
//   AI_ASSIST / TRANSLATE_ENDPOINT      —— 分派 + cfg 摊平 + 出参口径
//   AI_ASSIST_JSON / TRANSLATE_JSON     —— 响应体（= JSON_ENVELOPE(...)）
// 基准：tp/test/fixtures/admin_ai_baseline.json
//   · 期望值由 gen_admin_ai_baseline.py 调**真** ai_assist() 现算（不是手抄）
//   · 六条刻意偏离登记在该 JSON 的 meta.divergences
//
// ⚠ **本文件不出网**：`opts.exchange` 逐层透传到卡 S5-1 的传输注入点，
//   假传输回放夹具里的原始响应报文 ⇒ 不带 --ext、不碰 tls 也能全绿。
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS"]);
IMPORT("wlwl:std.str", ["CAT", "JOIN", "CONTAINS_SUB", "INDEX_OF"]);
IMPORT("wlwl:std.json", ["JSON_VALIDATE", "PARSE"]);
IMPORT("./../lib/admin_ai.wll", [
        "AI_ASSIST",
        "TRANSLATE_ENDPOINT",
        "AI_ASSIST_JSON",
        "TRANSLATE_JSON"]);
// 出参口径来自卡 S5-2（这里直接 import，钉的是**接线公式**而非另造形状）
IMPORT("./../lib/ai.wll", ["JSON_ENVELOPE"]);

// ── 测试缝：假传输（记下真实请求文本，回放夹具里的响应报文）──────────
LET MUT(T5_seen, "");
LET MUT(T5_reply, "");
LET(T5_exchange, FUN((req), (SET(T5_seen, req); T5_reply)));

// ── 用例 ────────────────────────────────────────────────────────
// ⚠ 每个用例都是「先全部调用、后统一断言」⇒ 请求文本必须**就地快照**，
//   并且每次调用前都要重设 T5_reply（否则回放的是上一条用例的响应）。

// complete_ok —— complete：真消息构造 → 假 200 → content 取回后 strip ⇒ result "continued words."
//   出处：admin/actions.py:307-308 + ai_assistance.py:100-113
SET(T5_seen, "");
SET(T5_reply, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 173\r\n\r\n{\"id\": \"chatcmpl-test\", \"object\": \"chat.completion\", \"choices\": [{\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": \"  continued words.  \"}, \"finish_reason\": \"stop\"}]}");
LET(T5_a_complete_ok, AI_ASSIST(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "action", "complete"), "text", "Hello world"), "cfg", INDEX_SET(INDEX_SET(DICT(), "ai_enabled", TRUE), "ai_api_key", "sk-test")), "exchange", T5_exchange)));
LET(T5_aw_complete_ok, T5_seen);
LET(T5_aj_complete_ok, JSON_ENVELOPE(T5_a_complete_ok));

