// ── 反向守卫 ──────────────────────────────────────────
// 两个同名标题 ⇒ id 必须是 x 与 x-2，不得都是 x
LET(g_md_dup, "## Same\n## Same\n");
TEST("guard/dup_slug_x_then_x2", FUN(() ,
    (ASSERT_EQ(EXTRACT_HEADINGS(g_md_dup), [["level": 2, "text": "Same", "id": "same"], ["level": 2, "text": "Same", "id": "same-2"]]));
    TRUE));
TEST("guard/dup_ids_differ", FUN(() ,
    (ASSERT_NEQ(AT_K(EXTRACT_HEADINGS(g_md_dup)[0], "id", ""), AT_K(EXTRACT_HEADINGS(g_md_dup)[1], "id", "")));
    TRUE));

// 全部标题都被 min/max 过滤掉 ⇒ TOC 必须是 ""（不是空模板）
LET(g_md_h1, "# Only one\n# Only two\n");
TEST("guard/all_filtered_empty_toc", FUN(() ,
    (ASSERT_EQ(BUILD_TOC_HTML(EXTRACT_HEADINGS(g_md_h1), 2, 3), ""));
    TRUE));

// SLUGIFY_HEADING 结果为空 ⇒ 得 "heading"
TEST("guard/slug_empty_fallback_heading", FUN(() ,
    (ASSERT_EQ(SLUGIFY_HEADING("!!!"), "heading"));
    TRUE));
TEST("guard/slug_hashes_punct_fallback", FUN(() ,
    (ASSERT_EQ(SLUGIFY_HEADING("### !!!"), "heading"));
    TRUE));

// ADD_HEADING_IDS 对已有 id="..." 的标签不得重复添加
LET(g_html_keep, "<h1 id=\"keep\">Title</h1>\n");
TEST("guard/existing_id_not_duplicated", FUN(() ,
    (ASSERT_EQ(ADD_HEADING_IDS(g_html_keep, EXTRACT_HEADINGS("# Title\n")), g_html_keep));
    TRUE));

// #NoSpace（# 后无空白）不得被当成标题
TEST("guard/hash_no_space_not_heading", FUN(() ,
    (ASSERT_EQ(EXTRACT_HEADINGS("#NoSpace"), []));
    TRUE));

LET(records, RUN_TESTS());
PRINT("test_toc: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_toc: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_toc: FAILED"); PANIC("toc tests failed")), NULL);
PRINT("test_toc: OK");