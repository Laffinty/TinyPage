// ── 反向守卫（卡 S2-4 的要求）──────────────────────────────────
// g1：content 里的 <script> **原样嵌入**（content 是已渲染 HTML、不 escape），
//     而 title 的 <script> 必须被 escape —— 「谁 escape、谁不 escape」两侧都钉。
LET MUT(g1, DICT());
SET(g1, INDEX_SET(g1, "title", "<script>alert(\"T\")</script>"));
SET(g1, INDEX_SET(g1, "date", "2026-01-02 03:04"));
SET(g1, INDEX_SET(g1, "slug", "g1"));
SET(g1, INDEX_SET(g1, "content", "<script>alert('x')</script>"));
LET(out_g1, ARTICLE_PAGE(g1));
TEST("guard/content_verbatim", FUN(() ,
    (ASSERT(CONTAINS_SUB(out_g1, "<script>alert('x')</script>")));
    (ASSERT(CONTAINS_SUB(out_g1, "<h1 class=\"post-title\">&lt;script&gt;")));
    (ASSERT(!CONTAINS_SUB(out_g1, "<h1 class=\"post-title\"><script>")));
    TRUE));

// g2：独立页 content 里的 `${title}` 不被二次替换（值只经 SUBSTITUTE 一遍）。
//     若被二次展开，产物里会只剩标题文本而不见占位符。
LET MUT(g2, DICT());
SET(g2, INDEX_SET(g2, "title", "TITLE"));
SET(g2, INDEX_SET(g2, "content", "<p>\${title}</p>"));
LET(out_g2, STANDALONE_PAGE(g2));
TEST("guard/content_no_double_substitution", FUN(() ,
    (ASSERT(CONTAINS_SUB(out_g2, "<p>\${title}</p>")));
    TRUE));

// g3：site_url 为空 ⇒ 不得出现 JSON-LD / og / share。
//     （默认 config 的 site_url 就是 ""）
LET(out_g3, ARTICLE_PAGE(opt_a00_minimal));
TEST("guard/no_jsonld_without_site_url", FUN(() ,
    (ASSERT(!CONTAINS_SUB(out_g3, "application/ld+json")));
    (ASSERT(!CONTAINS_SUB(out_g3, "og:title")));
    (ASSERT(!CONTAINS_SUB(out_g3, "share-btn")));
    TRUE));

// g4：对照组 —— site_url 非空时这三样必须出现（否则 g3 是空断言）。
LET(out_g4, ARTICLE_PAGE(opt_a05_no_tags));
TEST("guard/jsonld_present_with_site_url", FUN(() ,
    (ASSERT(CONTAINS_SUB(out_g4, "application/ld+json")));
    (ASSERT(CONTAINS_SUB(out_g4, "og:title")));
    (ASSERT(CONTAINS_SUB(out_g4, "share-btn")));
    TRUE));

// g5：mermaid 只在文章页（独立页 Python 侧没传 mermaid_script）。
TEST("guard/mermaid_only_on_article", FUN(() ,
    (ASSERT(CONTAINS_SUB(out_g3, "cdn.jsdelivr.net/npm/mermaid@10")));
    (ASSERT(!CONTAINS_SUB(out_g2, "mermaid")));
    TRUE));

// g6：enable_search=false ⇒ 导航里不得出现 /search.html。
LET(out_g6, ARTICLE_PAGE(opt_a13_features_off));
TEST("guard/no_search_link_when_disabled", FUN(() ,
    (ASSERT(!CONTAINS_SUB(out_g6, "/search.html")));
    TRUE));

// g7：对照组 —— 默认 config（enable_search=true）时导航里必须有 /search.html。
TEST("guard/search_link_by_default", FUN(() ,
    (ASSERT(CONTAINS_SUB(out_g3, "/search.html")));
    TRUE));

// ── 跑测试 ────────────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_article_page: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_article_page: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_article_page: FAILED"); PANIC("article_page tests failed")), NULL);
PRINT("test_article_page: OK");