LET(dir_write_source_w03, PATH_JOIN(_TD_, "ws_w03"));
MKDIRS(dir_write_source_w03);
LET(html_write_source_w03, PATH_JOIN(dir_write_source_w03, "2026-01-01-w.html"));
LET(content_write_source_w03, "no trailing newline");
