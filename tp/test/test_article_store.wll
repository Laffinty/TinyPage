// ── 反向守卫（卡 S2-1 的要求）─────────────────────────────────
// ① 路径穿越形态必须被拒
TEST("guard/traversal_rejected", FUN(() ,
    (ASSERT_EQ(AT_K(SAFE_PATH_CHECK("../etc/passwd", _BASE_), "ok", TRUE), FALSE));
    TRUE));
// ② 同前缀兄弟目录（pages-evil）必须被拒
//    ⚠ 基准 p13 的输入是 `../pages-evil/x.html`（含 `..` ⇒ D3 拒）。
//    单独的 `pages-evil/x.html` 不含 `..`，Python 视为 base 内的子目录 ⇒ 允许，
//    所以这里用**与基准相同的形态**，而不是裸的 pages-evil/x.html。
TEST("guard/sibling_prefix_rejected", FUN(() ,
    (ASSERT_EQ(AT_K(SAFE_PATH_CHECK("../pages-evil/x.html", _BASE_), "ok", TRUE), FALSE));
    TRUE));
// ③ 含 `..` 的输入即使落在 base 内也必须被拒（D3：词法判定不解析符号链接）
TEST("guard/dotdot_inside_base_rejected", FUN(() ,
    (ASSERT_EQ(AT_K(SAFE_PATH_CHECK("sub/../ok.html", _BASE_), "ok", TRUE), FALSE));
    TRUE));
// ④ 写入失败 ⇒ 不得留下半截文件（父目录不存在 ⇒ 原子写失败）
//    ⚠ 实现**不** MKDIRS（Python 的 write_source 也不建目录）
//    ⇒ 父目录不存在时 WRITE_FILE_ATOMIC 返回 ERR ⇒ ok=FALSE 且无残留。
LET(_BADPATH_, PATH_JOIN(_TD_, "no_such_dir/deep/x.html"));
LET(_BADR_, WRITE_SOURCE(_BADPATH_, "partial"));
TEST("guard/atomic_write_no_partial", FUN(() ,
    (ASSERT_EQ(AT_K(_BADR_, "ok", TRUE), FALSE));
    (ASSERT(!EXISTS(PATH_JOIN(_TD_, "no_such_dir/deep/x.md"))));
    TRUE));
// ⑤ 原子写成功后不留 .tmp 残留
MKDIRS(PATH_JOIN(_TD_, "tmpx"));
LET(_TMPR_, WRITE_SOURCE(PATH_JOIN(_TD_, "tmpx/x.html"), "body"));
TEST("guard/atomic_write_no_tmp_left", FUN(() ,
    (ASSERT(AT_K(_TMPR_, "ok", FALSE)));
    (ASSERT(!EXISTS(PATH_JOIN(_TD_, "tmpx/x.md.tmp"))));
    TRUE));

// ── 跑测试 ────────────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_article_store: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_article_store: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_article_store: FAILED"); PANIC("article_store tests failed")), NULL);
PRINT("test_article_store: OK");