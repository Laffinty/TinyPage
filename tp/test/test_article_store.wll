// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS", "TEMP_DIR"]);
IMPORT("wlwl:std.fs", ["MKDIRS", "WRITE_FILE", "READ_FILE", "PATH_JOIN", "PATH_DIR", "PATH_BASE", "PATH_CANONICAL", "EXISTS"]);
IMPORT("wlwl:std.encode", ["UTF8_DECODE"]);
IMPORT("./../lib/article_store.wll", ["DECODE_CONTENT", "DECODE_LEGACY_BODY", "META_VALUE", "SAFE_PATH_CHECK", "SOURCE_PATH", "UNESCAPE_TO_FIXPOINT", "VALIDATE_CONTENT", "VALIDATE_DATE_FORMAT", "VALIDATE_FILENAME", "VALIDATE_TITLE", "WRITE_SOURCE"]);

// ── 工具：重复构造字符串（基准里的大用例靠它展开）────────────────
// // 把 unit 重复 n 次（WLWL 没有 REPEAT 内建）
     LET(_REPEAT_, FUN((unit, n), (
               LET MUT(out, "");
               LET MUT(i, 0);
               WHILE(<(i, n), (
                    SET(out, +(out, unit));
                    SET(i, +(i, 1))
               ));
               out
     )));


// ── safe_path_check 的夹具（与基准生成器的 SAFE_PATH_FIXTURE 同一份）──
//   base 下有 ok.html / bad.exe / sub/a.txt 与 sub 目录；
//   另有**兄弟目录** pages-evil（前缀绕过用例用）。
LET(_TD_, TEMP_DIR());
LET(_BASE_, PATH_JOIN(_TD_, "pages"));
LET(_SIBLING_, PATH_JOIN(_TD_, "pages-evil"));
MKDIRS(PATH_JOIN(_BASE_, "sub"));
MKDIRS(_SIBLING_);
WRITE_FILE(PATH_JOIN(_BASE_, "ok.html"), "x");
WRITE_FILE(PATH_JOIN(_BASE_, "bad.exe"), "x");
WRITE_FILE(PATH_JOIN(_BASE_, "sub/a.txt"), "x");

