// safe_path_check 的 want 是 {ok, rel} ⇒ 分开断言
// ⚠ 基准里的 `{BASE}` 是**占位符**（Python 侧 substitute 成真实临时目录）
//   ⇒ 测试侧要替换成 `_BASE_` 表达式，否则绝对路径用例（p16/p17）对不上。
LET(in_safe_path_check_p00, "ok.html");
LET(want_safe_path_check_p00_ok, TRUE);
LET(want_safe_path_check_p00_rel, "ok.html");
LET(in_safe_path_check_p01, "sub/a.txt");
LET(want_safe_path_check_p01_ok, TRUE);
LET(want_safe_path_check_p01_rel, "sub/a.txt");
LET(in_safe_path_check_p02, "bad.exe");
LET(want_safe_path_check_p02_ok, FALSE);
LET(want_safe_path_check_p02_rel, NULL);
LET(in_safe_path_check_p03, "missing.exe");
LET(want_safe_path_check_p03_ok, TRUE);
LET(want_safe_path_check_p03_rel, "missing.exe");
LET(in_safe_path_check_p04, "sub");
LET(want_safe_path_check_p04_ok, TRUE);
LET(want_safe_path_check_p04_rel, "sub");
LET(in_safe_path_check_p05, "");
LET(want_safe_path_check_p05_ok, TRUE);
LET(want_safe_path_check_p05_rel, ".");
LET(in_safe_path_check_p06, ".");
LET(want_safe_path_check_p06_ok, TRUE);
LET(want_safe_path_check_p06_rel, ".");
LET(in_safe_path_check_p07, "ok.txt");
LET(want_safe_path_check_p07_ok, TRUE);
LET(want_safe_path_check_p07_rel, "ok.txt");
LET(in_safe_path_check_p08, "X.HTML");
LET(want_safe_path_check_p08_ok, TRUE);
LET(want_safe_path_check_p08_rel, "X.HTML");
LET(in_safe_path_check_p09, "dir/");
LET(want_safe_path_check_p09_ok, TRUE);
LET(want_safe_path_check_p09_rel, "dir");
LET(in_safe_path_check_p10, "a//b");
LET(want_safe_path_check_p10_ok, TRUE);
LET(want_safe_path_check_p10_rel, "a/b");
LET(in_safe_path_check_p11, "../etc/passwd");
LET(want_safe_path_check_p11_ok, FALSE);
LET(want_safe_path_check_p11_rel, NULL);
LET(in_safe_path_check_p12, "/../etc/passwd");
LET(want_safe_path_check_p12_ok, FALSE);
LET(want_safe_path_check_p12_rel, NULL);
LET(in_safe_path_check_p13, "../pages-evil/x.html");
LET(want_safe_path_check_p13_ok, FALSE);
LET(want_safe_path_check_p13_rel, NULL);
LET(in_safe_path_check_p14, "/../pages-evil/secret.txt");
LET(want_safe_path_check_p14_ok, FALSE);
LET(want_safe_path_check_p14_rel, NULL);
LET(in_safe_path_check_p15, "sub/../ok.html");
LET(want_safe_path_check_p15_ok, FALSE);
LET(want_safe_path_check_p15_rel, NULL);
LET(in_safe_path_check_p16, +(_BASE_, "/ok.html"));
LET(want_safe_path_check_p16_ok, TRUE);
LET(want_safe_path_check_p16_rel, "ok.html");
LET(in_safe_path_check_p17, +(_BASE_, "/../pages-evil/x.html"));
LET(want_safe_path_check_p17_ok, FALSE);
LET(want_safe_path_check_p17_rel, NULL);
// write_source 真写文件 ⇒ 每个用例用独立目录，避免互相覆盖
LET(dir_write_source_w00, PATH_JOIN(_TD_, "ws_w00"));
MKDIRS(dir_write_source_w00);
LET(html_write_source_w00, PATH_JOIN(dir_write_source_w00, "2026-01-01-x.html"));
LET(content_write_source_w00, "body\r\nline2\n");
LET(want_write_source_w00_md, "2026-01-01-x.md");
LET(want_write_source_w00_content, "body\r\nline2\n");
