    TRUE));
TEST("status_line/403", FUN(() ,
    (ASSERT_EQ(STATUS_LINE(403), "403 Forbidden"));
    TRUE));
TEST("status_line/404", FUN(() ,
    (ASSERT_EQ(STATUS_LINE(404), "404 Not Found"));
    TRUE));
TEST("status_line/405", FUN(() ,
    (ASSERT_EQ(STATUS_LINE(405), "405 Method Not Allowed"));
    TRUE));
TEST("status_line/409", FUN(() ,
    (ASSERT_EQ(STATUS_LINE(409), "409 Conflict"));
    TRUE));
TEST("status_line/429", FUN(() ,
    (ASSERT_EQ(STATUS_LINE(429), "429 Too Many Requests"));
    TRUE));
TEST("status_line/500", FUN(() ,
    (ASSERT_EQ(STATUS_LINE(500), "500 Internal Server Error"));
    TRUE));
TEST("status_line/503", FUN(() ,
    (ASSERT_EQ(STATUS_LINE(503), "503 Service Unavailable"));
    TRUE));

// ── 反向守卫（卡 S4-3 明确要求的三条 + 三条实现约束）───────────────
// ① 未登录访问 / ⇒ 入口必须 302（这里钉的是「MATCH_ROUTE 说这路径要会话」）
TEST("guard/anon_root_needs_session", FUN(() ,
    (ASSERT_EQ(AT_K(MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "path", "/")), "requires_session", FALSE), TRUE));
    TRUE));
// ② 未登录 PUT /create 也**先要会话**（不是 405、不是 403）—— 顺序守卫
TEST("guard/anon_put_needs_session_first", FUN(() ,
    (ASSERT_EQ(AT_K(MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "PUT"), "path", "/create")), "requires_session", FALSE), TRUE));
    TRUE));
// ③ CSRF 豁免**只有** /upload（app.py:89）；其余 POST 都不是豁免
TEST("guard/csrf_exempt_only_upload", FUN(() ,
    (ASSERT_EQ(AT_K(MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "path", "/upload")), "csrf_exempt", FALSE), TRUE));
    TRUE));
TEST("guard/csrf_exempt_not_create", FUN(() ,
    (ASSERT_EQ(AT_K(MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "path", "/create")), "csrf_exempt", TRUE), FALSE));
    TRUE));
TEST("guard/csrf_exempt_not_save", FUN(() ,
    (ASSERT_EQ(AT_K(MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "path", "/save")), "csrf_exempt", TRUE), FALSE));
    TRUE));
// ④ 登录页**不要**会话（否则未登录永远进不去 ⇒ 死循环）
TEST("guard/login_page_no_session", FUN(() ,
    (ASSERT_EQ(AT_K(MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "path", "/login")), "requires_session", TRUE), FALSE));
    TRUE));
// ⑤ 错误响应**不发** CSP（security.py:342 是 HTML 页专用）
TEST("guard/error_has_no_csp", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_error_404, "headers", DICT()), "Content-Security-Policy", "<absent>"), "<absent>"));
    TRUE));
TEST("guard/html_has_csp", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_html_csrf, "headers", DICT()), "Content-Security-Policy", "<absent>"), "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self';"));
    TRUE));
// ⑥ 重定向 body 必须为空（不能把页面塞进 302）
TEST("guard/redirect_body_empty", FUN(() ,
    (ASSERT_EQ(LEN(AT_K(resp_redirect_login, "body", "x")), 0));
    TRUE));
// ⑦ 只读工具：Cookie 解析「首个命中即停」/ 头取值大小写不敏感
LET(cv, COOKIE_VALUE(INDEX_SET(INDEX_SET(DICT(), "cookie", "x=1; csrf_token=FIRST; csrf_token=SECOND"), "prefix", "csrf_token=")));
TEST("guard/cookie_first_match", FUN(() ,
    (ASSERT_EQ(cv, "FIRST"));
    TRUE));
LET(hv, HEADER_VALUE(INDEX_SET(INDEX_SET(DICT(), "headers", INDEX_SET(DICT(), "content-type", "text/plain")), "name", "Content-Type")));
TEST("guard/header_lower_insensitive", FUN(() ,
    (ASSERT_EQ(hv, "text/plain"));
    TRUE));
// ⑧ 字段取值对齐 `post_data.get(k, [""])[0]`（多值时取第一个）
LET(ff, FORM_FIELD(INDEX_SET(INDEX_SET(DICT(), "fields", PARSE_FORM(INDEX_SET(DICT(), "body", "k=1&k=2"))), "key", "k")));
TEST("guard/form_field_first_value", FUN(() ,
    (ASSERT_EQ(ff, "1"));
    TRUE));
LET(ff_missing, FORM_FIELD(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "fields", DICT()), "key", "k"), "default", "dflt")));
TEST("guard/form_field_default", FUN(() ,
    (ASSERT_EQ(ff_missing, "dflt"));
    TRUE));
// ⑨ HEAD：body 清空但头一个不少（wsgiref / TCP_SERVE 的 HEAD 语义）
//   ⚠ 用**同一份 opts** 只换 method，才是「头不变」的严格对比
LET(head_base, INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "status", 200), "headers", INDEX_SET(DICT(), "Content-Type", "text/plain")), "body", "hello"));
LET(head_resp, BUILD_RESPONSE(head_base));
LET(head_resp2, BUILD_RESPONSE(INDEX_SET(head_base, "method", "HEAD")));
TEST("guard/head_body_empty", FUN(() ,
    (ASSERT_EQ(LEN(AT_K(head_resp2, "body", "x")), 0));
    TRUE));
TEST("guard/head_headers_kept", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(AT_K(head_resp2, "headers", DICT())), "|"), JOIN(KEYS(AT_K(head_resp, "headers", DICT())), "|")));
    TRUE));

// ── 跑测试 + 自己把关退出码 ─────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_http_util: ", LEN(records), " test(s) run");
LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"), " :: ", AT_K(rec, "error", ""))))));
PRINT("test_http_util: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_http_util: FAILED"); PANIC("http_util tests failed")), NULL);
PRINT("test_http_util: OK");