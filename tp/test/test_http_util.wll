    (ASSERT_EQ(JOIN(KEYS(form_no_value), "|"), ""));
    TRUE));
TEST("form/no_value/count", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(form_no_value)), 0));
    TRUE));
// empty_key —— 空键保留（parse_qs 也保留）（urllib.parse.parse_qs）
