// ── 请求体上限（app.py:58 / :324：判据是 `>` 不是 `>=`）─────────────
TEST("size/max_post_size_bytes", FUN(() ,
    (ASSERT_EQ(MAX_POST_SIZE(), 10485760));
    TRUE));
TEST("size/max_post_size_is_10mb", FUN(() ,
    (ASSERT_EQ(MAX_POST_SIZE(), *(10, 1048576)));
    TRUE));
// exactly_max —— body 字节数 == 阈值 ⇒ **不算超**（判据是 `>`）
TEST("size/exactly_max", FUN(() ,
    (ASSERT_EQ(FORM_TOO_LARGE(INDEX_SET(INDEX_SET(DICT(), "body", "abcde"), "max_bytes", 5)), FALSE));
    TRUE));
// one_over_max —— body 字节数 == 阈值+1 ⇒ 超
TEST("size/one_over_max", FUN(() ,
    (ASSERT_EQ(FORM_TOO_LARGE(INDEX_SET(INDEX_SET(DICT(), "body", "abcde"), "max_bytes", 4)), TRUE));
    TRUE));
// 缺省阈值就是 10MB（短体在缺省阈值下不可能超）
TEST("size/default_threshold_is_max", FUN(() ,
    (ASSERT_EQ(FORM_TOO_LARGE(INDEX_SET(DICT(), "body", "abcde")), FALSE));
    TRUE));

