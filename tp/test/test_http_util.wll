    (ASSERT_EQ(JOIN(KEYS(form_blank_only), "|"), ""));
    TRUE));
TEST("form/blank_only/count", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(form_blank_only)), 0));
    TRUE));
// no_value —— 无 `=` 的键 ⇒ 空值 ⇒ 剔除（Python 同）（D-HU-4）
