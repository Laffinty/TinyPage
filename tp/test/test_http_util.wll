    (ASSERT_EQ(JOIN(KEYS(form_blank_dropped), "|"), "a"));
    TRUE));
TEST("form/blank_dropped/count", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(form_blank_dropped)), 1));
    TRUE));
TEST("form/blank_dropped/a", FUN(() ,
    (ASSERT_EQ(AT_K(form_blank_dropped, "a", "<missing>"), "1"));
    TRUE));
// blank_only —— 只有空值 ⇒ 该键整体消失（D-HU-4）
