// ── 表单用例：键序 / 键数 / 每个键的值（多值用 "|" 拼）──────────────
// empty —— 空体 ⇒ 空字典（admin/app.py:322-323（CONTENT_LENGTH<=0 ⇒ {}））
TEST("form/empty/keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(form_empty), "|"), ""));
    TRUE));
TEST("form/empty/count", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(form_empty)), 0));
    TRUE));
// basic —— 两个字段（admin/app.py:317-329）
TEST("form/basic/keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(form_basic), "|"), "a|b"));
    TRUE));
TEST("form/basic/count", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(form_basic)), 2));
    TRUE));
TEST("form/basic/a", FUN(() ,
    (ASSERT_EQ(AT_K(form_basic, "a", "<missing>"), "1"));
    TRUE));
TEST("form/basic/b", FUN(() ,
    (ASSERT_EQ(AT_K(form_basic, "b", "<missing>"), "2"));
    TRUE));
// multi —— 同名多值 ⇒ ARRAY（parse_qs 的 list）（security.py:53 + app.py:247（post_data.get(k,[""])[0] 取第一个））
TEST("form/multi/keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(form_multi), "|"), "a|b"));
    TRUE));
TEST("form/multi/count", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(form_multi)), 2));
    TRUE));
TEST("form/multi/a", FUN(() ,
    (ASSERT_EQ(JOIN(AT_K(form_multi, "a", []), "|"), "1|3"));
    TRUE));
TEST("form/multi/b", FUN(() ,
    (ASSERT_EQ(AT_K(form_multi, "b", "<missing>"), "2"));
    TRUE));
// plus_and_percent —— `+` → 空格；percent-decode UTF-8（urllib.parse.parse_qs）
TEST("form/plus_and_percent/keys", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(form_plus_and_percent), "|"), "x|k"));
    TRUE));
TEST("form/plus_and_percent/count", FUN(() ,
    (ASSERT_EQ(LEN(KEYS(form_plus_and_percent)), 2));
    TRUE));
TEST("form/plus_and_percent/x", FUN(() ,
    (ASSERT_EQ(AT_K(form_plus_and_percent, "x", "<missing>"), "hello world"));
    TRUE));
TEST("form/plus_and_percent/k", FUN(() ,
    (ASSERT_EQ(AT_K(form_plus_and_percent, "k", "<missing>"), "中"));
    TRUE));
