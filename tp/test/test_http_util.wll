// tp/test/test_http_util.wll —— admin 路由/表单/响应的脱网测试（卡 S4-3）
//
// ⚠ 本文件由 tp/test/gen_test_http_util.py 生成 —— 请勿手改。
//
// 被测：tp/lib/http_util.wll 的 MATCH_ROUTE / PARSE_FORM / BUILD_RESPONSE 族。
// 基准：tp/test/fixtures/http_util_baseline.json
//   · 每条期望都带出处（app.py / responses.py / actions.py 行号）
//   · 生成期已与**真 Python** 对拍（AdminApp 分发 / parse_qs / responses.py）
//
// 本文件是**脱网**的：被测模块不碰 socket、不 import tls。
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS"]);
IMPORT("wlwl:std.str", ["JOIN", "CAT"]);
IMPORT("./../lib/http_util.wll", ["PARSE_FORM", "FORM_FIELD", "FORM_TOO_LARGE",
    "MAX_POST_SIZE", "MATCH_ROUTE", "COOKIE_VALUE", "HEADER_VALUE", "STATUS_LINE",
    "BUILD_RESPONSE", "TEXT_ERROR_RESPONSE", "JSON_ERROR_RESPONSE", "JSON_RESPONSE",
    "HTML_RESPONSE", "REDIRECT", "RATE_LIMIT_RESPONSE", "STATIC_RESPONSE"]);

// ── 预计算响应与路由判定（⚠ LET 不能放进 TEST 的 FUN 体）──────────
// resp_error_404 —— error_response：Content-Type text/plain + 5 安全头（admin/responses.py:23-28）
LET(resp_error_404, TEXT_ERROR_RESPONSE(404, "Not Found"));
// resp_error_405 —— 方法不符的身体串是 "Method not allowed"（app.py:163,178）（admin/app.py:163,178）
LET(resp_error_405, TEXT_ERROR_RESPONSE(405, "Method not allowed"));
// resp_error_403 —— CSRF 失败的 text/plain 形态（app.py:260）（admin/app.py:258-260）
LET(resp_error_403, TEXT_ERROR_RESPONSE(403, "CSRF validation failed"));
// resp_redirect_login —— redirect_response：Location + 5 安全头，body 空（admin/responses.py:17-20）
LET(resp_redirect_login, REDIRECT(INDEX_SET(DICT(), "location", "/login")));
// resp_json_error_403 —— CSRF 豁免路径的 JSON 403（app.py:255-257）（admin/app.py:253-257）
LET(resp_json_error_403, JSON_ERROR_RESPONSE(403, "CSRF validation failed"));
// resp_html_csrf —— html_response：Content-Type → 5 安全头 → CSRF cookie → CSP（admin/responses.py:39-55）
LET(resp_html_csrf, HTML_RESPONSE(INDEX_SET(INDEX_SET(DICT(), "body", "<b>x</b>"), "csrf_token", "TESTTOKEN0123456789")));
// resp_html_no_csrf —— 无 csrf_token ⇒ 不发 Set-Cookie（app.py:49-51）（admin/responses.py:49-51）
LET(resp_html_no_csrf, HTML_RESPONSE(INDEX_SET(DICT(), "body", "<b>x</b>")));
// resp_login_page —— 登录页头序：Content-Type → CSRF cookie → CSP → 5 安全头（与 html_response 相反，逐字照 app.py:231-235）（admin/app.py:226-237）
LET(resp_login_page, HTML_RESPONSE(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "body", "LOGIN"), "csrf_token", "TESTTOKEN0123456789"), "security_last", TRUE)));
// resp_redirect_theme —— set_theme 成功后 302 /theme（actions.py:365）（admin/actions.py:365）
LET(resp_redirect_theme, REDIRECT(INDEX_SET(DICT(), "location", "/theme")));
// resp_rate_limit —— app.py 内联构造的 429（无独立函数可对拍）（admin/app.py:132-140）
LET(resp_rate_limit, RATE_LIMIT_RESPONSE(INDEX_SET(DICT(), "retry_after", 42)));
// resp_static_asset —— 注入的 CSS/JS：**显式**给 Content-Length，缓存 3600s，免会话（admin/app.py:142-152）
LET(resp_static_asset, STATIC_RESPONSE(INDEX_SET(INDEX_SET(DICT(), "content_type", "text/css"), "body", "body{}")));

// route_get_login_anon —— 未登录也能进登录页（app.py:154-158）
LET(route_get_login_anon, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "path", "/login")));
// route_get_root_anon —— 未登录访问 / ⇒ 302 到 /login（app.py:169-171，卡 S4-3 反向守卫）
LET(route_get_root_anon, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "path", "/")));
// route_put_root_anon —— **会话检查先于 method**：未登录 PUT 也先 302（app.py:168-171）
LET(route_put_root_anon, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "PUT"), "path", "/")));
// route_get_protected_404_anon —— 未登录的 404 路径同样先 302（顺序证据）
LET(route_get_protected_404_anon, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "path", "/nope")));
// route_post_login_anon_no_csrf —— ⚠ /login 的 CSRF 失败是 **302 /login?error=1**（actions.py:388-389），不是 403
LET(route_post_login_anon_no_csrf, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "path", "/login")));
// route_post_create_sess_no_csrf —— 有会话 + 缺 CSRF ⇒ 403 text/plain（app.py:258-260）
LET(route_post_create_sess_no_csrf, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "path", "/create")));
// route_post_upload_sess_no_csrf —— CSRF 豁免路径的失败是 **JSON** 403（app.py:253-257）
LET(route_post_upload_sess_no_csrf, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "path", "/upload")));
// route_post_upload_sess_csrf —— 合法 CSRF 后进入 upload 动作 ⇒ 缺字段 400 JSON（actions.py:200-201）
LET(route_post_upload_sess_csrf, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "path", "/upload")));
// route_post_create_sess_csrf —— 合法 CSRF 后进入 create 动作 ⇒ 缺字段 400 text/plain（actions.py:48-49）
LET(route_post_create_sess_csrf, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "path", "/create")));
// route_post_unknown_sess —— 404 早于 CSRF 校验（app.py:242-244）
LET(route_post_unknown_sess, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "POST"), "path", "/nope")));
// route_put_unknown_sess —— 有会话后 method 不符 ⇒ 405（app.py:178）
LET(route_put_unknown_sess, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "PUT"), "path", "/nope")));
// route_get_unknown_sess —— 有会话 GET 未命中 ⇒ 404（app.py:186-188）
LET(route_get_unknown_sess, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "path", "/nope")));
// route_get_logout_anon —— GET /logout ⇒ 405（app.py:163，落在 /login /logout 分支里）
LET(route_get_logout_anon, MATCH_ROUTE(INDEX_SET(INDEX_SET(DICT(), "method", "GET"), "path", "/logout")));

// form_empty —— 空体 ⇒ 空字典
LET(form_empty, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", ""), "content_type", "application/x-www-form-urlencoded")));
// form_basic —— 两个字段
LET(form_basic, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "a=1&b=2"), "content_type", "application/x-www-form-urlencoded")));
// form_multi —— 同名多值 ⇒ ARRAY（parse_qs 的 list）
LET(form_multi, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "a=1&b=2&a=3"), "content_type", "application/x-www-form-urlencoded")));
// form_plus_and_percent —— `+` → 空格；percent-decode UTF-8
LET(form_plus_and_percent, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "x=hello+world&k=%E4%B8%AD"), "content_type", "application/x-www-form-urlencoded")));
// form_blank_dropped —— 空值剔除（keep_blank_values=False 缺省）
LET(form_blank_dropped, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "a=&a=1"), "content_type", "application/x-www-form-urlencoded")));
// form_blank_only —— 只有空值 ⇒ 该键整体消失
LET(form_blank_only, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "a="), "content_type", "application/x-www-form-urlencoded")));
// form_no_value —— 无 `=` 的键 ⇒ 空值 ⇒ 剔除（Python 同）
LET(form_no_value, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "bare"), "content_type", "application/x-www-form-urlencoded")));
// form_empty_key —— 空键保留（parse_qs 也保留）
LET(form_empty_key, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "=1"), "content_type", "application/x-www-form-urlencoded")));
// form_semicolon_literal —— `;` 不是分隔符（Python 3.13 的缺省 separator="&"）
LET(form_semicolon_literal, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "a=1;b=2"), "content_type", "application/x-www-form-urlencoded")));
// form_double_amp —— 连续 `&` 跳过空段
LET(form_double_amp, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "a=1&&b=2"), "content_type", "application/x-www-form-urlencoded")));
// form_csrf_shape —— csrf_token 就是普通字段
LET(form_csrf_shape, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "csrf_token=abc&t=1"), "content_type", "application/x-www-form-urlencoded")));
// form_bad_percent —— 非法 percent ⇒ **空表单**（Python 原样保留 %ZZ，D-HU-3）
LET(form_bad_percent, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "a=%ZZ"), "content_type", "application/x-www-form-urlencoded")));
// form_multipart_rejected —— 非 urlencoded ⇒ **空表单**（Python 不判这个头，D-HU-2）
LET(form_multipart_rejected, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "a=1"), "content_type", "multipart/form-data; boundary=x")));
// form_no_ct_header —— 无 Content-Type ⇒ 按 urlencoded 处理
LET(form_no_ct_header, PARSE_FORM(INDEX_SET(INDEX_SET(DICT(), "body", "a=1"), "content_type", "")));

