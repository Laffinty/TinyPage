LET(want_search_disabled, "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n\n<meta name=\"theme-color\" content=\"#2c3e50\" media=\"(prefers-color-scheme: light)\"><meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: dark)\">\n\n<meta name=\"description\" content=\"搜索站内文章\">\n\n\n<link rel=\"manifest\" href=\"/manifest.json\">\n<title>搜索 - TinyPage</title>\n<style>\nbody{color:#222}\n</style>\n\n\n</head>\n<body>\n<div class=\"container\">\n  <header class=\"site-header\">\n    <a href=\"/\" class=\"site-title\">TinyPage</a>\n    <nav class=\"site-nav\" aria-label=\"站点导航\">\n      <a href=\"/\">首页</a>\n      \n    </nav>\n  </header>\n  <main>\n<h1 class=\"page-title\">搜索文章</h1>\n    <div class=\"search-box\">\n      <input type=\"search\" id=\"search-input\" placeholder=\"输入关键词...\" autocomplete=\"off\" aria-label=\"搜索关键词\">\n      <div id=\"search-results\" class=\"search-results\"></div>\n    </div>\n  </main>\n  <footer class=\"site-footer\">\n    <p>Powered by TinyPage</p>\n  </footer>\n</div>\n\n\n</body>\n</html>");

// search_vt_meta_dropped —— ⚠ 搜索页把 vt_meta 显式传成 ""（generator.py:421），**即使** enable_view_transitions=True ⇒ 输出里没有 view-transition meta。这是与列表/分类页的一个真实差异。
LET(o_search_vt_meta_dropped, INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "config", INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "site_title", "TinyPage"), "site_description", "A modern static blog"), "site_url", ""), "site_author", ""), "footer_text", "Powered by TinyPage"), "lang", "zh-CN"), "theme_name", "default"), "page_size", 10), "enable_pwa", TRUE), "enable_dark_mode", TRUE), "enable_search", TRUE), "enable_rss", TRUE), "enable_sitemap", TRUE), "enable_view_transitions", TRUE), "pwa_short_name", "TinyPage"), "pwa_theme_color", "#2c3e50"), "pwa_bg_color", "#ffffff")), "theme_css", "body{color:#222}"), "dark_css", ""), "has_dark", FALSE), "standalones", []));
LET(iserr_search_vt_meta_dropped, IS_ERR(SEARCH_PAGE(o_search_vt_meta_dropped)));
LET(out_search_vt_meta_dropped, IF(iserr_search_vt_meta_dropped, "", SEARCH_PAGE(o_search_vt_meta_dropped)));
LET(want_search_vt_meta_dropped, "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n\n<meta name=\"theme-color\" content=\"#2c3e50\" media=\"(prefers-color-scheme: light)\"><meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: dark)\">\n\n<meta name=\"description\" content=\"搜索站内文章\">\n\n\n<link rel=\"manifest\" href=\"/manifest.json\">\n<title>搜索 - TinyPage</title>\n<style>\nbody{color:#222}\n</style>\n\n\n</head>\n<body>\n<div class=\"container\">\n  <header class=\"site-header\">\n    <a href=\"/\" class=\"site-title\">TinyPage</a>\n    <nav class=\"site-nav\" aria-label=\"站点导航\">\n      <a href=\"/\">首页</a>\n      <a href=\"/search.html\" aria-current=\"page\">搜索</a>\n      \n    </nav>\n  </header>\n  <main>\n<h1 class=\"page-title\">搜索文章</h1>\n    <div class=\"search-box\">\n      <input type=\"search\" id=\"search-input\" placeholder=\"输入关键词...\" autocomplete=\"off\" aria-label=\"搜索关键词\">\n      <div id=\"search-results\" class=\"search-results\"></div>\n    </div>\n  </main>\n  <footer class=\"site-footer\">\n    <p>Powered by TinyPage</p>\n  </footer>\n</div>\n<script src=\"/search.js\" defer></script>\n\n</body>\n</html>");

// ── 逐字节对照 ────────────────────────────────────────────────
TEST("list_page/list_single_page", FUN((),
    (ASSERT_EQ(out_list_single_page, want_list_single_page));
    TRUE));
TEST("list_page/list_page2_prev_root", FUN((),
    (ASSERT_EQ(out_list_page2_prev_root, want_list_page2_prev_root));
    TRUE));
TEST("list_page/list_page3_next_empty", FUN((),
    (ASSERT_EQ(out_list_page3_next_empty, want_list_page3_next_empty));
    TRUE));
TEST("list_page/list_empty", FUN((),
    (ASSERT_EQ(out_list_empty, want_list_empty));
    TRUE));
TEST("list_page/list_escape", FUN((),
    (ASSERT_EQ(out_list_escape, want_list_escape));
    TRUE));
TEST("list_page/list_dollar", FUN((),
    (ASSERT_EQ(out_list_dollar, want_list_dollar));
    TRUE));
TEST("list_page/list_long_title", FUN((),
    (ASSERT_EQ(out_list_long_title, want_list_long_title));
    TRUE));
TEST("list_page/list_tags_spaces_only", FUN((),
    (ASSERT_EQ(out_list_tags_spaces_only, want_list_tags_spaces_only));
    TRUE));
TEST("list_page/list_dark_standalones", FUN((),
    (ASSERT_EQ(out_list_dark_standalones, want_list_dark_standalones));
    TRUE));
TEST("list_page/category_normal", FUN((),
    (ASSERT_EQ(out_category_normal, want_category_normal));
    TRUE));
TEST("list_page/category_empty", FUN((),
    (ASSERT_EQ(out_category_empty, want_category_empty));
    TRUE));
TEST("list_page/category_escape", FUN((),
    (ASSERT_EQ(out_category_escape, want_category_escape));
    TRUE));
TEST("list_page/search_default", FUN((),
    (ASSERT_EQ(out_search_default, want_search_default));
    TRUE));
TEST("list_page/search_disabled", FUN((),
    (ASSERT_EQ(out_search_disabled, want_search_disabled));
    TRUE));
TEST("list_page/search_vt_meta_dropped", FUN((),
    (ASSERT_EQ(out_search_vt_meta_dropped, want_search_vt_meta_dropped));
    TRUE));

// ── 运行时反向守卫 ────────────────────────────────────────────
// ① 标题里的 <script> 必须被 escape —— 不得原样出现
TEST("guard/title_script_escaped", FUN((),
    (ASSERT(!(CONTAINS_SUB(out_list_escape, "<script>alert(1)</script>")),
            "raw <script> leaked into list page");
     ASSERT(CONTAINS_SUB(out_list_escape, "&lt;script&gt;alert(1)&lt;/script&gt;"),
            "escaped title form missing"));
    TRUE));
// ② 分类名里的 <A&B<script>> 必须被 escape（h1 / <title> / meta 三处）
TEST("guard/category_escaped", FUN((),
    (ASSERT(!(CONTAINS_SUB(out_category_escape, "<A&B<script>>")),
            "raw category leaked into category page");
     ASSERT(CONTAINS_SUB(out_category_escape, "&lt;A&amp;B&lt;script&gt;&gt;"),
            "escaped category form missing"));
    TRUE));
// ③ `$` 必须原样输出（WLWL 字面量插值不得泄漏进产物）
TEST("guard/dollar_literal", FUN((),
    (ASSERT(CONTAINS_SUB(out_list_dollar, "Price \$5 and \${x}"),
            "dollar text mangled by string interpolation");
     ASSERT(CONTAINS_SUB(out_list_dollar, "cost \$9"),
            "dollar in summary mangled"));
    TRUE));
// ④ 分页语义：第 2 页的 prev_url 必须指向 "/"（不是 /list/1.html）
TEST("guard/page2_prev_root", FUN((),
    (ASSERT(CONTAINS_SUB(out_list_page2_prev_root, "<a href=\"/\" class=\"prev\">"),
            "page 2 prev link must point at /");
     ASSERT(!(CONTAINS_SUB(out_list_page2_prev_root, "/list/1.html")),
            "page 2 must not link to /list/1.html"));
    TRUE));
// ⑤ enable_search=False：搜索页不得有 search.js，nav 里也不得有「搜索」
TEST("guard/search_disabled", FUN((),
    (ASSERT(!(CONTAINS_SUB(out_search_disabled, "/search.js")),
            "search script leaked while enable_search=False");
     ASSERT(!(CONTAINS_SUB(out_search_disabled, ">搜索</a>")),
            "search nav link leaked while enable_search=False"));
    TRUE));
// ⑥ enable_search=True：同一个位置必须有 search.js（与 ⑤ 成对）
TEST("guard/search_enabled", FUN((),
    (ASSERT(CONTAINS_SUB(out_search_default, "/search.js"),
            "search script missing while enable_search=True"));
    TRUE));

// ── 跑测试 ────────────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_list_page: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_list_page: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_list_page: FAILED"); PANIC("list_page tests failed")), NULL);
PRINT("test_list_page: OK");