// search_default —— enable_search=True：nav 里有「搜索」并带 aria-current（current_path 是 "/search.html"）、body 末尾有 search.js。
LET(o_search_default, INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "config", INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "site_title", "TinyPage"), "site_description", "A modern static blog"), "site_url", ""), "site_author", ""), "footer_text", "Powered by TinyPage"), "lang", "zh-CN"), "theme_name", "default"), "page_size", 10), "enable_pwa", TRUE), "enable_dark_mode", TRUE), "enable_search", TRUE), "enable_rss", TRUE), "enable_sitemap", TRUE), "enable_view_transitions", TRUE), "pwa_short_name", "TinyPage"), "pwa_theme_color", "#2c3e50"), "pwa_bg_color", "#ffffff")), "theme_css", "body{color:#222}"), "dark_css", ""), "has_dark", FALSE), "standalones", []));
