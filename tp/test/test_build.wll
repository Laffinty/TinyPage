// tp/test/test_build.wll —— 构建编排层端到端逐字节对照 + 反向守卫
//
// ⚠ 本文件由 tp/test/gen_test_build.py 生成 —— 请勿手改。
//
// 做法：在 TEMP_DIR() 里用夹具内联的语料重建同一棵树 → BUILD → 逐文件比 sha256。
// 基准：tp/test/fixtures/build_baseline.json（真 Python generate_static_pages 产出）
//
// ⚠ 夹具里没有绝对路径：语料按「相对站点的 POSIX 路径 → 内容」内联，
//   测试自己把它们拼到 TEMP_DIR() 下（跨机器可复现，CI 上同样是临时目录）。

IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "TEMP_DIR", "RUN_TESTS"]);
IMPORT("wlwl:std.str", ["CAT", "CONTAINS_SUB"]);
IMPORT("wlwl:std.regex", ["RE", "RE_FIND_ALL"]);
IMPORT("wlwl:std.encode", ["SHA256"]);
IMPORT("wlwl:std.fs", ["READ_FILE", "WRITE_FILE_ATOMIC", "MKDIRS", "PATH_JOIN", "WALK_DIR", "FILE_META"]);
IMPORT("./../bin/build.wll", ["BUILD"]);

// ── 小工具 ────────────────────────────────────────────────────────
// ⚠ `LET(r, READ_FILE(p))` / `LET(r, WRITE_FILE_ATOMIC(...))` 绑定**不算消费**
//   ERR（坑 25）⇒ 一律直接放进 IS_ERR(...)。
LET(PUT_FILE, FUN((p, c), (
     IF(IS_ERR(WRITE_FILE_ATOMIC(p, c)), (PANIC(CAT("write failed: ", p))), NULL)
)));
LET(PUT_DIR, FUN((p), (
     IF(IS_ERR(MKDIRS(p)), (PANIC(CAT("mkdir failed: ", p))), NULL)
)));
LET(READ_OR_SPENT, FUN((p), (
     IF(IS_ERR(READ_FILE(p)), "", READ_FILE(p))
)));
// `WALK_DIR` 的结果**含目录条目**（实测：4 个目录 + 40 个文件 = 44 条）
// ⇒ 要按「只留文件」过滤，才与基准的文件清单同形。
LET(TST_IS_DIR, FUN((p), (
     IF(IS_ERR(FILE_META(p)), TRUE,
          AT_K(FILE_META(p), "is_dir", TRUE))
)));
LET(TST_WALK_FILES, FUN((dir), (
     LET(all, IF(IS_ERR(WALK_DIR(dir)), [], WALK_DIR(dir)));
     LET MUT(out, []);
     FOR(e, all, (
          IF(TST_IS_DIR(PATH_JOIN(dir, e)), NULL, (SET(out, +(out, [e]))))
     ));
     out
)));

// ── 造语料（与基准同一份 spec）──────────────────────────────────────
LET(root, TEMP_DIR());
LET(out_dir, PATH_JOIN(root, "pages"));
PUT_DIR(PATH_JOIN(root, "pages/article"));
PUT_DIR(PATH_JOIN(root, "pages/standalone"));
PUT_DIR(PATH_JOIN(root, "themes/default"));

