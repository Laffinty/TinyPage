// ── 反向守卫 ──────────────────────────────────────────────────────
// g1：草稿**不得**出现在任何列表类产物里（编排层过滤的唯一判据）。
TEST("guard/draft_absent_from_index", FUN(() ,
    (ASSERT(!CONTAINS_SUB(i_index, "2026-03-02-draft-wip.html")));
    (ASSERT(!CONTAINS_SUB(i_index, "草稿")));
    TRUE));
TEST("guard/draft_absent_from_list2", FUN(() ,
    (ASSERT(!CONTAINS_SUB(i_list2, "2026-03-02-draft-wip.html")));
    (ASSERT(!CONTAINS_SUB(i_list2, "草稿")));
    TRUE));
TEST("guard/draft_absent_from_rss", FUN(() ,
    (ASSERT(!CONTAINS_SUB(i_rss, "2026-03-02-draft-wip.html")));
    (ASSERT(!CONTAINS_SUB(i_rss, "草稿")));
    TRUE));
TEST("guard/draft_absent_from_sitemap", FUN(() ,
    (ASSERT(!CONTAINS_SUB(i_sitemap, "2026-03-02-draft-wip.html")));
    (ASSERT(!CONTAINS_SUB(i_sitemap, "草稿")));
    TRUE));
TEST("guard/draft_absent_from_search_index", FUN(() ,
    (ASSERT(!CONTAINS_SUB(i_sidx, "2026-03-02-draft-wip.html")));
    (ASSERT(!CONTAINS_SUB(i_sidx, "草稿")));
    TRUE));

// g1b：对照组 —— 已发布文章**必须**出现在同样的产物里（否则 g1 是空断言）。
TEST("guard/published_present_in_index", FUN(() ,
    (ASSERT(CONTAINS_SUB(i_index, "2026-02-24-pagination.html")));
    TRUE));
TEST("guard/published_present_in_rss", FUN(() ,
    (ASSERT(CONTAINS_SUB(i_rss, "2026-02-24-pagination.html")));
    TRUE));
TEST("guard/published_present_in_sitemap", FUN(() ,
    (ASSERT(CONTAINS_SUB(i_sitemap, "2026-02-24-pagination.html")));
    TRUE));
TEST("guard/published_present_in_search_index", FUN(() ,
    (ASSERT(CONTAINS_SUB(i_sidx, "2026-02-24-pagination.html")));
    TRUE));
TEST("guard/published_present_in_list2", FUN(() ,
    (ASSERT(CONTAINS_SUB(i_list2, "2026-01-05-site-launch.html")));
    (ASSERT(!CONTAINS_SUB(i_list2, "2026-02-24-pagination.html")));
    TRUE));

// g2：草稿 html 必须保持语料原样（它不进 list_articles ⇒ 不会被重新生成）。
TEST("guard/draft_html_untouched", FUN(() ,
    (ASSERT(ASSERT_EQ(SHA256(i_draft), "155c1d3f24be5f76a84d8e4cf4f6b2d24bfb3319423c0e048b8b56cff392bcfa")));
    (ASSERT(CONTAINS_SUB(i_draft, "旧正文占位")));
    TRUE));

// g2b：对照组 —— 已发布文章的 html 必须**不再**含语料里的占位正文，
//      且必须是「整页」（骨架 + 元数据头都在）⇒ 它真的被重新生成过。
TEST("guard/published_html_regenerated", FUN(() ,
    (ASSERT(!CONTAINS_SUB(i_pub, "旧正文占位")));
    (ASSERT(CONTAINS_SUB(i_pub, "class=\"post-title\"")));
    (ASSERT(CONTAINS_SUB(i_pub, "<!-- status: published -->")));
    TRUE));

// g3：rss 的 <item> 恰好等于已发布篇数（14 篇语料里 1 篇草稿）。
TEST("guard/rss_item_count", FUN(() ,
    (ASSERT(ASSERT_EQ(n_items, 13)));
    TRUE));

// g4：sitemap 的 <url> 数 == 1（根） + 文章数 + 独立页数 + 分类数。
LET(n_loc, LEN(RE_FIND_ALL(RE("[<]loc[>]"), i_sitemap)));
TEST("guard/sitemap_url_count", FUN(() ,
    (ASSERT(ASSERT_EQ(n_loc, 19)));
    TRUE));

// g5：BUILD 不得改坏 .md 源文件（内容与语料相同即通过）。
TEST("guard/md_sources_intact", FUN(() ,
    (ASSERT(ASSERT_EQ(SHA256(f1), "03f33a9e012a05855515cfb91c5f401b5d869ed556292784d5aa2875f0b4ad64")));
    TRUE));

// ── 跑测试（RUN_TESTS 的失败不影响退出码 ⇒ 自己把关）──────────────────
LET(records, RUN_TESTS());
PRINT("test_build: ", LEN(records), " test(s) run");
LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE), NULL,
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_build: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_build: FAILED"); PANIC("build tests failed")), NULL);
PRINT("test_build: OK");