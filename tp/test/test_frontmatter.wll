LET(want_mh_empty_fields, "<!-- title:  -->\n<!-- date:  -->\n<!-- slug:  -->\n<!-- tags:  -->\n<!-- summary:  -->\n<!-- category:  -->\n<!-- status:  -->\n");

// mh_newline_flatten: ['a\nb', 'D', 'S', 'G', 'x\r\ny', 'C', 'published']
LET(want_mh_newline_flatten, "<!-- title: a b -->\n<!-- date: D -->\n<!-- slug: S -->\n<!-- tags: G -->\n<!-- summary: x y -->\n<!-- category: C -->\n<!-- status: published -->\n");

