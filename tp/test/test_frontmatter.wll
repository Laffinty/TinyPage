LET(want_mh_apostrophe, "<!-- title: it&#x27;s -->\n<!-- date: D -->\n<!-- slug: S -->\n<!-- tags: G -->\n<!-- summary: U -->\n<!-- category: C -->\n<!-- status: published -->\n");

