// ── meta_header 用例 ───────────────────────────────────
TEST("fm/meta_header/mh_apostrophe", FUN(() ,
    (ASSERT_EQ(META_HEADER("it's", "D", "S", "G", "U", "C", "published"), want_mh_apostrophe));
    TRUE));
TEST("fm/meta_header/mh_basic", FUN(() ,
    (ASSERT_EQ(META_HEADER("标题", "2026-01-01", "slug-1", "a, b", "sum", "cat", "draft"), want_mh_basic));
    TRUE));
TEST("fm/meta_header/mh_empty_fields", FUN(() ,
    (ASSERT_EQ(META_HEADER("", "", "", "", "", "", ""), want_mh_empty_fields));
    TRUE));
TEST("fm/meta_header/mh_newline_flatten", FUN(() ,
    (ASSERT_EQ(META_HEADER("a\nb", "D", "S", "G", "x\r\ny", "C", "published"), want_mh_newline_flatten));
    TRUE));

// ── 反向守卫 ──────────────────────────────────────────
// 8 行输入：slug 在第 8 行 ⇒ 不得读入（前 7 行规则）
LET(src_g1, "<!-- title: t -->\n<!-- date: d -->\n<!-- tags: a -->\n<!-- summary: s -->\n<!-- category: c -->\n<!-- status: draft -->\n<!-- markdown: m -->\n<!-- slug: toolate -->\n");
LET(want_g1, ["category": "c", "date": "d", "markdown": "m", "status": "draft", "summary": "s", "tags": "a", "title": "t"]);
TEST("fm/guard/line8_not_read", FUN(() ,
    (ASSERT_EQ(PARSE_META(src_g1), want_g1));
    (ASSERT_EQ(HAS(PARSE_META(src_g1), "slug"), FALSE));
    TRUE));

// 白名单外的 bogus 键静默丢弃
LET(src_g2, "<!-- title: t -->\n<!-- bogus: x -->\n<!-- date: d -->\n");
LET(want_g2, ["date": "d", "status": "published", "title": "t"]);
TEST("fm/guard/non_whitelist_dropped", FUN(() ,
    (ASSERT_EQ(PARSE_META(src_g2), want_g2));
    (ASSERT_EQ(HAS(PARSE_META(src_g2), "bogus"), FALSE));
    TRUE));

// [\r\n]+ 是「一个或多个连续换行符」⇒ "a\n\n\nb" → "a b"
TEST("fm/guard/newline_collapse", FUN(() ,
    (ASSERT_EQ(META_VALUE("a\n\n\nb"), "a b"));
    TRUE));

// 单引号 → &#x27;（不是 WLWL 内建 HTML_ESCAPE 的 &#39;）
TEST("fm/guard/apostrophe_x27", FUN(() ,
    (ASSERT_EQ(META_VALUE("it's"), "it&#x27;s"));
    TRUE));

// (.*) 贪婪：title 的值吃到最后一个 --> 之前 ⇒ "a --> tail"
TEST("fm/guard/greedy_tail", FUN(() ,
    (ASSERT_EQ(AT_K(PARSE_META("<!-- title: a --> tail -->\n"), "title", "?"), "a --> tail"));
    TRUE));

// ── 跑测试 ──────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_frontmatter: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_frontmatter: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_frontmatter: FAILED"); PANIC("frontmatter tests failed")), NULL);
PRINT("test_frontmatter: OK");