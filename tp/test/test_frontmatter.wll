// ── parse_meta 基准用例（复刻的 parse_meta_from_text） ──
// pm_bogus_dropped: '<!-- title: t -->\n<!-- bogus: x -->\n<!-- date: 2026-03-03 -->\n'
LET(src_pm_bogus_dropped, "<!-- title: t -->\n<!-- bogus: x -->\n<!-- date: 2026-03-03 -->\n");
LET(want_pm_bogus_dropped, ["date": "2026-03-03", "status": "published", "title": "t"]);

// pm_colon_in_value: '<!-- summary: x: y -->\n'
LET(src_pm_colon_in_value, "<!-- summary: x: y -->\n");
LET(want_pm_colon_in_value, ["status": "published", "summary": "x: y"]);

// pm_crlf: '<!-- title: t -->\r\n<!-- date: d -->\r\n<!-- tags: a -->\r\n'
LET(src_pm_crlf, "<!-- title: t -->\r\n<!-- date: d -->\r\n<!-- tags: a -->\r\n");
LET(want_pm_crlf, ["date": "d", "status": "published", "tags": "a", "title": "t"]);

// pm_dash_value: '<!-- status: -->\n'
LET(src_pm_dash_value, "<!-- status: -->\n");
LET(want_pm_dash_value, ["status": "published"]);

// pm_default_status: '<!-- title: t -->\n<!-- date: d -->\n<!-- tags: a -->\n'
LET(src_pm_default_status, "<!-- title: t -->\n<!-- date: d -->\n<!-- tags: a -->\n");
LET(want_pm_default_status, ["date": "d", "status": "published", "tags": "a", "title": "t"]);

// pm_empty: ''
LET(src_pm_empty, "");
LET(want_pm_empty, ["status": "published"]);

// pm_full_7keys: '<!-- title: T -->\n<!-- date: 2026-01-01 -->\n<!-- slug: s-1 -->\n<!-- tags: a, b -->\n<!-- summary: sum -->\n<!-- markdown: body -->\n<!-- status: draft -->\n'
LET(src_pm_full_7keys, "<!-- title: T -->\n<!-- date: 2026-01-01 -->\n<!-- slug: s-1 -->\n<!-- tags: a, b -->\n<!-- summary: sum -->\n<!-- markdown: body -->\n<!-- status: draft -->\n");
LET(want_pm_full_7keys, ["date": "2026-01-01", "markdown": "body", "slug": "s-1", "status": "draft", "summary": "sum", "tags": "a, b", "title": "T"]);

// pm_full_category: '<!-- title: 标题 -->\n<!-- date: 2026-02-02 -->\n<!-- slug: slug-2 -->\n<!-- tags: x -->\n<!-- summary: 摘要 -->\n<!-- category: cat -->\n<!-- status: published -->\n'
LET(src_pm_full_category, "<!-- title: 标题 -->\n<!-- date: 2026-02-02 -->\n<!-- slug: slug-2 -->\n<!-- tags: x -->\n<!-- summary: 摘要 -->\n<!-- category: cat -->\n<!-- status: published -->\n");
LET(want_pm_full_category, ["category": "cat", "date": "2026-02-02", "slug": "slug-2", "status": "published", "summary": "摘要", "tags": "x", "title": "标题"]);

// pm_greedy_tail: '<!-- title: a --> tail -->\n'
LET(src_pm_greedy_tail, "<!-- title: a --> tail -->\n");
LET(want_pm_greedy_tail, ["status": "published", "title": "a --> tail"]);

// pm_indented_line: '    <!-- title:  hello world  -->   \n'
LET(src_pm_indented_line, "    <!-- title:  hello world  -->   \n");
LET(want_pm_indented_line, ["status": "published", "title": "hello world"]);

// pm_line8_ignored: '<!-- title: t -->\n\n\n\n\n\n\n<!-- slug: toolate -->\n'
LET(src_pm_line8_ignored, "<!-- title: t -->\n\n\n\n\n\n\n<!-- slug: toolate -->\n");
LET(want_pm_line8_ignored, ["status": "published", "title": "t"]);

// pm_no_match: 'just text\nmore text\n'
LET(src_pm_no_match, "just text\nmore text\n");
LET(want_pm_no_match, ["status": "published"]);

// pm_overflow10: '<!-- title: first -->\n<!-- date: d -->\n<!-- slug: s -->\n<!-- tags: a -->\n<!-- summary: sum -->\n<!-- category: c -->\n<!-- status: draft -->\n<!-- title: later -->\n<!-- slug: even-later -->\n<!-- bogus: nope -->\n'
LET(src_pm_overflow10, "<!-- title: first -->\n<!-- date: d -->\n<!-- slug: s -->\n<!-- tags: a -->\n<!-- summary: sum -->\n<!-- category: c -->\n<!-- status: draft -->\n<!-- title: later -->\n<!-- slug: even-later -->\n<!-- bogus: nope -->\n");
LET(want_pm_overflow10, ["category": "c", "date": "d", "slug": "s", "status": "draft", "summary": "sum", "tags": "a", "title": "first"]);

// pm_roundtrip_escaped: '<!-- title: T &amp; &#x27;x&#x27; -->\n<!-- date: 2026-01-01 -->\n<!-- slug: slug-1 -->\n<!-- tags: a, b -->\n<!-- summary: sum mary -->\n<!-- category: cat -->\n<!-- status: draft -->\n'
LET(src_pm_roundtrip_escaped, "<!-- title: T &amp; &#x27;x&#x27; -->\n<!-- date: 2026-01-01 -->\n<!-- slug: slug-1 -->\n<!-- tags: a, b -->\n<!-- summary: sum mary -->\n<!-- category: cat -->\n<!-- status: draft -->\n");
LET(want_pm_roundtrip_escaped, ["category": "cat", "date": "2026-01-01", "slug": "slug-1", "status": "draft", "summary": "sum mary", "tags": "a, b", "title": "T &amp; &#x27;x&#x27;"]);

// pm_roundtrip_status_blank: '<!-- title: T -->\n<!-- date: D -->\n<!-- slug: S -->\n<!-- tags: G -->\n<!-- summary: U -->\n<!-- category: C -->\n<!-- status:  -->\n'
LET(src_pm_roundtrip_status_blank, "<!-- title: T -->\n<!-- date: D -->\n<!-- slug: S -->\n<!-- tags: G -->\n<!-- summary: U -->\n<!-- category: C -->\n<!-- status:  -->\n");
LET(want_pm_roundtrip_status_blank, ["category": "C", "date": "D", "slug": "S", "status": "published", "summary": "U", "tags": "G", "title": "T"]);

// pm_unclosed: '<!-- title: x\n'
LET(src_pm_unclosed, "<!-- title: x\n");
LET(want_pm_unclosed, ["status": "published"]);

// pm_value_inner_spaces: '<!-- summary: a  b -->\n'
LET(src_pm_value_inner_spaces, "<!-- summary: a  b -->\n");
LET(want_pm_value_inner_spaces, ["status": "published", "summary": "a  b"]);

