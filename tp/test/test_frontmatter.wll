LET(want_mh_basic, "<!-- title: 标题 -->\n<!-- date: 2026-01-01 -->\n<!-- slug: slug-1 -->\n<!-- tags: a, b -->\n<!-- summary: sum -->\n<!-- category: cat -->\n<!-- status: draft -->\n");

