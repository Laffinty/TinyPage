// ── 反向守卫 ──────────────────────────────────────────────────
// ① site_url 为空 ⇒ 不得输出 JSON-LD
TEST("guard/json_ld_absent_without_site_url", FUN(() ,
    (ASSERT_EQ(JSON_LD(INDEX_SET(DICT(), "title", "T")), ""));
    TRUE));
// ② 导航栏第一项必须是首页链接（顺序不得颠倒）
//    ⚠ `LET` 必须放在 TEST 之外 —— 放进 FUN 体里会让括号层级算错（实测 E0011）
LET(_nav_g_, NAV_LINKS(INDEX_SET(DICT(), "cfg", DICT())));
TEST("guard/nav_starts_with_home", FUN(() ,
    (ASSERT_EQ(SUB(_nav_g_, 0, 12), "<a href=\"/\">"));
    TRUE));
// ③ has_dark 为假 ⇒ theme_toggle 必须是空串（不得残留按钮）
LET(_ctx_g_, COMMON_CONTEXT(INDEX_SET(INDEX_SET(DICT(), "has_dark", FALSE),
    "config", DICT())));
TEST("guard/no_toggle_without_dark", FUN(() ,
    (ASSERT_EQ(AT_K(_ctx_g_, "theme_toggle", "?"), ""));
    TRUE));

LET(records, RUN_TESTS());
PRINT("test_page_common: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_page_common: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_page_common: FAILED"); PANIC("page_common tests failed")), NULL);
PRINT("test_page_common: OK");