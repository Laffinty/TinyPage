LET(want_j01_with_tags, "<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"标题 & \\\"引号\\\"\", \"description\": \"描述\", \"url\": \"https://example.com/article/2026-01-01-x.html\", \"datePublished\": \"2026-01-02T10:00\", \"author\": {\"@type\": \"Person\", \"name\": \"Anonymous\"}, \"publisher\": {\"@type\": \"Organization\", \"name\": \"https://example.com/\"}, \"keywords\": \"wlwl, 静态站点\"}</script>");
LET(want_j02_no_tags_author, "<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"T\", \"description\": \"D\", \"url\": \"https://example.com/article/s.html\", \"datePublished\": \"2026-01-02T10:00\", \"author\": {\"@type\": \"Person\", \"name\": \"张三\"}, \"publisher\": {\"@type\": \"Organization\", \"name\": \"https://example.com\"}}</script>");
