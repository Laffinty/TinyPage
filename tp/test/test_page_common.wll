LET(want_j05_special_chars, "<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"a\\\\b\\\"c\", \"description\": \"换行\\n制表\\t结束\", \"url\": \"https://e.com/article/x.html\", \"datePublished\": \"2026-01-02T10:00\", \"author\": {\"@type\": \"Person\", \"name\": \"o\\\\p\"}, \"publisher\": {\"@type\": \"Organization\", \"name\": \"https://e.com\"}, \"keywords\": \"t\\\"1\"}</script>");

TEST("json_ld/j01_with_tags", FUN(() ,
    (ASSERT_EQ(JSON_LD(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "title", "标题 & \"引号\""), "description", "描述"), "date", "2026-01-02T10:00"), "slug", "2026-01-01-x"), "tags", ["wlwl", "静态站点"]), "site_url", "https://example.com/"), "author", "")), want_j01_with_tags));
    TRUE));
TEST("json_ld/j02_no_tags_author", FUN(() ,
    (ASSERT_EQ(JSON_LD(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "title", "T"), "description", "D"), "date", "2026-01-02T10:00"), "slug", "s"), "tags", []), "site_url", "https://example.com"), "author", "张三")), want_j02_no_tags_author));
    TRUE));
// j03_empty_site_url：`site_url` 为空 ⇒ 整段不输出（对齐 generator.py:207 的 `if cfg.site_url:` 门控）
TEST("json_ld/j03_empty_site_url", FUN(() ,
    (ASSERT_EQ(JSON_LD(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "title", "T"), "description", "D"), "date", "2026-01-02T10:00"), "slug", "s"), "tags", ["a"]), "site_url", ""), "author", "")), want_j03_empty_site_url));
    TRUE));
// j04_trailing_slashes：`site_url` 结尾多个 `/` 都要被 rstrip 掉
TEST("json_ld/j04_trailing_slashes", FUN(() ,
    (ASSERT_EQ(JSON_LD(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "title", "T"), "description", "D"), "date", "2026-01-02T10:00"), "slug", "s"), "tags", []), "site_url", "https://example.com///"), "author", "")), want_j04_trailing_slashes));
    TRUE));
TEST("json_ld/j05_special_chars", FUN(() ,
    (ASSERT_EQ(JSON_LD(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "title", "a\\b\"c"), "description", "换行\n制表\t结束"), "date", "2026-01-02T10:00"), "slug", "x"), "tags", ["t\"1"]), "site_url", "https://e.com"), "author", "o\\p")), want_j05_special_chars));
    TRUE));

