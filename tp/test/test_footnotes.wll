// ── 反向守卫 ──────────────────────────────────────────
// G1 定义含换行 ⇒ 只取第一行，第二行保留在正文
LET(body_17, FUN(() ,
    (LET(p, PARSE_FOOTNOTES(src_guard_newline_def)); ASSERT_EQ(p[0], want_cleaned_guard_newline_def); ASSERT_EQ(LEN(p[1]), 1); ASSERT_EQ(AT_K(p[1][0], "key", "?"), "x"); ASSERT_EQ(AT_K(p[1][0], "text", "?"), "first line"));
    TRUE));
TEST("guard/def_newline_takes_first_line_only", body_17);

// G2 重复定义 ⇒ 值取第一个，但两个定义行都被删除
LET(body_18, FUN(() ,
    (LET(p, PARSE_FOOTNOTES(src_guard_dup_def)); ASSERT_EQ(p[0], want_cleaned_guard_dup_def); ASSERT_EQ(LEN(p[1]), 1); ASSERT_EQ(AT_K(p[1][0], "key", "?"), "d"); ASSERT_EQ(AT_K(p[1][0], "text", "?"), "first"));
    TRUE));
TEST("guard/dup_def_value_first_all_lines_removed", body_18);

// G3 行中间的定义（无行首锚定）也必须被识别
LET(body_19, FUN(() ,
    (LET(p, PARSE_FOOTNOTES(src_guard_midline_def)); ASSERT_EQ(p[0], want_cleaned_guard_midline_def); ASSERT_EQ(LEN(p[1]), 1); ASSERT_EQ(AT_K(p[1][0], "key", "?"), "z"); ASSERT_EQ(AT_K(p[1][0], "text", "?"), "value"));
    TRUE));
TEST("guard/midline_def_recognized", body_19);

// G4 空定义 [^e]: 不得被转成 <sup>（对齐 (?!:)）
LET(body_20, FUN(() ,
    (LET(pr, PROCESS_FOOTNOTES(src_guard_empty_def_eol)); ASSERT_EQ(pr[0], src_guard_empty_def_eol); ASSERT_EQ(pr[1], ""); ASSERT_EQ(RENDER_FOOTNOTE_REFS(src_guard_empty_def_eol), src_guard_empty_def_eol));
    TRUE));
TEST("guard/empty_def_not_superscript", body_20);

// G5 无脚注 ⇒ BUILD_FOOTNOTES_HTML 返回 ""
LET(body_21, FUN(() ,
    (ASSERT_EQ(BUILD_FOOTNOTES_HTML([]), ""); ASSERT_EQ(PROCESS_FOOTNOTES(src_no_footnotes)[1], ""));
    TRUE));
TEST("guard/no_footnotes_html_empty", body_21);

// G6 直接 render：[^a]: 跳过、[^b] 替换（无前瞻等价）
LET(body_22, FUN(() ,
    (ASSERT_EQ(RENDER_FOOTNOTE_REFS(src_direct_render_skip_defs), want_raw_direct_render_skip_defs); LET(pr, PROCESS_FOOTNOTES(src_direct_render_skip_defs)); ASSERT_EQ(pr[0], want_refs_direct_render_skip_defs));
    TRUE));
TEST("guard/direct_render_skips_def_colon", body_22);

// ── 跑测试 ──────────────────────────────────────────────
LET(records, RUN_TESTS());
PRINT("test_footnotes: ", LEN(records), " test(s) run");

LET MUT(failed, 0);
FOR(rec, records,
    (IF(AT_K(rec, "passed", FALSE),
        PRINT("  PASS ", AT_K(rec, "name", "?")),
        (SET(failed, +(failed, 1));
         PRINT("  FAIL ", AT_K(rec, "name", "?"))))));
PRINT("test_footnotes: failed=", failed);
IF(>(failed, 0), (PRINT_ERR("test_footnotes: FAILED"); PANIC("footnotes tests failed")), NULL);
PRINT("test_footnotes: OK");