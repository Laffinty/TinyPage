LET(body_13, FUN(() ,
    (LET(p, PARSE_FOOTNOTES(src_multi_ref_same_key)); ASSERT_EQ(p[0], want_cleaned_multi_ref_same_key); ASSERT_EQ(LEN(p[1]), 1); ASSERT_EQ(AT_K(p[1][0], "key", "?"), "k"); ASSERT_EQ(AT_K(p[1][0], "text", "?"), "重复引用"); ASSERT_EQ(RENDER_FOOTNOTE_REFS(src_multi_ref_same_key), want_raw_multi_ref_same_key); LET(pr, PROCESS_FOOTNOTES(src_multi_ref_same_key)); ASSERT_EQ(pr[0], want_refs_multi_ref_same_key); ASSERT_EQ(pr[1], want_html_multi_ref_same_key));
    TRUE));
TEST("fn/multi_ref_same_key", body_13);

