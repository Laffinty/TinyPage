    (LET(p, PARSE_FOOTNOTES(src_mixed_defs_and_refs)); ASSERT_EQ(p[0], want_cleaned_mixed_defs_and_refs); ASSERT_EQ(LEN(p[1]), 2); ASSERT_EQ(AT_K(p[1][0], "key", "?"), "a"); ASSERT_EQ(AT_K(p[1][0], "text", "?"), "一行定义"); ASSERT_EQ(AT_K(p[1][1], "key", "?"), "b"); ASSERT_EQ(AT_K(p[1][1], "text", "?"), "后一个"); ASSERT_EQ(RENDER_FOOTNOTE_REFS(src_mixed_defs_and_refs), want_raw_mixed_defs_and_refs); LET(pr, PROCESS_FOOTNOTES(src_mixed_defs_and_refs)); ASSERT_EQ(pr[0], want_refs_mixed_defs_and_refs); ASSERT_EQ(pr[1], want_html_mixed_defs_and_refs));
    TRUE));
TEST("fn/mixed_defs_and_refs", body_12);

