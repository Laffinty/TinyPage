// ── 反向守卫（卡 S3-1 明确要求的三条，单独钉一次）─────────────────
TEST("guard/git_config_must_404", FUN(() ,
    (ASSERT_EQ(AT_K(resp_hidden_git_config, "status", -1), 404));
    TRUE));
TEST("guard/traversal_must_404", FUN(() ,
    (ASSERT_EQ(AT_K(resp_traversal_plain, "status", -1), 404));
    TRUE));
TEST("guard/admin_password_must_404", FUN(() ,
    (ASSERT_EQ(AT_K(resp_sensitive_admin_password, "status", -1), 404));
    TRUE));

// ── 反向守卫：Cache-Control 只发**一个**（发两个就会多出一个键）────────
LET(resp_keys_200, KEYS(AT_K(resp_article, "headers", DICT())));
TEST("guard/single_cache_control", FUN(() ,
    (ASSERT_EQ(LEN(resp_keys_200), 8));
    TRUE));
TEST("guard/no_csp_on_public_site", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_article, "headers", DICT()), "Content-Security-Policy", "<absent>"), "<absent>"));
    TRUE));

// ── 单元：SECURITY_HEADERS（顺序 = nginx.conf:9-13 = security.py:331）──
LET(sh, SECURITY_HEADERS());
TEST("security/order", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(sh), "|"), "X-Content-Type-Options|X-Frame-Options|Referrer-Policy|Cross-Origin-Opener-Policy|Permissions-Policy"));
    TRUE));
TEST("security/X-Content-Type-Options", FUN(() ,
    (ASSERT_EQ(AT_K(sh, "X-Content-Type-Options", "<missing>"), "nosniff"));
    TRUE));
TEST("security/X-Frame-Options", FUN(() ,
    (ASSERT_EQ(AT_K(sh, "X-Frame-Options", "<missing>"), "DENY"));
    TRUE));
TEST("security/Referrer-Policy", FUN(() ,
    (ASSERT_EQ(AT_K(sh, "Referrer-Policy", "<missing>"), "no-referrer"));
    TRUE));
TEST("security/Cross-Origin-Opener-Policy", FUN(() ,
    (ASSERT_EQ(AT_K(sh, "Cross-Origin-Opener-Policy", "<missing>"), "same-origin"));
    TRUE));
TEST("security/Permissions-Policy", FUN(() ,
    (ASSERT_EQ(AT_K(sh, "Permissions-Policy", "<missing>"), "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"));
    TRUE));
// ⚠ Permissions-Policy 的项数：`nginx.conf:13` 与 `security.py:338` **都是 8 项**
//   （accelerometer / camera / geolocation / gyroscope / magnetometer /
//     microphone / payment / usb）—— 卡 S3-1 写「9 项」是数错，本实现以源码为准；
//   生成期已断言它与 `get_security_headers()` **逐字相等**。
//   这里再用逗号数钉一次，防「漏一项 / 多一项」的回归。
TEST("security/permissions_policy_items", FUN(() ,
    (ASSERT_EQ(LEN(SPLIT(AT_K(sh, "Permissions-Policy", ""), ",")), 8));
    TRUE));
// 反向守卫：公开站**不**发 CSP（security.py:342 是 admin 专用）
TEST("security/no_csp", FUN(() ,
    (ASSERT_EQ(AT_K(sh, "Content-Security-Policy", "<absent>"), "<absent>"));
    TRUE));

