// tp/test/test_static_serve.wll —— 静态服务内核的脱网测试（卡 S3-1）
//
// ⚠ 本文件由 tp/test/gen_test_static_serve.py 生成 —— 请勿手改。
//
// 被测：tp/lib/static_serve.wll 的 HANDLE / MIME_TYPE / SECURITY_HEADERS。
// 基准：tp/test/fixtures/static_serve_baseline.json
//   · 手写期望值 + 出处行号（nginx.conf / security.py / frontend.py）
//   · 生成期已对 tinypage 的真 Python 做交叉校验（见该 JSON 的 meta.cross_checks）
//
// 本文件是**脱网**的：产物树在 TEMP_DIR() 里现造，不碰 socket。
//
// ⚠ RUN_TESTS() 的失败**不影响退出码**（规范明载）⇒ 本文件自己把关。
IMPORT("wlwl:std.test", ["TEST", "ASSERT", "ASSERT_EQ", "RUN_TESTS", "TEMP_DIR"]);
IMPORT("wlwl:std.fs", ["MKDIRS", "WRITE_FILE", "PATH_JOIN", "PATH_CANONICAL"]);
IMPORT("wlwl:std.str", ["JOIN", "CAT"]);
IMPORT("./../lib/static_serve.wll", ["HANDLE", "MIME_TYPE", "SECURITY_HEADERS"]);

// ── 产物树（结构照 tinypage 的产物布局；内容见夹具 tree.files）──────
LET(root, PATH_CANONICAL(TEMP_DIR()));
PRINT("fixture root: ", root);
IF(IS_ERR(MKDIRS(PATH_JOIN(root, "article"))), PANIC("mkdirs failed: article"), NULL);
IF(IS_ERR(MKDIRS(PATH_JOIN(root, "list"))), PANIC("mkdirs failed: list"), NULL);
IF(IS_ERR(MKDIRS(PATH_JOIN(root, "static"))), PANIC("mkdirs failed: static"), NULL);
IF(IS_ERR(MKDIRS(PATH_JOIN(root, "nested"))), PANIC("mkdirs failed: nested"), NULL);
IF(IS_ERR(MKDIRS(PATH_JOIN(root, ".git"))), PANIC("mkdirs failed: .git"), NULL);
IF(IS_ERR(MKDIRS(PATH_JOIN(root, "emptydir"))), PANIC("mkdirs failed: emptydir"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "index.html"), "<!doctype html>\n<html lang=\"zh\">\n<head><title>home</title></head>\n<body><h1>首页</h1></body>\n</html>\n")), PANIC("write failed: index.html"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "article/x.html"), "<!doctype html>\n<html><body><article>x</article></body></html>\n")), PANIC("write failed: article/x.html"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "article/中文.html"), "<!doctype html>\n<html><body><article>中文</article></body></html>\n")), PANIC("write failed: article/中文.html"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "list/index.html"), "<!doctype html>\n<html><body><ul><li>2</li></ul></body></html>\n")), PANIC("write failed: list/index.html"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "list/2.html"), "<!doctype html>\n<html><body><article>2</article></body></html>\n")), PANIC("write failed: list/2.html"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "style.css"), "body{margin:0}\n")), PANIC("write failed: style.css"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "font.woff2"), "wOF2 fake font bytes for tests\n")), PANIC("write failed: font.woff2"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "app.woff"), "wOFF fake font bytes for tests\n")), PANIC("write failed: app.woff"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "static/app.js"), "console.log(\"hi\");\n")), PANIC("write failed: static/app.js"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "plain.txt"), "hello 中文\n")), PANIC("write failed: plain.txt"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, ".git/config"), "[core]\n\trepositoryformatversion = 0\n")), PANIC("write failed: .git/config"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "admin_password.txt"), "hunter2\n")), PANIC("write failed: admin_password.txt"), NULL);
IF(IS_ERR(WRITE_FILE(PATH_JOIN(root, "nested/.env"), "SECRET=1\n")), PANIC("write failed: nested/.env"), NULL);

// ── 预计算每个用例的响应（⚠ LET 不能放进 TEST 的 FUN 体）────────────
// root_index —— 请求 / ⇒ 回落根目录 index.html
//   出处：nginx.conf:4-6,18-20; frontend.py:49-50
LET(resp_root_index, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/"), "query", "")));
// index_explicit —— 显式 /index.html 与 / 等价
//   出处：nginx.conf:18-20
LET(resp_index_explicit, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/index.html"), "query", "")));
// article —— 普通子目录文件；.html ⇒ 短缓存（长缓存未命中）
//   出处：nginx.conf:43（未命中）; frontend.py:78
LET(resp_article, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/article/x.html"), "query", "")));
// list_dir_slash —— 目录（带尾斜杠）⇒ 回落 index.html
//   出处：nginx.conf:18-20
LET(resp_list_dir_slash, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/list/"), "query", "")));
// list_dir_noslash —— 目录（无尾斜杠）⇒ 也给 index.html（nginx 会先 301 到 /list/，本实现不重定向）
//   出处：nginx.conf:18-20（登记为偏差 D-3）
LET(resp_list_dir_noslash, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/list"), "query", "")));
// percent_cjk —— percent-decode：中文文件名（浏览器把 CJK 编码成 %XX）
//   出处：nginx 先解码再匹配 location；URL_DECODE（std.encode）
LET(resp_percent_cjk, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/article/%E4%B8%AD%E6%96%87.html"), "query", "")));
// css_long_cache —— nginx.conf:43 命中 ⇒ public, max-age=31536000, immutable
//   出处：nginx.conf:43-47
LET(resp_css_long_cache, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/style.css"), "query", "")));
// woff2_long_cache —— 字体命中长缓存；MIME 取 nginx 值（见 divergences D-2）
//   出处：nginx.conf:43; 见 meta.divergences
LET(resp_woff2_long_cache, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/font.woff2"), "query", "")));
// woff_long_cache —— .woff 也在 nginx.conf:43 的列表里
//   出处：nginx.conf:43
LET(resp_woff_long_cache, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/app.woff"), "query", "")));
// js_long_cache —— .js 命中长缓存（子目录同样命中）
//   出处：nginx.conf:43
LET(resp_js_long_cache, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/static/app.js"), "query", "")));
// multibyte_length —— 含 CJK ⇒ Content-Length 必须是 **UTF-8 字节数**（不是码点数）
//   出处：frontend.py:77（len(bytes)）; BYTE_LEN
LET(resp_multibyte_length, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/plain.txt"), "query", "")));
// head_article —— HEAD：body 空，但头齐全且 Content-Length 是**真实长度**
//   出处：HTTP 语义；frontend.py:75-79 的头集（Python 的 WSGI 不区分 HEAD）
LET(resp_head_article, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "HEAD"), "path", "/article/x.html"), "query", "")));
// query_opt_ignored —— query 不参与解析（对齐 WSGI 的 PATH_INFO / QUERY_STRING 分离）
//   出处：frontend.py:43（只用 PATH_INFO）
LET(resp_query_opt_ignored, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/article/x.html"), "query", "utm=1&a=2")));
// path_with_query_string —— path 自带查询串也能切掉（入口兜底）
//   出处：frontend.py:43
LET(resp_path_with_query_string, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/article/x.html?utm=1&a=2"), "query", "")));
// not_found —— 不存在 ⇒ 404（不得 500）
//   出处：nginx.conf:19 =404; frontend.py:69-70
LET(resp_not_found, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/nope.html"), "query", "")));
// not_found_dir —— 不存在的目录 ⇒ 404
//   出处：nginx.conf:19 =404
LET(resp_not_found_dir, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/nope/"), "query", "")));
// empty_dir_no_index —— 目录存在但没有 index.html ⇒ 404
//   出处：nginx.conf:18-20（try_files … =404）
LET(resp_empty_dir_no_index, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/emptydir/"), "query", "")));
// hidden_git_config —— 【反向守卫】隐藏路径 ⇒ 404
//   出处：nginx.conf:50-53
LET(resp_hidden_git_config, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/.git/config"), "query", "")));
// hidden_dir_slash —— 【反向守卫】隐藏目录 ⇒ 404
//   出处：nginx.conf:50-53
LET(resp_hidden_dir_slash, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/.git/"), "query", "")));
// traversal_plain —— 【反向守卫】字面 .. ⇒ 404（PATH_CONTAINS + 显式拒绝）
//   出处：卡 S3-1 反向守卫; security.py:269-287 的包含性判定
LET(resp_traversal_plain, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/../secret.txt"), "query", "")));
// traversal_nested —— 【反向守卫】夹在中间 .. ⇒ 404
//   出处：卡 S3-1 反向守卫
LET(resp_traversal_nested, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/article/../../secret.txt"), "query", "")));
// traversal_encoded —— 【反向守卫】percent-encoded .. ⇒ 解码后仍是 .. ⇒ 404
//   出处：nginx 先解码再匹配；卡 S3-1 反向守卫
LET(resp_traversal_encoded, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/%2e%2e/secret.txt"), "query", "")));
// sensitive_admin_password —— 【反向守卫】admin_password.txt ⇒ 404
//   出处：nginx.conf:54-57
LET(resp_sensitive_admin_password, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/admin_password.txt"), "query", "")));
// sensitive_env_file —— .env 文件 ⇒ 404（隐藏规则也会命中，两条都对）
//   出处：nginx.conf:50-57
LET(resp_sensitive_env_file, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/nested/.env"), "query", "")));
// sensitive_env_substring —— 敏感名是**子串**匹配 ⇒ /foo.env 即使不存在也 404（不是「文件不存在」那一路）
//   出处：nginx.conf:54-57（`~*` 子串）
LET(resp_sensitive_env_substring, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/foo.env"), "query", "")));
// sensitive_git_substring —— `.git` 子串匹配 ⇒ /my.git-repo/… 也 404
//   出处：nginx.conf:54-57（`~*` 子串）
LET(resp_sensitive_git_substring, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/my.git-repo/x.html"), "query", "")));
// sensitive_case_insensitive —— 敏感名大小写不敏感（nginx 用 `~*`）
//   出处：nginx.conf:54（`~*`）
LET(resp_sensitive_case_insensitive, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/Admin_Password.TXT"), "query", "")));
// bad_percent_escape —— 非法 percent 转义 ⇒ fail closed 404
//   出处：URL_DECODE 返 ERR（std.encode）
LET(resp_bad_percent_escape, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "GET"), "path", "/bad%zz"), "query", "")));
// post_root —— POST ⇒ 405（Python 的 StaticApp 没有这道门，见 D-4）
//   出处：卡 S3-1
LET(resp_post_root, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "POST"), "path", "/"), "query", "")));
// put_index —— PUT ⇒ 405
//   出处：卡 S3-1
LET(resp_put_index, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "PUT"), "path", "/index.html"), "query", "")));
// delete_article —— DELETE ⇒ 405
//   出处：卡 S3-1
LET(resp_delete_article, HANDLE(INDEX_SET(INDEX_SET(INDEX_SET(INDEX_SET(DICT(), "root", root), "method", "DELETE"), "path", "/article/x.html"), "query", "")));

// ── 用例断言：status / 头序 / 每个头的值 / body ──────────────────

// root_index
TEST("handle/root_index/status", FUN(() ,
    (ASSERT_EQ(AT_K(resp_root_index, "status", -1), 200));
    TRUE));
TEST("handle/root_index/header_order", FUN(() ,
    (ASSERT_EQ(JOIN(KEYS(AT_K(resp_root_index, "headers", DICT())), "|"), "Content-Type|Content-Length|Cache-Control|X-Content-Type-Options|X-Frame-Options|Referrer-Policy|Cross-Origin-Opener-Policy|Permissions-Policy"));
    TRUE));
TEST("handle/root_index/header/Content-Type", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_root_index, "headers", DICT()), "Content-Type", "<missing>"), "text/html; charset=utf-8"));
    TRUE));
TEST("handle/root_index/header/Content-Length", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_root_index, "headers", DICT()), "Content-Length", "<missing>"), "103"));
    TRUE));
TEST("handle/root_index/header/Cache-Control", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_root_index, "headers", DICT()), "Cache-Control", "<missing>"), "max-age=300, must-revalidate"));
    TRUE));
TEST("handle/root_index/header/X-Content-Type-Options", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_root_index, "headers", DICT()), "X-Content-Type-Options", "<missing>"), "nosniff"));
    TRUE));
TEST("handle/root_index/header/X-Frame-Options", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_root_index, "headers", DICT()), "X-Frame-Options", "<missing>"), "DENY"));
    TRUE));
TEST("handle/root_index/header/Referrer-Policy", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_root_index, "headers", DICT()), "Referrer-Policy", "<missing>"), "no-referrer"));
    TRUE));
TEST("handle/root_index/header/Cross-Origin-Opener-Policy", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_root_index, "headers", DICT()), "Cross-Origin-Opener-Policy", "<missing>"), "same-origin"));
    TRUE));
TEST("handle/root_index/header/Permissions-Policy", FUN(() ,
    (ASSERT_EQ(AT_K(AT_K(resp_root_index, "headers", DICT()), "Permissions-Policy", "<missing>"), "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"));
    TRUE));
TEST("handle/root_index/body", FUN(() ,
    (ASSERT_EQ(AT_K(resp_root_index, "body", "<missing>"), "<!doctype html>\n<html lang=\"zh\">\n<head><title>home</title></head>\n<body><h1>首页</h1></body>\n</html>\n"));
    TRUE));

