#!/bin/sh
# TinyPage pre-push hook —— 推之前跑一遍完整的本地 CI。
#
# S6-2（2026-11-02）：本文件原来是 **Python** 脚本，而且最后一步是
#   cmd = [sys.executable, "-m", "tinypage", "build"]
# Python 实现已删除，那个模块不存在了。现在改为运行
# tp/test/ci_local_check.ps1（与 GitHub Actions 的 wlwl workflow 同语义）：
#   生成器无漂移 → 静态检查 → wlwl check → 反向守卫 → 27 个测试文件。
set -e

echo "[PRE-PUSH] 运行本地 CI（约 1-3 分钟）..."
powershell -ExecutionPolicy Bypass -File tp/test/ci_local_check.ps1
