#!/bin/sh
# TinyPage pre-commit hook —— 只做「快」的那几条静态检查。
#
# S6-2（2026-11-02）：本文件原来是 **Python** 脚本（`#!/usr/bin/env python3`），
# 随 Python 组件一起清退，改写为 sh。Git for Windows 用 sh 执行钩子，
# 因此这里只做壳，真正的检查交给 tp/test 下的脚本。
#
# 只检查**本次暂存**的 .wll：全量检查在 pre-push 与 CI 里做。
set -e

files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.wll$' || true)
if [ -z "$files" ]; then
    exit 0
fi

echo "[PRE-COMMIT] 静态检查 $(echo "$files" | wc -l) 个 .wll"

# 括号 / 分号这两条最有价值（WLWL 的括号诊断不告诉你缺几层）
python tp/test/paren_check.py $files
python tp/test/check_semis.py $files

exit 0
